      "writtenOn": "2025-01-13T16:02:10Z",
      "side": 1,
      "message": "This ends up using the element\u0027s local-to-device transform, plus the post translate to place it into the plot\u0027s bitmap. `renderPos` seems to account for the plot location and the locator\u0027s offset within the atlas texture, but with us removing the integer translation from the keys, don\u0027t we also need to account for removing that offset when we render to the plot?",
      "range": {
        "startLine": 255,
        "startChar": 0,
        "endLine": 255,
        "endChar": 79
      },
      "revId": "175c40b15c918102262b882eba03602e3fdf55ce",
