      "writtenOn": "2022-05-06T16:27:47Z",
      "side": 1,
      "message": "Just curious, is this Bazel terminology?  It seems to me that \"target\" is the more obvious name for this.",
      "range": {
        "startLine": 31,
        "startChar": 26,
        "endLine": 31,
        "endChar": 31
      },
      "revId": "d18abd667aa15770dff8d36ea4c9d75ef624fa75",
