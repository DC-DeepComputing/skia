    },
    {
      "unresolved": true,
      "key": {
        "uuid": "d9807a39_d8bf1ff7",
        "filename": "src/gpu/graphite/mtl/MtlCaps.mm",
        "patchSetId": 14
      },
      "lineNbr": 667,
      "author": {
        "id": 8341
      },
      "writtenOn": "2025-04-14T19:26:58Z",
      "side": 1,
      "message": "Yes, that was so things kept working in `isSampleCountSupported` without needing to change logic for if the texture format was depth/stencil.\n\nMy interpretation of Renderbale was that it meant it could be an attachment of a renderpass, but that is a lower-level question than can this format be used to render Skia content.",
      "parentUuid": "1f3c4899_8624da27",
      "range": {
        "startLine": 667,
        "startChar": 48,
        "endLine": 667,
        "endChar": 76
      },
      "revId": "252b727a21bc3642aaec6137fe50d73f508ffd6f",
