      "writtenOn": "2026-08-05T21:54:51Z",
      "side": 1,
      "message": "Is fTaskGroup not inherently thread safe? It feels like it should be to me.",
      "range": {
        "startLine": 152,
        "startChar": 0,
        "endLine": 152,
        "endChar": 39
      },
      "revId": "44606ea8fd183f97c4d30feded432572fb0ddf7a",
