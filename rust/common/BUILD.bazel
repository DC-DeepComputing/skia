load(
    "//bazel:skia_rules.bzl",
    "skia_cc_library",
)

package(
    default_applicable_licenses = ["//:license"],
)

licenses(["notice"])

# Shared FFI utilities for Rust integrations.
# This header-only library provides ToSkSpan() for converting rust::Slice to SkSpan.
skia_cc_library(
    name = "span_utils",
    hdrs = ["SpanUtils.h"],
    features = ["layering_check"],
    visibility = [
        "//rust/png:__pkg__",
        "//src/codec:__pkg__",
        "//src/encode:__pkg__",
    ],
    deps = ["//:core"],
)

# Shared StreamAdapter - C++ headers for Read + Seek for Rust codecs
skia_cc_library(
    name = "stream_adapter",
    hdrs = [
        "SkStreamAdapter.h",
    ],
    features = ["layering_check"],
    visibility = [
        "//rust/bmp:__pkg__",
        "//rust/png:__pkg__",
        "//src/codec:__pkg__",
        "//src/encode:__pkg__",
    ],
    deps = ["//:core"],
)

# Export shared Rust files for codec implementations to include
exports_files(
    [
        "io_traits_ffi.rs",
        "SkStreamAdapter.cpp",
    ],
    visibility = [
        "//rust/png:__pkg__",
        "//experimental/rust_bmp:__pkg__",
    ],
)
