load("@rules_rust//rust:defs.bzl", "rust_static_library")
load("//bazel:flags.bzl", "bool_flag", "selects")
load("//bazel:rust_cxx_bridge.bzl", "rust_cxx_bridge")
load(
    "//bazel:skia_rules.bzl",
    "RUST_COMPATIBILITY",
    "skia_cc_library",
    "skia_filegroup",
)

package(
    default_applicable_licenses = ["//:license"],
)

licenses(["notice"])

# Umbrella flag enabling all Android-specific Rust PNG behaviors below.
# Note: Google3's autoroller rewrites `default = True` to `default = False` here.
bool_flag(
    name = "for_android",
    default = True,
)

# Capture extra chunks (`gmAP`, `gdAT`, `cLLI`, `mDCV`, `npTc`, `npLb`, `npOl`)
# in `FFI.rs` via `png::DecodeOptions::set_captured_chunks`.
bool_flag(
    name = "captured_chunks",
    default = False,
)

selects.config_setting_group(
    name = "captured_chunks_enabled",
    match_any = [
        ":for_android_true",
        ":captured_chunks_true",
    ],
    visibility = ["//:__subpackages__"],
)

# Wrap the decoder input stream in `LimitBufReader` so reads do not overshoot
# chunk boundaries (and `IEND`), and drain through `IEND` via `Reader::finish`
# after the final frame.
bool_flag(
    name = "limit_read",
    default = False,
)

selects.config_setting_group(
    name = "limit_read_enabled",
    match_any = [
        ":for_android_true",
        ":limit_read_true",
    ],
    visibility = ["//:__subpackages__"],
)

# Ignore APNG `acTL`/`fcTL` chunks so animated PNGs decode as static single-frame
# images (matching `libpng`).
bool_flag(
    name = "disable_apng",
    default = False,
)

selects.config_setting_group(
    name = "disable_apng_enabled",
    match_any = [
        ":for_android_true",
        ":disable_apng_true",
    ],
    visibility = ["//:__subpackages__"],
)

# Emit `sBIT` chunks when encoding PNGs with `SkPngRustEncoder`.
bool_flag(
    name = "encode_sbit",
    default = False,
)

selects.config_setting_group(
    name = "encode_sbit_enabled",
    match_any = [
        ":for_android_true",
        ":encode_sbit_true",
    ],
    visibility = ["//:__subpackages__"],
)

# Emit `gmAP`/`gdAT` gainmap chunks when encoding PNGs with `SkPngRustEncoder`.
bool_flag(
    name = "encode_gainmap",
    default = False,
)

selects.config_setting_group(
    name = "encode_gainmap_enabled",
    match_any = [
        ":for_android_true",
        ":encode_gainmap_true",
    ],
    visibility = ["//:__subpackages__"],
)

# Set for fuzzing builds (e.g. `skia_build_fuzzers=true` in GN), so that `FFI.rs`
# skips checks such as chunk CRCs that would otherwise reject most mutated inputs.
bool_flag(
    name = "fuzzing_build_mode",
    default = False,
)

skia_filegroup(
    name = "rs_srcs",
    srcs = ["FFI.rs"],
)

skia_filegroup(
    name = "cxx_bridge_srcs",
    srcs = ["FFI.rs"],
)

skia_cc_library(
    name = "ffi_cpp",
    hdrs = ["FFI.h"],
    compatible_with = RUST_COMPATIBILITY,
    features = ["layering_check"],
    visibility = [
        "//src/codec:__pkg__",
        "//src/encode:__pkg__",
    ],
    deps = [
        "//rust/common:ffi_utils",
    ],
)

rust_cxx_bridge(
    name = "cxx_bridge",
    src = "FFI.rs",
    visibility = [
        "//src/codec:__pkg__",
        "//src/encode:__pkg__",
    ],
    deps = [
        ":ffi_cpp",
        "//rust/common:ffi_utils",
    ],
)

rust_static_library(
    name = "ffi_rs",
    srcs = [":rs_srcs"],
    crate_features = select({
        ":captured_chunks_enabled": ["captured_chunks"],
        "//conditions:default": [],
    }) + select({
        ":limit_read_enabled": ["limit_read"],
        "//conditions:default": [],
    }) + select({
        ":disable_apng_enabled": ["disable_apng"],
        "//conditions:default": [],
    }),
    crate_root = "FFI.rs",
    rustc_flags = ["-Dwarnings"] + select({
        ":fuzzing_build_mode_true": ["--cfg=FUZZING_BUILD_MODE_UNSAFE_FOR_PRODUCTION"],
        "//conditions:default": [],
    }),
    visibility = [
        "//src/codec:__pkg__",
        "//src/encode:__pkg__",
    ],
    deps = [
        ":cxx_bridge",
        "//rust/common:cxx_bridge",
        "//rust/common:skia_rust_common",
        "@crates//:cxx",
        "@crates//:png",
    ],
)
