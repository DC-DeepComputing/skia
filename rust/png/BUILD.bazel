load("@rules_rust//rust:defs.bzl", "rust_static_library")
load("//bazel:rust_cxx_bridge.bzl", "rust_cxx_bridge")
load(
    "//bazel:skia_rules.bzl",
    "skia_cc_library",
    "skia_filegroup",
)

package(
    default_applicable_licenses = ["//:license"],
)

licenses(["notice"])

skia_filegroup(
    name = "rs_srcs",
    srcs = [
        "FFI.rs",
        "//rust/common:io_traits_ffi.rs",
    ],
)

skia_filegroup(
    name = "cxx_bridge_srcs",
    srcs = ["FFI.rs"],
)

skia_cc_library(
    name = "ffi_cpp",
    hdrs = ["FFI.h"],
    srcs = ["//rust/common:SkStreamAdapter.cpp"],
    visibility = [
        "//src/codec:__pkg__",
        "//src/encode:__pkg__",
    ],
    deps = [
        ":cxx_bridge/include",
        "//rust/common:stream_adapter",
        "//rust/common:span_utils",
        "//:core",
    ],
)

rust_cxx_bridge(
    name = "cxx_bridge",
    src = "FFI.rs",
    visibility = [
        "//src/codec:__pkg__",
        "//src/encode:__pkg__",
    ],
    deps = [
        ":ffi_cpp",
        "//rust/common:stream_adapter",
    ],
)

rust_static_library(
    name = "ffi_rs",
    crate_root = "FFI.rs",
    srcs = [":rs_srcs"],
    rustc_flags = ["-Dwarnings"],
    visibility = [
        "//src/codec:__pkg__",
        "//src/encode:__pkg__",
    ],
    deps = [
        ":cxx_bridge",
        ":ffi_cpp",
        "@crates//:cxx",
        "@crates//:png",
    ],
)
