load("@rules_rust//rust:defs.bzl", "rust_static_library")
load("//bazel:rust_cxx_bridge.bzl", "rust_cxx_bridge")
load(
    "//bazel:skia_rules.bzl",
    "skia_cc_library",
    "skia_filegroup",
)

package(
    default_applicable_licenses = ["//:license"],
)

licenses(["notice"])

skia_filegroup(
    name = "rs_srcs",
    srcs = ["FFI.rs"],
)

skia_filegroup(
    name = "cxx_bridge_srcs",
    srcs = ["FFI.rs"],
)

skia_cc_library(
    name = "ffi_cpp",
    hdrs = [
        "FFI.h",
        # TODO(crbug.com/452666425): Remove these after Chromium's //skia/BUILD.gn
        # is updated to include skia_codec_rust_common_ffi. For now, we export
        # these headers from both PNG and common to maintain backward compatibility.
        "//rust/common:SkStreamAdapter.h",
        "//rust/common:SpanUtils.h",
    ],
    srcs = [
        # TODO(crbug.com/452666425): Remove after Chromium update (see above).
        "//rust/common:SkStreamAdapter.cpp",
    ],
    visibility = [
        "//src/codec:__pkg__",
        "//src/encode:__pkg__",
    ],
    deps = [
        ":cxx_bridge/include",
        "//rust/common:ffi_utils",
        "//:core",
    ],
)

rust_cxx_bridge(
    name = "cxx_bridge",
    src = "FFI.rs",
    visibility = [
        "//src/codec:__pkg__",
        "//src/encode:__pkg__",
    ],
    deps = [
        ":ffi_cpp",
        "//rust/common:ffi_utils",
    ],
)

rust_static_library(
    name = "ffi_rs",
    crate_root = "FFI.rs",
    srcs = [":rs_srcs"],
    rustc_flags = ["-Dwarnings"],
    visibility = [
        "//src/codec:__pkg__",
        "//src/encode:__pkg__",
    ],
    deps = [
        ":cxx_bridge",
        ":ffi_cpp",
        "//rust/common:ffi",
        "@crates//:cxx",
        "@crates//:png",
    ],
)
