      },
      "writtenOn": "2022-08-17T19:41:43Z",
      "side": 1,
      "message": "Let\u0027s add a comment here to clarify that `peekUniformData()` should only be called when all the uniforms are done, and is not const so that it can pad as needed to the final required alignment.\n\nWere we to be calling this willy-nilly, we\u0027d add incorrect padding in the middle.",
      "range": {
        "startLine": 156,
        "startChar": 23,
        "endLine": 156,
        "endChar": 38
      },
      "revId": "7cc2f8148d500cf8d31a2d517adb91f7e8046f4f",
      "serverId": "5086850b-e599-37d2-8ec8-ff16aeccbf02"
