                "endLine": 246,
                "endChar": 0
              },
              "replacement": "    // Recorder is optional and will be used if drawing operations are required. If drawing\n    // operations are needed but no Recorder is provided, a new Recorder will be created\n    // automatically.\n"
            }
          ]
        }
      ],
      "revId": "e618e222d3f0386b848c2fbf47db4349f87177ec",
      "serverId": "5086850b-e599-37d2-8ec8-ff16aeccbf02"
    },
    {
      "unresolved": true,
      "key": {
        "uuid": "ad8b36a7_17d30f3d",
        "filename": "include/gpu/graphite/Context.h",
