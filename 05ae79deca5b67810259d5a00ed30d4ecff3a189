      "writtenOn": "2023-06-12T17:59:19Z",
      "side": 1,
      "message": "Added a comment. It\u0027s because of the pesky \u0027\\0\u0027 character which std::string will interpret as the end of the string if you\u0027re not careful.",
      "parentUuid": "b47efc1c_cf07e294",
      "range": {
        "startLine": 76,
        "startChar": 4,
        "endLine": 76,
        "endChar": 48
      },
      "revId": "05ae79deca5b67810259d5a00ed30d4ecff3a189",
