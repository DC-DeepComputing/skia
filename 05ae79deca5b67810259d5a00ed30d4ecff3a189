        "id": 11059
      },
      "writtenOn": "2023-06-12T18:01:23Z",
      "side": 1,
      "message": "I think that comment is untrue. `std::string` has no notion of a zero-terminator at all. You can easily use `std::string` with arbitrary binary data and it will work.",
      "parentUuid": "13d40179_9a958974",
      "range": {
        "startLine": 76,
        "startChar": 4,
        "endLine": 76,
        "endChar": 48
      },
      "revId": "05ae79deca5b67810259d5a00ed30d4ecff3a189",
