      },
      "lineNbr": 51,
      "author": {
        "id": 8341
      },
      "writtenOn": "2022-11-01T14:31:03Z",
      "side": 1,
      "message": "I disagree in this case, I think it\u0027s a useful reminder that we have the ability to change the layout for metal if we need to. W/o such a comment I fear we\u0027d start passively assuming kMetal was hard-speced by Apple.",
      "parentUuid": "361b0780_0f9ccd66",
      "range": {
        "startLine": 51,
        "startChar": 16,
        "endLine": 51,
        "endChar": 68
      },
      "revId": "6f484989f359985bd5381656c9a3c5a589442aab",
