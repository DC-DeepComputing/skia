      "writtenOn": "2025-09-02T14:42:35Z",
      "side": 1,
      "message": "This validation would also need to subtract the `fStartingOffset`.",
      "range": {
        "startLine": 253,
        "startChar": 0,
        "endLine": 255,
        "endChar": 0
      },
      "revId": "ee199f118527c8d9a27ab5d9fc3ec99e5a44328d",
