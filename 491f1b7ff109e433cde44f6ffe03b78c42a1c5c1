      "writtenOn": "2022-04-12T17:48:24Z",
      "side": 1,
      "message": "I suggest adding some comments here to explain why an 8-element Word array is special and why this typedef is useful. Perhaps consider using a more descriptive alias than just \"Words\", since `const SkTArray\u003cWord\u003e\u0026 words` also appears elsewhere.",
      "range": {
        "startLine": 467,
        "startChar": 4,
        "endLine": 467,
        "endChar": 37
      },
      "revId": "491f1b7ff109e433cde44f6ffe03b78c42a1c5c1",
