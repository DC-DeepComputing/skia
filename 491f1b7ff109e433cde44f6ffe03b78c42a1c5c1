      "writtenOn": "2022-04-12T17:48:24Z",
      "side": 1,
      "message": "Is -1 here a placeholder for a Word kind that doesn\u0027t have a value? Words can be signed (if they are a number for example).\n\nIf I\u0027m understanding the usage here correctly, then perhaps consider std::optional here to add some type safety around `fValue` not having a value.",
      "range": {
        "startLine": 132,
        "startChar": 20,
        "endLine": 132,
        "endChar": 23
