      "writtenOn": "2022-06-28T18:03:11Z",
      "side": 1,
      "message": "I\u0027m not sure if you are suggesting a change here or not. We need local coords for runtime effects (that\u0027s a given). We can change this later if we have something better, but at this time, this seems to be how all effects operate that use local coords.",
      "parentUuid": "7af202ad_f94530b0",
      "range": {
        "startLine": 745,
        "startChar": 9,
        "endLine": 748,
        "endChar": 9
      },
