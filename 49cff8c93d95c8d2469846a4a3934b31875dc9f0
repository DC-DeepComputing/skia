      "lineNbr": 176,
      "author": {
        "id": 5210
      },
      "writtenOn": "2022-10-26T02:52:53Z",
      "side": 1,
      "message": "I switch to doing the growth calculation in count instead of bytes. This will always give the a whole multiple of sizeOfT bytes. I also add the round up to the next value of 8 logic from SkTArray to handle small values.",
      "parentUuid": "298f9a2d_a9c27add",
      "range": {
        "startLine": 176,
        "startChar": 45,
        "endLine": 176,
        "endChar": 83
      },
