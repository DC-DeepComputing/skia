      },
      "writtenOn": "2022-01-11T18:21:16Z",
      "side": 1,
      "message": "Right - if this persists beyond helping bring up the key system we need a fallback that can just dump the bytes.",
      "parentUuid": "517ed244_b54f2be6",
      "range": {
        "startLine": 21,
        "startChar": 0,
        "endLine": 21,
        "endChar": 47
      },
      "revId": "341762d2a23c7c6dec5e82af0565f838e1c7f171",
