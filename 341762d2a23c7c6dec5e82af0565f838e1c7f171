      "writtenOn": "2022-01-11T18:21:16Z",
      "side": 1,
      "message": "Done - I\u0027ve gone with kSolidColorShader",
      "parentUuid": "52c38d07_22967a8f",
      "range": {
        "startLine": 22,
        "startChar": 4,
        "endLine": 22,
        "endChar": 69
      },
      "revId": "341762d2a23c7c6dec5e82af0565f838e1c7f171",
