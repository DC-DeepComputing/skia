      "side": 1,
      "message": "Is this for efficiency or just readability?",
      "range": {
        "startLine": 16,
        "startChar": 2,
        "endLine": 16,
        "endChar": 51
      },
      "revId": "ad6a5129c5b786a336418844a511e7702f9c9c2e",
