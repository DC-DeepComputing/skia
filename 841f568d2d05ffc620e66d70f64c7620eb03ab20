      "writtenOn": "2023-07-13T17:25:29Z",
      "side": 1,
      "message": "No, it\u0027s fine for testing locally I suppose, but don\u0027t check this in. This needs a gn or bazel build (preferably both).",
      "parentUuid": "b1c7d7cf_cc543403",
      "revId": "841f568d2d05ffc620e66d70f64c7620eb03ab20",
