    },
    {
      "unresolved": true,
      "key": {
        "uuid": "145cb842_8007886d",
        "filename": "experimental/rust_jpeg/decoder/impl/SkJpegRustCodec.cpp",
        "patchSetId": 17
      },
      "lineNbr": 327,
