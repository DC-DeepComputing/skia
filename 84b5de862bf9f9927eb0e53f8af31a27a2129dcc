      },
      "writtenOn": "2022-10-31T18:01:02Z",
      "side": 1,
      "message": "I\u0027ve added a comment to reconsider the data structure once we have more information about Chrome\u0027s usage pattern. I suspect you may be right and a uniquified std::vector may suffice.",
      "parentUuid": "40dd81d9_f80e4f0d",
      "range": {
        "startLine": 39,
        "startChar": 19,
        "endLine": 39,
        "endChar": 31
      },
      "revId": "84b5de862bf9f9927eb0e53f8af31a27a2129dcc",
