      "writtenOn": "2022-08-26T15:04:47Z",
      "side": 1,
      "message": "I don\u0027t follow what\u0027s going on in gif2webp. How does that allow using offsets?",
      "parentUuid": "6addd38d_4e649205",
      "revId": "95685757480792f84174f22717e3f8c1ca54c198",
      "serverId": "5086850b-e599-37d2-8ec8-ff16aeccbf02"
