    {
      "unresolved": true,
      "key": {
        "uuid": "a0d2adc7_a04d8168",
        "filename": "gm/fontations_ft_compare.cpp",
        "patchSetId": 9
      },
      "lineNbr": 28,
      "author": {
        "id": 6155
      },
      "writtenOn": "2023-09-27T14:39:15Z",
      "side": 1,
      "message": "The intention of the test is to regression test the antialiasing differences. At larger font sizes, they are less visible or striking - so I prefer to keep the font size at a level where antialiasing is needed. At the same time, we believe the current level of antialiasing differences between FT and Fontations+Skia is acceptable. We will have that evaluated by type specialists in Google Fonts. So the tests ensure we notice if there is a change in antialiasing behavior. They\u0027re not unimportant - if they become too large or too noticeable, they would become blocking.",
      "parentUuid": "ca768f68_fbe8543c",
      "range": {
        "startLine": 28,
        "startChar": 16,
        "endLine": 28,
        "endChar": 25
