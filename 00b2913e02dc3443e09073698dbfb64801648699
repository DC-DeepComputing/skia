      "writtenOn": "2024-06-17T19:47:12Z",
      "side": 1,
      "message": "Why plural `Allocators` as opposed to singular?",
      "range": {
        "startLine": 274,
        "startChar": 10,
        "endLine": 274,
        "endChar": 33
      },
      "revId": "00b2913e02dc3443e09073698dbfb64801648699",
