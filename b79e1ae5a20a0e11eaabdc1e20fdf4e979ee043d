      "lineNbr": 17,
      "author": {
        "id": 5020
      },
      "writtenOn": "2022-08-01T15:26:50Z",
      "side": 1,
      "message": "I think you are right.  We do need to have a `kNever` value, but it doesn\u0027t need to be negative as long as we can ensure it is bigger than any actual apilevel.",
      "parentUuid": "44360376_be9cea8e",
      "range": {
        "startLine": 17,
        "startChar": 26,
        "endLine": 17,
        "endChar": 32
      },
