    },
    {
      "unresolved": false,
      "key": {
        "uuid": "4cba9ca4_96412d08",
        "filename": "src/gpu/graphite/BufferManager.cpp",
        "patchSetId": 4
      },
      "lineNbr": 548,
      "author": {
        "id": 8341
      },
      "writtenOn": "2024-05-21T15:06:07Z",
      "side": 1,
      "message": "These buffers are created once and explicitly shared by just having all the users hold on to the same Buffer object. These buffers are immutable after they are created on Context initialization so there\u0027s never a need to go back to the ResourceCache/Provider for them. A Shareable resource means that multiple users can simultaneously check it out and modify it without worrying about stomping over each other\u0027s data/effects because the actual operations will be sequenced via the command buffer.",
      "parentUuid": "6b0e76ac_b254a7ad",
      "range": {
        "startLine": 548,
        "startChar": 70,
        "endLine": 548,
        "endChar": 84
      },
