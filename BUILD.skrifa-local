load("@rules_rust//rust:defs.bzl", "rust_library")

rust_library(
    name = "skrifa",
    srcs = glob(
        include = ["src/**/*.rs", "generated/**/*.rs"],
        allow_empty = False,
    ),
    crate_features = ["scale", "std"],
    visibility = ["//visibility:public"],
    deps = [
        "@fonttypes-local//:font-types",
        "@readfonts-local//:read-fonts",
        "@fontations//:bytemuck",
    ],
)

