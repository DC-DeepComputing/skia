      "side": 1,
      "message": "Greg, do you know where this pattern came from historically? I feel like it\u0027s unnecessary and we should just be able to call `init()` directly (and it should return void).",
      "range": {
        "startLine": 84,
        "startChar": 29,
        "endLine": 84,
        "endChar": 53
      },
      "revId": "4397477b7b3ad0e70b6fc39582a74636bacc103f",
