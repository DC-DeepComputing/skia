      "message": "Skia itself only really builds/works in little-endian mode. skcms supports reading/writing big-endian 16-bit unorm data (eg, from PNG), but half-floats are always assumed little-endian.",
      "range": {
        "startLine": 171,
        "startChar": 4,
        "endLine": 171,
        "endChar": 60
      },
      "revId": "363e22e422a14ec36ddba8ee270141e5b9fbcbd5",
