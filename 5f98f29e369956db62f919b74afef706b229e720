      "writtenOn": "2026-02-12T14:10:00Z",
      "side": 1,
      "message": "It is better to condition this dep on `skia_use_partition_alloc`. Then, tools/partition_alloc/BUILD.gn can be simpler (fewer conditions) and we don\u0027t need to #ifdef tools/partition_alloc/TestSupport.cpp, which is easier for Bazel integration.",
      "range": {
        "startLine": 2834,
        "startChar": 11,
        "endLine": 2834,
        "endChar": 16
      },
      "revId": "5f98f29e369956db62f919b74afef706b229e720",
