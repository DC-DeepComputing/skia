      "writtenOn": "2026-01-30T15:09:30Z",
      "side": 1,
      "message": "Where does this naming pattern come from? My quick search in Skia for where we use this two function pattern uses the names SkFoof and SkFooVAList. So if we followed that here we\u0027d name these SkLogf and SkLogVAList. IMO just having a v in front of the name is not very clear what the function does.",
      "range": {
        "startLine": 20,
        "startChar": 5,
        "endLine": 20,
        "endChar": 11
      },
      "revId": "114f4f0483f9214043628ebb351a451894d3fc69",
