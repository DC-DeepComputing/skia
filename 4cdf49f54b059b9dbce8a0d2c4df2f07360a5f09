    {
      "unresolved": true,
      "key": {
        "uuid": "2de8743e_b032a792",
        "filename": "src/gpu/ganesh/GrProgramDesc.h",
        "patchSetId": 9
      },
      "lineNbr": 91,
      "author": {
        "id": 5395
      },
      "writtenOn": "2024-07-03T18:57:13Z",
      "side": 1,
      "message": "This wasn\u0027t used outside the file, so by making it private we can avoid a detail like this (effectively showing one\u0027s work in header size) from leaking out.",
      "parentUuid": "c091fbd4_5cc14536",
      "range": {
        "startLine": 91,
        "startChar": 0,
        "endLine": 91,
        "endChar": 8
      },
      "revId": "4cdf49f54b059b9dbce8a0d2c4df2f07360a5f09",
