      "writtenOn": "2023-01-06T18:05:38Z",
      "side": 1,
      "message": "If every caller is expected to be checking against this internal constant, or calling `sk_double_nearly_zero` on both a and b, maybe it makes sense to just have this function check `a` and `b` for nearly zero. If they are both nearly zero, return true; if only one is, return false; and if neither are, then proceed with the rest of the function?",
      "range": {
        "startLine": 36,
        "startChar": 4,
        "endLine": 42,
        "endChar": 45
      },
      "revId": "f5355a0a2d41376399c58a08f2879c02d7eac04a",
