import ast
import hashlib
import json
import os
import platform
import shutil
import stat
import sys
import tempfile
import tarfile

from typing import Callable
from urllib.request import urlopen
from dataclasses import dataclass

@dataclass
class Tool:
  name: str
  os: str
  cpu: str
  archive_name: Callable[['Tool', str], str]
  member_name: Callable[['Tool', str], str]

  def platform(self) -> str:
    return f'{self.cpu}-{self.os}'

MEMBERS_ALL='*'

TOOLS = {
  'wasmtime': Tool(
    name='wasmtime',
    archive_name=lambda t, v: f'wasmtime-{v}-{t.platform()}.tar.xz',
    member_name=lambda t, v: f'wasmtime-{v}-{t.platform()}/wasmtime',
    os={'darwin': 'macos', 'linux': 'linux', 'linux2': 'linux', 'win32': 'windows'}[sys.platform],
    cpu={'aarch64': 'aarch64', 'arm64': 'aarch64', 'amd64': 'x86_64','x86_64': 'x86_64'}[platform.machine().lower()],
  ),
  'wasi-sdk': Tool(
    name='wasi-sdk',
    archive_name=lambda t, v: f'{v}-{t.platform()}.tar.gz',
    member_name=lambda t, v: MEMBERS_ALL,
    os={'darwin': 'macos', 'linux': 'linux', 'linux2': 'linux', 'win32': 'windows'}[sys.platform],
    cpu={'aarch64': 'arm64', 'arm64': 'arm64', 'amd64': 'x86_64','x86_64': 'x86_64'}[platform.machine().lower()],
  )
}


def sha256sum(path):
  try:
    with open(path, 'rb') as f:
      return hashlib.sha256(f.read()).hexdigest()
  except OSError:
    return ''


def parse_deps(path):
  with open(path, 'r', encoding='utf-8') as f:
    tree = ast.parse(f.read())
  result = {}
  for node in tree.body:
    if isinstance(node, ast.Assign) and isinstance(node.targets[0], ast.Name):
      try:
        result[node.targets[0].id] = ast.literal_eval(node.value)
      except ValueError:
        pass
  return result


def up_to_date(version_path: str, desired_version: str, current_sha256: str) -> bool:
  # When we download, we write the version information to a file so we can
  # keep track of which version we have. Read the file to determine whether the
  # current version (if any) matches what we want.
  current_version = {
    'version': '',
    'sha256': '',
  }
  try:
    with open(version_path, 'r', encoding='utf8') as f:
      current_version = json.load(f)
  except OSError:
    pass

  if desired_version != current_version['version']:
    print('Version "%s" requested by DEPS differs from current version "%s"' % (
        desired_version, current_version['version']))
    return False
  elif current_sha256 != current_version['sha256']:
    print('sha256 sum "%s" does not match last-downloaded version "%s"' % (
        current_sha256, current_version['sha256']))
    return False
  else:
    return True


def download_release_archive(url: str, expected_sha: str) -> str:
  filename = os.path.basename(url)
  archive = os.path.join(tempfile.mkdtemp(), filename)
  with open(archive, 'wb') as f:
    print('Downloading release archive at %s to %s' % (url, archive))
    f.write(urlopen(url).read())
    if sha256sum(archive) != expected_sha:
      print('sha256 sum (%s) of %s does not match expected (%s)' % (sha256sum(archive), archive, expected_sha))
      return None
  return archive


def install_from_archive(archive: str, member_name: str, dst_path: str) -> bool:
  with tarfile.open(archive, 'r') as f:
    if member_name == MEMBERS_ALL:
      tmp_dst = tempfile.mkdtemp()
      try:
        f.extractall(path=tmp_dst)
        # Strip the leading directory. E.g. if tar extracts to
        # '/tmp/foo/foo/{a,b,c...}', we will extract to 'dst/foo/{a,b,c}'.
        members = os.listdir(tmp_dst)
        if len(members) == 1:
          only = os.path.join(tmp_dst, members[0])
          src_root = only if os.path.isdir(only) else tmp_dst
        else:
          src_root = tmp_dst
        shutil.copytree(src=src_root, dst=dst_path)
      finally:
        shutil.rmtree(tmp_dst)
    else:
      member = f.getmember(member_name)
      with f.extractfile(member) as src, open(dst_path, 'wb') as dst:
        shutil.copyfileobj(src, dst)

  if member_name != MEMBERS_ALL and sys.platform != 'win32':
    uid = os.getuid()
    gid = os.getgid()
    os.chown(dst_path, uid, gid)
    os.chmod(dst_path, stat.S_IRUSR | stat.S_IWUSR | stat.S_IXUSR |
                       stat.S_IRGRP                | stat.S_IXGRP |
                       stat.S_IROTH                | stat.S_IXOTH )

  return True


def install_tool(deps, tool: Tool):
  desired_version = deps['vars'][f'{tool.name}_version']
  url_base = deps['vars'][f'{tool.name}_download_url_base']
  archive_shas = deps['vars'][f'{tool.name}_archive_sha256']

  externals_dst = os.path.join('third_party', 'externals', tool.name)
  bin_path = os.path.join(externals_dst, tool.name)

  version_path = os.path.join(externals_dst, f'{tool.name}.version')
  bin_tuple = '%s-%s-%s' % (tool.name, desired_version, tool.platform())
  current_sha256 = sha256sum(bin_path)
  os.makedirs(externals_dst, exist_ok=True)

  if up_to_date(version_path, desired_version, current_sha256):
    print(f'{tool.name} already up to date.')
    return

  # Download
  print('Fetching %s at %s' % (bin_tuple, desired_version))
  archive_name = tool.archive_name(tool, desired_version)
  expected_sha = archive_shas[archive_name]
  archive_url = f'{url_base}/{archive_name}'
  archive = download_release_archive(archive_url, expected_sha)
  if archive is None:
    print(f'Error downloading {archive_url}')
    exit(1)

  # Install binaries
  print(f'Installing {bin_tuple} to {bin_path}')
  if not install_from_archive(archive, tool.member_name(tool, desired_version), bin_path):
    print(f'Error installing {archive_url}')
    exit(1)

  # Write the downloaded version info to a file.
  current_version = {}
  current_version['version'] = desired_version
  current_version['sha256'] = sha256sum(bin_path)
  with open(version_path, 'w', encoding='utf8') as f:
    json.dump(current_version, f, sort_keys=True, indent=2)

  print(f'{tool.name} updated to {desired_version}')
  return True


def main():
  os.chdir(os.path.join(os.path.dirname(__file__), os.pardir))
  deps = parse_deps('DEPS')
  for tool in TOOLS:
    install_tool(deps, TOOLS[tool])


if __name__ == '__main__':
  main()
