      "side": 1,
      "message": "Overall this lgtm, but the removal of `surface-\u003eflush()` will break timings for graphite\u0027s viewer/nanobench integration. More details in inline comments.",
      "revId": "f6e80a1ec29eb6c40bdc7dc38c4e357e9ea1058a",
      "serverId": "5086850b-e599-37d2-8ec8-ff16aeccbf02"
