      "writtenOn": "2025-03-13T13:59:43Z",
      "side": 1,
      "message": "There is an open question about how we want to handle analytic clipping and clip shaders with precompilation. We could always combine them w/ overgeneration, we could require that they include clip options X paint options, or we could ignore them entirely and just trigger on-the-fly compilation.\n\nWhen we have a low priority background thread, handling the analytic clip overgeneration is probably acceptable.",
      "range": {
        "startLine": 413,
        "startChar": 0,
        "endLine": 413,
        "endChar": 70
      },
      "revId": "06838ed7b10dc93b712a22d07e90b7f174dab2c8",
      "serverId": "5086850b-e599-37d2-8ec8-ff16aeccbf02"
    },
