              },
              "replacement": "    _out.sk_FragColor.x \u003d half((_skTemp0 \u003d (_uniforms.a), _skTemp1 \u003d (select(_skTemp0, ~_skTemp0, _skTemp0 \u003c 0)), select(31 - int(clz(_skTemp1)), int(-1), _skTemp1 \u003d\u003d int(0)))) + half((_skTemp2 \u003d (_uniforms.b), select(31 - int(clz(_skTemp2)), int(-1), _skTemp2 \u003d\u003d uint(0))));\n    _out.sk_FragColor.xy \u003d half2((_skTemp3 \u003d (int2(_uniforms.a)), select(31 - int2(clz(_skTemp3)), int2(-1), _skTemp3 \u003d\u003d int2(0)))) + half2((_skTemp4 \u003d (uint2(_uniforms.b)), select(31 - int2(clz(_skTemp4)), int2(-1), _skTemp4 \u003d\u003d uint2(0))));\n    _out.sk_FragColor.xyz \u003d half3((_skTemp5 \u003d (int3(_uniforms.a)), select(31 - int3(clz(_skTemp5)), int3(-1), _skTemp5 \u003d\u003d int3(0)))) + half3((_skTemp6 \u003d (uint3(_uniforms.b)), select(31 - int3(clz(_skTemp6)), int3(-1), _skTemp6 \u003d\u003d uint3(0))));\n    _out.sk_FragColor \u003d half4((_skTemp7 \u003d (int4(_uniforms.a)), select(31 - int4(clz(_skTemp7)), int4(-1), _skTemp7 \u003d\u003d int4(0)))) + half4((_skTemp8 \u003d (uint4(_uniforms.b)), select(31 - int4(clz(_skTemp8)), int4(-1), _skTemp8 \u003d\u003d uint4(0))));\n"
