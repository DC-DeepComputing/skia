      "message": "Ack",
      "parentUuid": "b3014291_22b2511c",
      "range": {
        "startLine": 115,
        "startChar": 10,
        "endLine": 115,
        "endChar": 33
      },
      "revId": "87f745964e4790e69ca412a4a7e47deef388984e",
