        "id": 5395
      },
      "writtenOn": "2025-09-15T15:07:11Z",
      "side": 1,
      "message": "Just to check, libpng copies the data during this call, right? Otherwise, the data object goes out of scope",
      "range": {
        "startLine": 332,
        "startChar": 8,
        "endLine": 332,
        "endChar": 30
      },
      "revId": "0f1de341b6aa33fa16569df8b18acf8bc19a8624",
