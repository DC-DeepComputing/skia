        "id": 5036
      },
      "writtenOn": "2022-03-21T13:56:51Z",
      "side": 1,
      "message": "In my head I think I have an idea about why we would want or need this. But I\u0027m curious to hear your reasoning.",
      "range": {
        "startLine": 34,
        "startChar": 31,
        "endLine": 34,
        "endChar": 71
      },
      "revId": "22f2d41a6685f69394f978d1ca5314041a6e2303",
