      "writtenOn": "2022-02-07T15:28:10Z",
      "side": 1,
      "message": "How does this work when I client passes in a pointer to their own data? Are we copying that data before we return to the client? Are we making a cpu copy that we then ref here?",
      "range": {
        "startLine": 27,
        "startChar": 18,
        "endLine": 27,
        "endChar": 34
      },
      "revId": "d1d5158a010bedc1e13e7f9c65fd2a2de21c5438",
