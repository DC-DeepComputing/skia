      "side": 1,
      "message": "Good points, simplified accordingly, but not using `const SkFontArguments\u0026` as constructor argument but just `const SkFontArguments::PaletteOverride\u0026` as that\u0027s the only part of font arguments that varies between tests.",
      "parentUuid": "6c6ab1e2_a44a9c01",
