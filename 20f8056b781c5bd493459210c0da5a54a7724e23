      "writtenOn": "2025-10-26T15:29:30Z",
      "side": 1,
      "message": "Can we spell out the path data constness? `const SkPathData`\n\n(will prolly need to update a bunch of factories too)",
      "range": {
        "startLine": 1950,
        "startChar": 10,
        "endLine": 1950,
        "endChar": 20
      },
      "revId": "20f8056b781c5bd493459210c0da5a54a7724e23",
