        "id": 18914
      },
      "writtenOn": "2022-08-17T14:12:08Z",
      "side": 1,
      "message": "Ah, I see. That\u0027s much cleaner, and got each vertex\u0027s appending to be on one line again. Yay!",
      "parentUuid": "5c5fd5c8_d83cdcba",
      "range": {
        "startLine": 152,
        "startChar": 27,
        "endLine": 152,
        "endChar": 66
      },
      "revId": "40766716f5fc11f434563d5cbc8c98ccbbbd5ef0",
