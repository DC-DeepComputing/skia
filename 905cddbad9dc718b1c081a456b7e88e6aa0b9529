      "writtenOn": "2021-11-11T16:49:37Z",
      "side": 1,
      "message": "Is the default always a single? Seems like if multiple is True then the default might be multiple? In other words, should the default be a list?",
      "range": {
        "startLine": 32,
        "startChar": 57,
        "endLine": 32,
        "endChar": 59
      },
      "revId": "905cddbad9dc718b1c081a456b7e88e6aa0b9529",
