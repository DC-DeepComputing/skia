      },
      "writtenOn": "2022-04-25T17:01:49Z",
      "side": 1,
      "message": "OK, then SGTM--it seems like we would be pretty safe to jettison it.",
      "parentUuid": "2220715c_b35ff65b",
      "revId": "fe0976d38b1ad52c1e6703219cdf0f6f1419a857",
      "serverId": "5086850b-e599-37d2-8ec8-ff16aeccbf02"
    },
    {
      "unresolved": false,
