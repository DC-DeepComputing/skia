      "writtenOn": "2023-11-27T20:20:25Z",
      "side": 1,
      "message": "Just to check my understanding, we need to specify this because tests that are not run via adb_test_runner.go may also have this flag?",
      "range": {
        "startLine": 46,
        "startChar": 2,
        "endLine": 46,
        "endChar": 14
      },
      "revId": "b6896cb52de7b54d33c207ea5038beae34cc5e3d",
