      "writtenOn": "2023-11-27T21:21:57Z",
      "side": 1,
      "message": "Great idea!\n\nI went with just `rpi` because `if host \u003d\u003d \"rpi\" { ... }` seems more natural than `if host \u003d\u003d \"on_rpi\" { ... }`.",
      "parentUuid": "90b08a73_8d9cd214",
      "range": {
        "startLine": 55,
        "startChar": 75,
        "endLine": 55,
        "endChar": 86
      },
      "revId": "b6896cb52de7b54d33c207ea5038beae34cc5e3d",
