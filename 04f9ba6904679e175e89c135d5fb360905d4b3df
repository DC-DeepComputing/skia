      "writtenOn": "2024-02-02T15:41:34Z",
      "side": 1,
      "message": "Ah, you\u0027re right, since we are coming from premul, if A\u003d0 then RGB should be zero as well unless the color was out of gamut, in which case I feel like transparent white actually kinda makes sense.",
      "parentUuid": "5a7cb046_c9d0a546",
      "range": {
        "startLine": 54,
        "startChar": 23,
        "endLine": 54,
        "endChar": 46
      },
