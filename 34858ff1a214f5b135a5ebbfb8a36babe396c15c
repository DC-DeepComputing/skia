      "writtenOn": "2024-07-09T17:21:49Z",
      "side": 1,
      "message": "If we decided to add UBO support wouldn\u0027t we open a big can of worms with array stride?",
      "parentUuid": "cdcab256_ffc0105c",
      "revId": "34858ff1a214f5b135a5ebbfb8a36babe396c15c",
      "serverId": "5086850b-e599-37d2-8ec8-ff16aeccbf02"
    },
