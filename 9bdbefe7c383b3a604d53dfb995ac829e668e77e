      "writtenOn": "2023-03-15T17:04:26Z",
      "side": 1,
      "message": "Any downsides to the older approach?",
      "range": {
        "startLine": 2232,
        "startChar": 35,
        "endLine": 2232,
        "endChar": 36
      },
      "revId": "9bdbefe7c383b3a604d53dfb995ac829e668e77e",
