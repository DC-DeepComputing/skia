      "lineNbr": 1053,
      "author": {
        "id": 3568682
      },
      "writtenOn": "2025-06-04T18:19:29Z",
      "side": 1,
      "message": "I\u0027m unclear on the benefit of doing this, will we be able to allocate less tmp memory?",
      "parentUuid": "dcc882fe_90c9282e",
      "range": {
        "startLine": 1040,
        "startChar": 0,
        "endLine": 1053,
        "endChar": 10
      },
      "revId": "f253246dd85645063f4b53899be7b6ecdaaf4016",
