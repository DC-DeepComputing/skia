        "id": 13824
      },
      "writtenOn": "2023-04-25T13:57:22Z",
      "side": 1,
      "message": "If we\u0027re keeping some kind of Caps method to return a dst read requirement, and that method is what actually decides between non-kNone requirements, then I think it makes sense for this to be here.",
      "parentUuid": "c6bab7f0_6d4e95bf",
      "range": {
        "startLine": 56,
        "startChar": 11,
        "endLine": 56,
        "endChar": 29
      },
      "revId": "db648177c1c766db7dc69e791ecc0e28e126a316",
