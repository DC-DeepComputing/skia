module(
    name = "skia",
)

# Bazel and Toolchain deps
EMSDK_VERSION = "4.0.7"

bazel_dep(name = "bazel_skylib", version = "1.7.1")
bazel_dep(name = "buildifier_prebuilt", version = "8.0.3")
bazel_dep(name = "emsdk", version = EMSDK_VERSION)
bazel_dep(name = "gazelle", version = "0.43.0")
bazel_dep(name = "platforms", version = "0.0.11")
bazel_dep(name = "rules_cc", version = "0.1.1")
bazel_dep(name = "rules_go", version = "0.54.0")
bazel_dep(name = "rules_license", version = "1.0.0")
bazel_dep(name = "rules_python", version = "1.3.0")

# C++ deps
bazel_dep(name = "skia_user_config")  # local
bazel_dep(name = "freetype_config")  # local

# TODO(kjlubick) use version from https://registry.bazel.build/ for better interop

# TODO(kjlubick) Use these instead of our own custom versions for better interop
# bazel_dep(name = "libpng", version = "1.6.47.bcr.1")
# bazel_dep(name = "libwebp", version = "1.5.0")
# bazel_dep(name = "libjpeg_turbo", version = "2.1.91")
# bazel_dep(name = "brotli", version = "1.1.0")

# Configuration
git_override(
    module_name = "emsdk",
    remote = "https://github.com/emscripten-core/emsdk.git",
    strip_prefix = "bazel",
    tag = EMSDK_VERSION,
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    python_version = "3.13",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "py_deps",
    python_version = "3.13",
    requirements_lock = "//:requirements.txt",
)
use_repo(pip, "py_deps")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "com_github_flynn_json5",
    "com_github_golang_glog",
    "com_github_google_uuid",
    "com_github_kisielk_errcheck",
    "com_github_shirou_gopsutil",
    "com_github_stretchr_testify",
    "com_github_trietmn_go_wiki",
    "com_google_cloud_go_pubsub",
    "com_google_cloud_go_storage",
    "org_golang_google_api",
    "org_golang_google_protobuf",
    "org_golang_x_exp",
    "org_skia_go_infra",
)

# Bazel deps we make ourselves
local_path_override(
    module_name = "skia_user_config",
    path = "include/config",
)

local_path_override(
    module_name = "freetype_config",
    path = "third_party/freetype2/include",
)

c_plus_plus_modules = use_extension("//bazel:deps.bzl", "c_plus_plus_modules")
use_repo(c_plus_plus_modules,
    "wuffs",
    "libjxl",
    "libpng",
    "libwebp",
    "libjpeg_turbo",
    "freetype",
)

download_linux_amd64_toolchain = use_repo_rule("//toolchain:download_linux_amd64_toolchain.bzl", "download_linux_amd64_toolchain")

download_linux_amd64_toolchain(name = "clang_linux_amd64")

download_clang_mac_toolchain = use_repo_rule("//toolchain:download_mac_toolchain.bzl", "download_mac_toolchain")

download_clang_mac_toolchain(name = "clang_mac")
#toolchain_names = ["clang_windows_amd64", "ndk_linux_amd64", "clang_ios"],
