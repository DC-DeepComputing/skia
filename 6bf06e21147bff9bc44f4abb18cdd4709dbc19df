              },
              "replacement": "    void setLabel(std::string_view label) const {\n        SkAutoMutexExclusive lock(fLabelMutex);\n"
            },
            {
              "path": "src/gpu/graphite/Resource.h",
              "range": {
                "startLine": 282,
                "startChar": 0,
                "endLine": 285,
                "endChar": 0
              },
              "replacement": "        // It is not always safe to immediately update the backend GPU resource label. Mark\n        // fBackendLabelDirty as true so it can be updated when appropriate. We use\n        // memory_order_release to ensure that the write to fLabel is visible to other threads\n        // before fBackendLabelDirty becomes true.\n        fBackendLabelDirty.store(true, std::memory_order_release);\n"
            },
