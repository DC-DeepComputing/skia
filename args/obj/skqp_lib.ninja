defines = -DSK_TRIVIAL_ABI=\[\[clang$:$:trivial_abi\]\] -DSK_GAMMA_APPLY_TO_A8 -DSK_ALLOW_STATIC_GLOBAL_INITIALIZERS=1 -DGR_TEST_UTILS=1 -DSK_TYPEFACE_FACTORY_CORETEXT -DSK_GL -DSK_ENABLE_DUMP_GPU -DSK_SUPPORT_PDF -DSK_CODEC_DECODES_JPEG -DSK_CODEC_DECODES_JPEG_GAINMAPS -DSK_XML -DSK_ENABLE_ANDROID_UTILS -DSK_HAS_HEIF_LIBRARY -DSK_CODEC_DECODES_PNG -DSK_CODEC_DECODES_RAW -DSK_CODEC_DECODES_WEBP -DSK_HAS_WUFFS_LIBRARY -DSK_ENABLE_PRECOMPILE -DSK_ASSUME_GL=1 -DSK_GANESH -DSK_USE_PERFETTO -DSK_ENABLE_API_AVAILABLE
framework_dirs =
include_dirs = -I../include/third_party/vulkan -I..
cflags = -Wno-attributes -ffp-contract=off -fstrict-aliasing -fPIC -fvisibility=hidden -isysroot /Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX13.1.sdk -target arm64-apple-macos11 -g -gdwarf-4
cflags_cc = -std=c++17 -fvisibility-inlines-hidden -fno-exceptions -fno-rtti
root_out_dir = .
target_output_name = skqp_lib

build obj/skqp_lib.inputdeps.stamp: stamp obj/skia.h.stamp obj/third_party/externals/spirv-tools/spvtools_core_enums_unified1.stamp obj/third_party/externals/spirv-tools/spvtools_core_tables_unified1.stamp obj/third_party/externals/spirv-tools/spvtools_generators_inc.stamp obj/third_party/externals/spirv-tools/spvtools_glsl_tables_glsl1-0.stamp obj/third_party/externals/spirv-tools/spvtools_language_header_cldebuginfo100.stamp obj/third_party/externals/spirv-tools/spvtools_language_header_debuginfo.stamp obj/third_party/externals/spirv-tools/spvtools_language_header_vkdebuginfo100.stamp obj/third_party/externals/spirv-tools/spvtools_opencl_tables_opencl1-0.stamp obj/third_party/externals/spirv-tools/spvtools_vendor_tables_debuginfo.stamp obj/third_party/externals/spirv-tools/spvtools_vendor_tables_nonsemantic.clspvreflection.stamp obj/third_party/externals/spirv-tools/spvtools_vendor_tables_nonsemantic.shader.debuginfo.100.stamp obj/third_party/externals/spirv-tools/spvtools_vendor_tables_opencl.debuginfo.100.stamp obj/third_party/externals/spirv-tools/spvtools_vendor_tables_spv-amd-gcn-shader.stamp obj/third_party/externals/spirv-tools/spvtools_vendor_tables_spv-amd-shader-ballot.stamp obj/third_party/externals/spirv-tools/spvtools_vendor_tables_spv-amd-shader-explicit-vertex-parameter.stamp obj/third_party/externals/spirv-tools/spvtools_vendor_tables_spv-amd-shader-trinary-minmax.stamp obj/third_party/icu/make_data_assembly.stamp
build obj/tools/skqp/src/skqp_lib.skqp.o: cxx ../tools/skqp/src/skqp.cpp || obj/skqp_lib.inputdeps.stamp
  source_file_part = skqp.cpp
  source_name_part = skqp
build obj/tools/skqp/src/skqp_lib.skqp_GpuTestProcs.o: cxx ../tools/skqp/src/skqp_GpuTestProcs.cpp || obj/skqp_lib.inputdeps.stamp
  source_file_part = skqp_GpuTestProcs.cpp
  source_name_part = skqp_GpuTestProcs

build obj/skqp_lib.stamp: stamp obj/tools/skqp/src/skqp_lib.skqp.o obj/tools/skqp/src/skqp_lib.skqp_GpuTestProcs.o || obj/gm.stamp ./libskia.a obj/tests.stamp obj/tool_utils.stamp obj/gpu_tool_utils.stamp obj/etc1.stamp obj/flags.stamp ./libsvg.a ./libskshaper.a ./libskunicode.a ./libskottie.a ./libsksg.a obj/modules/skottie/gm.stamp obj/modules/skottie/utils.stamp ./libskparagraph.a obj/modules/skparagraph/gm.stamp obj/fontmgr_android_tests.stamp obj/fontmgr_fontconfig_tests.stamp obj/fontmgr_mac_ct_tests.stamp obj/test.stamp obj/typeface_fontations_tests.stamp obj/modules/bentleyottmann/tests.stamp ./libbentleyottmann.a obj/modules/skottie/tests.stamp obj/modules/skparagraph/tests.stamp obj/modules/sksg/tests.stamp obj/modules/skshaper/tests.stamp obj/modules/skunicode/tests.stamp ./libicu_bidi.a obj/modules/svg/tests.stamp ./libpng.a ./libzlib.a obj/third_party/zlib/zlib_adler32_simd.stamp obj/third_party/zlib/zlib_crc32_simd.stamp obj/third_party/zlib/zlib_inflate_chunk_simd.stamp obj/third_party/zlib/zlib_x86_x64_simd.stamp ./libwebp.a ./libwebp_sse41.a
