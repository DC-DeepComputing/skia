defines = -DSK_TRIVIAL_ABI=\[\[clang$:$:trivial_abi\]\] -DSK_ENABLE_PRECOMPILE -DSK_ASSUME_GL=1 -DSK_GANESH -DSK_USE_PERFETTO -DSK_ENABLE_API_AVAILABLE
framework_dirs =
include_dirs = -I../client_utils/android -I../include/android -I../include/codec -I../include/config -I../include/core -I../include/docs -I../include/effects -I../include/encode -I../include/gpu -I../include/pathops -I../include/ports -I../include/svg -I../include/utils -I../include/utils/mac -I../modules/skottie/include -I../modules/skparagraph/include -I../modules/skshaper/include -I../modules/svg/include -I..
