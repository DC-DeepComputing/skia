defines = -DSK_TRIVIAL_ABI=\[\[clang$:$:trivial_abi\]\]
framework_dirs =
include_dirs =
cflags = -std=c11 -Wno-attributes -ffp-contract=off -fstrict-aliasing -fPIC -fvisibility=hidden -isysroot /Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX13.1.sdk -target arm64-apple-macos11 -g -gdwarf-4
cflags_cc = -std=c++17 -fvisibility-inlines-hidden -fno-exceptions -fno-rtti
root_out_dir = .
target_output_name = libskcms

build obj/modules/skcms/libskcms.skcms.o: cxx ../modules/skcms/skcms.cc
  source_file_part = skcms.cc
  source_name_part = skcms

build ./libskcms.a: alink obj/modules/skcms/libskcms.skcms.o
  arflags =
  output_extension = .a
  output_dir = 
