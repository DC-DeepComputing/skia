defines = -DADLER32_SIMD_NEON -DSK_TRIVIAL_ABI=\[\[clang$:$:trivial_abi\]\] -DARM_OS_IOS
framework_dirs =
include_dirs =
cflags = -Wno-attributes -ffp-contract=off -fstrict-aliasing -fPIC -fvisibility=hidden -isysroot /Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX13.1.sdk -target arm64-apple-macos11 -g -gdwarf-4 -w
cflags_c =
root_out_dir = .
target_output_name = zlib_adler32_simd

build obj/third_party/externals/zlib/zlib_adler32_simd.adler32_simd.o: cc ../third_party/externals/zlib/adler32_simd.c
  source_file_part = adler32_simd.c
  source_name_part = adler32_simd

build obj/third_party/zlib/zlib_adler32_simd.stamp: stamp obj/third_party/externals/zlib/zlib_adler32_simd.adler32_simd.o
