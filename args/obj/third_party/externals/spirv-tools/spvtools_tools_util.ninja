defines = -DSK_TRIVIAL_ABI=\[\[clang$:$:trivial_abi\]\]
framework_dirs =
include_dirs = -I../third_party/externals/spirv-tools -I../third_party/externals/spirv-headers/include -I../third_party/externals/spirv-tools/include -Igen/third_party/externals/spirv-tools
cflags = -Wno-attributes -ffp-contract=off -fstrict-aliasing -fPIC -fvisibility=hidden -isysroot /Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX13.1.sdk -target arm64-apple-macos11 -g -gdwarf-4 -Wno-implicit-fallthrough -Wno-newline-eof -Wno-unreachable-code-break -Wno-unreachable-code-return -std=c++17
cflags_cc = -std=c++17 -fvisibility-inlines-hidden -fno-exceptions -fno-rtti
root_out_dir = .
target_output_name = spvtools_tools_util

build obj/third_party/externals/spirv-tools/tools/util/spvtools_tools_util.flags.o: cxx ../third_party/externals/spirv-tools/tools/util/flags.cpp
  source_file_part = flags.cpp
  source_name_part = flags
build obj/third_party/externals/spirv-tools/tools/util/spvtools_tools_util.cli_consumer.o: cxx ../third_party/externals/spirv-tools/tools/util/cli_consumer.cpp
  source_file_part = cli_consumer.cpp
  source_name_part = cli_consumer

build obj/third_party/externals/spirv-tools/spvtools_tools_util.stamp: stamp obj/third_party/externals/spirv-tools/tools/util/spvtools_tools_util.flags.o obj/third_party/externals/spirv-tools/tools/util/spvtools_tools_util.cli_consumer.o || obj/third_party/externals/spirv-tools/spvtools_headers.stamp
