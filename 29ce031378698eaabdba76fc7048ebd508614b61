      "writtenOn": "2023-05-05T10:59:14Z",
      "side": 1,
      "message": "Why can\u0027t this just be the fontations_ffi cc_library? Why do we have depend on the headers and include the generated cc file above?",
      "range": {
        "startLine": 348,
        "startChar": 36,
        "endLine": 348,
        "endChar": 50
      },
      "revId": "29ce031378698eaabdba76fc7048ebd508614b61",
