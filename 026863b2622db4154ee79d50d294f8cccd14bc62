        "id": 5065
      },
      "writtenOn": "2021-10-25T22:25:04Z",
      "side": 1,
      "message": "And doing a get() to pass an argument rather than passing it through directly seems strange to me. I can pass it by value instead.",
      "parentUuid": "fd5604d8_68dc1357",
      "range": {
        "startLine": 86,
        "startChar": 38,
        "endLine": 86,
        "endChar": 66
      },
      "revId": "026863b2622db4154ee79d50d294f8cccd14bc62",
