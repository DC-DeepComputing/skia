      },
      "lineNbr": 340,
      "author": {
        "id": 8341
      },
      "writtenOn": "2025-04-28T20:14:28Z",
      "side": 1,
      "message": "Ah, I think I follow the logic now. Wouldn\u0027t we then need to handle zero\u0027ing out if we end up returning bytes so our zero region at the end of the reservation doesn\u0027t line up anymore.",
      "parentUuid": "b9ed46e1_92f16e81",
      "range": {
        "startLine": 338,
        "startChar": 0,
        "endLine": 340,
        "endChar": 13
      },
      "revId": "3506a82ddd35d9fce353d2feb113bfdaa8053915",
