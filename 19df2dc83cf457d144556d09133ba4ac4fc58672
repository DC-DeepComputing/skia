      },
      "writtenOn": "2026-10-28T17:16:33Z",
      "side": 1,
      "message": "Is it not sufficient to just set `*b \u003d maxCoord - minCoord`?",
      "range": {
        "startLine": 40,
        "startChar": 0,
        "endLine": 46,
        "endChar": 0
      },
      "revId": "19df2dc83cf457d144556d09133ba4ac4fc58672",
