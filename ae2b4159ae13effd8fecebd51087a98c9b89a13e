      "side": 1,
      "message": "These are going to be annoying to remember for me (and other devs probably). Can we have our test runners set these environment variables or will devs need to configure them?",
      "range": {
        "startLine": 22,
        "startChar": 10,
        "endLine": 22,
        "endChar": 32
      },
      "revId": "ae2b4159ae13effd8fecebd51087a98c9b89a13e",
