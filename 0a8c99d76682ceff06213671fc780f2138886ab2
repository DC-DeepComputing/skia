      },
      "writtenOn": "2022-07-07T14:46:32Z",
      "side": 1,
      "message": "This seems very specific, should this be something passed in (pass in a `SkFontArguments::VariationPosition`)?",
      "range": {
        "startLine": 577,
        "startChar": 0,
        "endLine": 578,
        "endChar": 42
      },
      "revId": "0a8c99d76682ceff06213671fc780f2138886ab2",
