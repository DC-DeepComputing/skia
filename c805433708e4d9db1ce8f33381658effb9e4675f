      "writtenOn": "2023-11-10T15:08:23Z",
      "side": 1,
      "message": "This changes the behavior on !MAC, why not use `ToolUtils::TestFontMgr()`?",
      "range": {
        "startLine": 468,
        "startChar": 0,
        "endLine": 472,
        "endChar": 6
      },
      "revId": "c805433708e4d9db1ce8f33381658effb9e4675f",
