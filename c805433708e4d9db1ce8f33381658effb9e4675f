    },
    {
      "unresolved": true,
      "key": {
        "uuid": "0104e951_210d30af",
        "filename": "modules/skottie/src/SkottieTool.cpp",
        "patchSetId": 8
      },
      "lineNbr": 472,
      "author": {
        "id": 5395
      },
      "writtenOn": "2023-11-10T15:24:38Z",
      "side": 1,
      "message": "Depending on TestFontMgr massively increases the code size (and also changes the behavior) because it also brings in the portable font manager. Since we use skottietool as a baseline for code size, I figured we would not want to massively change it (but probably should have a \"real\" font manager to make sure we are measuring that code).\n\nIn any case, I don\u0027t want TestFontMgr to be used outside of tests where possible, especially when we know clients look at these files to see what they should do to use Skottie/SVG.",
      "parentUuid": "e8a72c72_a1e650e1",
      "range": {
        "startLine": 468,
        "startChar": 0,
        "endLine": 472,
        "endChar": 6
      },
