      "writtenOn": "2023-06-22T14:32:11Z",
      "side": 1,
      "message": "This seems redundant with `atlasBounds`, since we can apply inversion in the AtlasShapeRenderStep. The required allocation in the atlas will be the same for both regular and inverse fills/strokes.\n\nThe shape shouldn\u0027t be responsible for remembering the transformation of the atlas bounds into device space. That\u0027s already part of the Clip and DrawParams data.",
      "range": {
        "startLine": 48,
        "startChar": 4,
        "endLine": 48,
        "endChar": 58
      },
      "revId": "12d22d2cab2d5704712e172212f5563b37798949",
