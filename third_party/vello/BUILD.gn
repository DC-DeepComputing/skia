# TODO(b/278927674): This GN file is here for convenience until official Rust integration in Skia is
# ready. Currently this requires a manual build step to prepare the cxxbridge headers and a
# libvello_cpp.a artifact required by the `vello_cpp` rule below. From within this directory, run:
#
#    # x86 (debug):
#    $ cargo build --target-dir=target
#
#    # x86 (release):
#    $ cargo build --release --target-dir=target
#
#    # Apple ARM (debug):
#    $ cargo build --target=aarch64-apple-darwin --target-dir=target
#
#    # Apple ARM (release):
#    $ cargo build --target=aarch64-apple-darwin --release --target-dir=target
#
# These commands will place the artifacts under `third_party/vello/target`.

import("../third_party.gni")
import("../../gn/skia.gni")

if (skia_enable_vello_shaders) {
  action("compile_vello_ffi") {
    script = "../../gn/bazel_build.py"
    sources = [ "BUILD.bazel" ]
    outputs = [ "$root_out_dir/libvello_ffi.a" ]
    args = [
      "//third_party/vello:vello_ffi",
      "../../bazel-bin/third_party/vello/libvello_ffi.a",
    ]
  }

  action("compile_vello_rust") {
    script = "../../gn/bazel_build.py"
    sources = [ "BUILD.bazel" ]
    outputs = [ "$root_out_dir/libvello_rust.a" ]
    args = [
      "//third_party/vello:vello_rust",
      "../../bazel-bin/third_party/vello/libvello_rust.a",
    ]
  }
}

third_party("vello") {
  public_include_dirs = [
    "../../bazel-bin/",
  ]
  libs = [
    "$root_out_dir/libvello_ffi.a",
    "$root_out_dir/libvello_rust.a",
  ]
  deps = [
    ":compile_vello_ffi",
    ":compile_vello_rust",
  ]
}

