config("tint_api_config") {
  include_dirs = [
    "../externals/dawn",
    "../externals/dawn/include",
  ]

  defines = [
    "TINT_BUILD_WGSL_READER=1",
    "TINT_BUILD_WGSL_WRITER=1",
  ]

  lib_dirs = [ "$root_out_dir" ]
  libs = tint_libs + [ "absl_strings" ]
}

action("tint_cmake") {
  script = "build_tint.py"
  sources = [ "//DEPS" ]
  outputs = [ "$root_out_dir/libabsl_strings.a" ]

  # tint depends on this subset of abseil
  args = [ "cmake/dawn/third_party/abseil/absl/strings/libabsl_strings.a=libabsl_strings.a" ]
  foreach(lib, tint_libs) {
    outputs += [ "$root_out_dir/lib${lib}.a" ]
    args += [ "cmake/dawn/src/tint/lib${lib}.a=lib${lib}.a" ]
  }
}

group("tint") {
  deps = [ ":tint_cmake" ]

  public_configs = [ ":tint_api_config" ]
}
