import("//build_overrides/build.gni")
import("../third_party.gni")

if (defined(build_with_chromium) && build_with_chromium) {
  group("perfetto") {
    public_deps = [ "//third_party/perfetto:libperfetto" ]
  }
} else {
  component("perfetto") {
    public_deps = [ "//third_party/externals/perfetto/src/tracing:client_api" ]
    public_configs = [ "//third_party/externals/perfetto/gn:public_config" ]
  }
}
