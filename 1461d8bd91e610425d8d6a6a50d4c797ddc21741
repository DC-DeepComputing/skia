    {
      "unresolved": true,
      "key": {
        "uuid": "99ad6c9c_1c06d74e",
        "filename": "src/gpu/graphite/render/MeshRenderStep.cpp",
        "patchSetId": 32
      },
      "lineNbr": 183,
      "author": {
        "id": 3438316
      },
      "writtenOn": "2026-08-26T17:09:01Z",
      "side": 1,
      "message": "I believe we still need to make a copy of the name into a null terminated string for the `const char*` in the `Uniform` constructor.\n\nI don\u0027t think we should look up the shader snippet here since I don\u0027t define the uniforms within the shader snippet to ensure we emit the uniforms along with the render step uniforms. So if we did that I would likely have to add an extra flag to `SnippetRequirementFlags` to ensure uniforms are not emitted for that snippet but IMO that complicates things for this usecase.\n\nBut also since we are only writing uniforms here I think we can leave the name here `nullptr` here since it is not used so I changed it to that.",
      "parentUuid": "d7bb6287_0c0cdbdc",
      "range": {
        "startLine": 183,
        "startChar": 0,
        "endLine": 183,
        "endChar": 52
      },
      "revId": "1461d8bd91e610425d8d6a6a50d4c797ddc21741",
