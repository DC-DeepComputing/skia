      "writtenOn": "2025-04-10T14:20:44Z",
      "side": 1,
      "message": "This is a no-op except for the bounds being calculated more correctly (not outsetting for subpixel smoothing when it isn\u0027t going to be applied) and for fake bold now being consistent.",
      "parentUuid": "691c6fe4_3e25bc17",
      "revId": "265db5d689bae9cf22c9c704b74e13b6060a19b5",
      "serverId": "5086850b-e599-37d2-8ec8-ff16aeccbf02"
    },
