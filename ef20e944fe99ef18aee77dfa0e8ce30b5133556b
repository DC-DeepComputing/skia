        "id": 18914
      },
      "writtenOn": "2022-08-17T19:32:12Z",
      "side": 1,
      "message": "Just for my understanding, how is this currently handled for the Context?",
      "parentUuid": "1c5133f9_9c8a3c93",
      "range": {
        "startLine": 89,
        "startChar": 45,
        "endLine": 89,
