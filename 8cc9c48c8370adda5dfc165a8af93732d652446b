        "patchSetId": 27
      },
      "lineNbr": 16,
      "author": {
        "id": 5230
      },
      "writtenOn": "2024-02-23T14:51:23Z",
      "side": 1,
      "message": "For the time being I\u0027ve wrapped them in a KnownRuntimeEffects namespace since I\u0027m unsure how this will ultimately be exposed to clients. It may be that we end up with a static method on SkRuntimeEffect for clients to fill in their known runtime effects or, since it will probably only be for first party clients, we might end up buring it in a client-specific directory.",
      "parentUuid": "defa9050_7385f717",
      "range": {
        "startLine": 16,
        "startChar": 0,
        "endLine": 16,
        "endChar": 47
      },
      "revId": "8cc9c48c8370adda5dfc165a8af93732d652446b",
