      "writtenOn": "2023-06-01T16:00:49Z",
      "side": 1,
      "message": "Is there ever a case where we want this to silently continue without asserting?\nWe don\u0027t need to change it here (preexisting behavior) but this seems like a spooky thing to allow.",
      "range": {
        "startLine": 132,
        "startChar": 33,
        "endLine": 132,
        "endChar": 63
      },
      "revId": "905fd65f76609c1b22b8b4a9112d1bf894eb13c1",
