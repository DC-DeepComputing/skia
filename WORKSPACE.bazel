    # Validated locally using sha256sum
    sha256 = "9b969322012d796dc23dda27a35866034fa67d8fb67e0e2c45c913c3d43219dd",
    strip_prefix = "musl-1.2.2/",
    url = "https://musl.libc.org/releases/musl-1.2.2.tar.gz",
)

