    cross_libc_url = "http://ftp.debian.org/debian/pool/main/c/cross-toolchain-base/libc6-dev-amd64-cross_2.31-9cross4_all.deb",
    # From https://packages.debian.org/bullseye/amd64/linux-libc-dev/download
    libc_prefix = "./usr/",
    libc_sha256 = "d06467c00744c15de80bef617c2496d9ebe225a14c8006bee824a36786d54226",
    libc_url = "http://ftp.debian.org/debian/pool/main/l/linux/linux-libc-dev_5.10.70-1_amd64.deb",
)
