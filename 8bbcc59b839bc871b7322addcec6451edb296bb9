      "writtenOn": "2025-04-30T14:30:22Z",
      "side": 1,
      "message": "This function shouldn\u0027t be modifying `info`\u0027s offset. We can have it return an `std::optional\u003cuint32_t\u003e`, empty being the buffer would overflow and non-empty being the calculated offset.  That way the `prepareBindBuffer` can reuse the calculated value but we don\u0027t have any side effects when a public caller queries this function.",
      "range": {
        "startLine": 507,
        "startChar": 4,
        "endLine": 507,
        "endChar": 20
      },
      "revId": "8bbcc59b839bc871b7322addcec6451edb296bb9",
