load("//bazel:macros.bzl", "exports_files_legacy", "skia_cc_binary_with_flags", "skia_cc_library")

licenses(["notice"])

exports_files_legacy()

skia_cc_binary_with_flags(
    name = "skslc",
    srcs = [
        "Main.cpp",
    ],
    set_flags = {
        "enable_sksl": ["True"],
        "enable_skslc": ["True"],
    },
    deps = [
        ":process_worklist",
        "//:skia_internal",
        "@spirv_tools",
    ],
)

skia_cc_library(
    name = "process_worklist",
    srcs = ["ProcessWorklist.cpp"],
    hdrs = ["ProcessWorklist.h"],
    visibility = ["//tools/sksl-minify:__pkg__"],
    deps = ["//:skia_internal"],
)

BASE_DATA = [
    ":sksl_compile_tests.sh",
    ":skslc",
    "//gn:compile_sksl_tests",
]

# https://bazel.build/reference/be/shell#sh_binary
sh_binary(
    name = "compile_glsl_tests",
    srcs = [":sksl_compile_tests.sh"],
    args = [
        # comments are the variable names in compile_sksl_tests.py
        "--glsl",  # lang
        "--settings",  # settings
        "resources",  # input_root_dir
        "tests",  # output_root_dir
        "bazel-bin/tools/skslc/glsl_tests.txt",  # input_file
    ],
    data = BASE_DATA + [
        ":glsl_tests.txt",
        ":glsl_tests_with_settings",
    ],
    # We can compile remotely, but because we are running the executable to modify files in
    # the source tree, running it in a remote, sandboxed would have no effect locally.
    tags = ["no-remote"],
)

sh_binary(
    name = "compile_glsl_nosettings_tests",
    srcs = [":sksl_compile_tests.sh"],
    args = [
        # comments are the variable names in compile_sksl_tests.py
        "--glsl",  # lang
        "--nosettings",  # settings
        "resources",  # input_root_dir
        "tests",  # output_root_dir
        "bazel-bin/tools/skslc/glsl_nosettings_tests.txt",  # input_file
    ],
    data = BASE_DATA + [
        ":glsl_nosettings_tests.txt",
        "//resources/sksl:sksl_glsl_settings_tests_sources",
    ],
    tags = ["no-remote"],
)

sh_binary(
    name = "compile_metal_tests",
    srcs = [":sksl_compile_tests.sh"],
    args = [
        # comments are the variable names in compile_sksl_tests.py
        "--metal",  # lang
        "--settings",  # settings
        "resources",  # input_root_dir
        "tests",  # output_root_dir
        "bazel-bin/tools/skslc/metal_tests.txt",  # input_file
    ],
    data = BASE_DATA + [
        ":metal_tests.txt",
        "//resources/sksl:sksl_metal_tests_sources",
    ],
    tags = ["no-remote"],
)

sh_binary(
    name = "compile_skvm_tests",
    srcs = [":sksl_compile_tests.sh"],
    args = [
        # comments are the variable names in compile_sksl_tests.py
        "--skvm",  # lang
        "--settings",  # settings
        "resources",  # input_root_dir
        "tests",  # output_root_dir
        "bazel-bin/tools/skslc/skvm_tests.txt",  # input_file
    ],
    data = BASE_DATA + [
        ":skvm_tests.txt",
        "//resources/sksl:sksl_skvm_tests_sources",
    ],
    tags = ["no-remote"],
)

_SKSL_COMPILE_TESTS = """
# Change into the Skia root directory
# https://bazel.build/docs/user-manual#running-executables
cd $$BUILD_WORKSPACE_DIRECTORY

# execpath returns the path to the given label relative to the Skia root.
# This will be something like:
#   bazel-out/k8-opt-exec-81C6BA4F/bin/tools/skslc/skslc
# https://bazel.build/reference/be/make-variables#predefined_label_variables
SKSL_COMPILE_EXE=$(execpath //tools/skslc:skslc)
COMPILE_TESTS_SCRIPT=$(execpath //gn:compile_sksl_tests)

# We then find the absolute path because this is easier to debug and more
# consistent if the script we are calling changes the working directory.
# Note the double dollar signs are because we are escaping the dollar sign
# operator from Bazel (because realpath is a Unix command we want to invoke).
SKSL_COMPILE_EXE=$$(realpath $$SKSL_COMPILE_EXE)
COMPILE_TESTS_SCRIPT=$$(realpath $$COMPILE_TESTS_SCRIPT)

# Uncomment below to see what this expands into
# set -x

$$COMPILE_TESTS_SCRIPT \
    $$SKSL_COMPILE_EXE \
    $$@
"""

genrule(
    name = "create_sksl_minify_srcs_script",
    outs = ["sksl_compile_tests.sh"],
    cmd = "echo '%s' > $@" % _SKSL_COMPILE_TESTS,
    exec_tools = [
        ":skslc",
        "//gn:compile_sksl_tests",
    ],
)

filegroup(
    name = "glsl_tests_with_settings",
    srcs = [
        "//resources/sksl:sksl_glsl_settings_tests_sources",
        "//resources/sksl:sksl_glsl_tests_sources",
    ],
)

genrule(
    name = "enumerate_glsl_tests_list",
    srcs = [":glsl_tests_with_settings"],
    outs = ["glsl_tests.txt"],
    # Put a space seperated list of file names into the one output
    # This is done because the list could be quite long and overflow
    # the command line length
    # https://bazel.build/reference/be/make-variables#predefined_genrule_variables
    cmd = "echo $(SRCS) > $@",
)

genrule(
    name = "enumerate_glsl_nosettings_tests_list",
    srcs = ["//resources/sksl:sksl_glsl_settings_tests_sources"],
    outs = ["glsl_nosettings_tests.txt"],
    cmd = "echo $(SRCS) > $@",
)

genrule(
    name = "enumerate_metal_tests_list",
    srcs = ["//resources/sksl:sksl_metal_tests_sources"],
    outs = ["metal_tests.txt"],
    cmd = "echo $(SRCS) > $@",
)

genrule(
    name = "enumerate_skvm_tests_list",
    srcs = ["//resources/sksl:sksl_skvm_tests_sources"],
    outs = ["skvm_tests.txt"],
    cmd = "echo $(SRCS) > $@",
)
