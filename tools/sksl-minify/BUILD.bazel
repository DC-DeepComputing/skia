load("//bazel:macros.bzl", "exports_files_legacy")
load("//bazel:cc_binary_with_flags.bzl", "cc_binary_with_flags")

licenses(["notice"])

exports_files_legacy()

sh_binary(
    name = "run",
    srcs = [":sksl_minify.sh"],
    data = [
        ":sksl_minify",
        ":sksl_minify.sh",
    ],
)

cc_binary_with_flags(
    name = "sksl_minify",
    srcs = ["SkSLMinify.cpp"],
    set_flags = {
        "enable_sksl": ["True"],
    },
    deps = [
        "//:skia_internal",
        "//tools:get_executable_path",
        "//tools/skslc:process_worklist",
    ],
)

_SCRIPT = """
# Change into the Skia root directory
# https://bazel.build/docs/user-manual#running-executables
cd $$BUILD_WORKSPACE_DIRECTORY

# execpath returns the path to the given label relative to the Skia root.
# This will be something like:
#   bazel-out/k8-opt-exec-81C6BA4F/bin/tools/sksl-minify/sksl_minify
# https://bazel.build/reference/be/make-variables#predefined_label_variables
SKSL_MINIFY_EXE=$(execpath //tools/sksl-minify:sksl_minify)
MINIFY_SCRIPT=$(execpath //gn:minify_sksl)
# We then find the absolute path because this is easier to debug and more
# consistent if the script we are calling changes the working directory.
SKSL_MINIFY_EXE=$$(realpath $$SKSL_MINIFY_EXE)
MINIFY_SCRIPT=$$(realpath $$MINIFY_SCRIPT)

# Uncomment below to see what this expands into
#set -x
$$MINIFY_SCRIPT $$SKSL_MINIFY_EXE src/sksl/generated src/sksl/*.sksl
"""

genrule(
    name = "gen_script",
    outs = ["sksl_minify.sh"],
    cmd = "echo '%s' > $@" % _SCRIPT,
    exec_tools = [
        ":sksl_minify",
        "//gn:minify_sksl",
    ],
)
