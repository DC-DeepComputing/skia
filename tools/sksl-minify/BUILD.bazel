load("//bazel:macros.bzl", "exports_files_legacy")
load("//bazel:cc_binary_with_flags.bzl", "cc_binary_with_flags")

licenses(["notice"])

exports_files_legacy()

sh_binary(
    name = "run",
    srcs = [":sksl_minify.sh"],
    data = [
        ":sksl_minify",
        ":sksl_minify.sh",
    ],
)

cc_binary_with_flags(
    name = "sksl_minify",
    srcs = ["SkSLMinify.cpp"],
    set_flags = {
        "enable_sksl": ["True"],
    },
    deps = [
        "//:skia_internal",
        "//tools:get_executable_path",
        "//tools/skslc:process_worklist",
    ],
)

_SCRIPT = """
# Path to the "sksl_minify" binary. Reminder that the executable has a _native_binary
# suffix because of the transition in cc_binary_with_flags.
SKSL_MINIFY="$$(realpath $(rootpath //tools/sksl-minify:sksl_minify))_native_binary"

# Change into the Skia root directory
# https://bazel.build/docs/user-manual#running-executables
cd $$BUILD_WORKSPACE_DIRECTORY

$$SKSL_MINIFY $$@
"""

genrule(
    name = "gen_script",
    outs = ["sksl_minify.sh"],
    cmd = "echo '%s' > $@" % _SCRIPT,
    exec_tools = [
        ":sksl_minify",
    ],
)
