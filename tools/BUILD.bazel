load("//bazel:macros.bzl", "cc_library", "exports_files_legacy", "py_binary")

licenses(["notice"])

exports_files_legacy()

py_binary(
    name = "embed_resources",
    srcs = ["embed_resources.py"],
    visibility = ["//:__subpackages__"],
)

