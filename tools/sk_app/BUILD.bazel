load("//bazel:skia_rules.bzl", "exports_files_legacy", "skia_cc_library")

package(
    default_applicable_licenses = ["//:license"],
)

licenses(["notice"])

exports_files_legacy()

skia_cc_library(
    name = "core",
    testonly = True,
    srcs = [
        "CommandSet.cpp",
        "Window.cpp",
    ],
    hdrs = [
        "Application.h",
        "CommandSet.h",
        "Window.h",
    ],
    #visibility = ["//:__subpackages__"],
    deps = [
        "//:core",
        "//src/gpu/ganesh:ganesh_TEST_UTIL",
        "//tools:tool_utils",
        "//tools/fonts:font_tool_utils",
        "//tools/skui",
        "//tools/timer",
        "//tools/window:core",
    ],
)

skia_cc_library(
    name = "sk_app_gl",
    testonly = True,
    srcs = select({
        "@platforms//os:linux": [
            "//tools/sk_app/unix:srcs",
        ],
    }),
    visibility = ["//tools:__subpackages__"],
    deps = [
        ":core",
        "//src/gpu/ganesh/gl:ganesh_gl_TEST_UTIL",
        "//tools/window:window_gl",
    ],
)
