load("//bazel:skia_rules.bzl", "skia_cc_library", "skia_objc_library")

package(
    default_applicable_licenses = ["//:license"],
)

licenses(["notice"])

skia_cc_library(
    name = "core",
    testonly = True,
    srcs = [
        "CommandSet.cpp",
        "Window.cpp",
    ],
    hdrs = [
        "Application.h",
        "CommandSet.h",
        "Window.h",
    ],
    #visibility = ["//:__subpackages__"],
    deps = [
        "//:core",
        "//src/gpu/ganesh:ganesh_TEST_UTIL",
        "//tools:tool_utils",
        "//tools/fonts:font_tool_utils",
        "//tools/skui",
        "//tools/timer",
        "//tools/window:core",
    ],
)

skia_cc_library(
    name = "sk_app_gl",
    testonly = True,
    visibility = ["//tools:__subpackages__"],
    deps = select({
        "@platforms//os:linux": [":sk_app_gl_unix"],
        "@platforms//os:macos": [":sk_app_gl_mac"],
    }),
)

skia_cc_library(
    name = "sk_app_gl_unix",
    testonly = True,
    srcs = ["//tools/sk_app/unix:srcs"],
    deps = [
        ":core",
        "//src/gpu/ganesh/gl:ganesh_gl_TEST_UTIL",
        "//tools/window:window_gl",
    ],
)

skia_objc_library(
    name = "sk_app_gl_mac",
    testonly = True,
    srcs = ["//tools/sk_app/mac:srcs"],
    sdk_frameworks = [
    ],
    deps = [
        ":core",
        "//src/gpu/ganesh/gl:ganesh_gl_TEST_UTIL",
        "//tools/window:window_gl",
    ],
)
