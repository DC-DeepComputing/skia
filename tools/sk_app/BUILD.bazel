skia_cc_library(
    name = "sk_app",
    testonly = True,
    visibility = ["//tools:__subpackages__"],
    deps = select({
        "@platforms//os:linux": [":sk_app_linux"],
        "@platforms//os:macos": [":sk_app_gl_mac"],
    }),
)

skia_cc_library(
    name = "sk_app_linux",
    testonly = True,
    srcs = [
        "CommandSet.cpp",
        "Window.cpp",
        "//tools/sk_app/unix:srcs",
    ],
    hdrs = [
        "Application.h",
        "CommandSet.h",
        "Window.h",
    ],
    deps = [
        "//tools/fonts:font_tool_utils",
        "//tools/skui",
        "//tools/timer",
        "//tools/window",
    ],
)

skia_objc_library(
    name = "sk_app_gl_mac",
    testonly = True,
    srcs = ["//tools/sk_app/mac:srcs"],
    sdk_frameworks = [
    ],
    deps = [
        "//src/gpu/ganesh/gl:ganesh_gl_TEST_UTIL",
        "//tools/window:window_gl",
    ],
)
