    hdrs = [
        "Application.h",
        "CommandSet.h",
        "Window.h",
    ],
    #visibility = ["//:__subpackages__"],
    deps = [
        "//:core",
        "//:ganesh_gl",
        "//tools:tool_utils",
        "//tools/skui",
        "//tools/timer",
        "//tools/fonts:font_tool_utils",
        "//tools/window:core",
    ]
)

skia_cc_library(
    name = "sk_app_gl",
    testonly = True,
    deps = [":core"],
    visibility = ["//tools:__subpackages__"],
)