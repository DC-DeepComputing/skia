load("//bazel:skia_rules.bzl", "select_multi", "skia_cc_library")

package(
    default_applicable_licenses = ["//:license"],
)

licenses(["notice"])

skia_cc_library(
    name = "legacy_window",
    testonly = True,
    srcs = [
        "RasterWindowContext.h",
        "WindowContext.cpp",
    ] + select_multi({
        "//src/gpu:gl_ganesh": [
            "GLWindowContext.cpp",
            "GLWindowContext.h",
        ],
        "//src/gpu:vulkan_ganesh": [
            "VulkanWindowContext.h",
            "VulkanWindowContext.cpp",
        ],
    }) + select({
        "@platforms//os:android": ["//tools/window/android:srcs"],
        "//conditions:default": [],
    }) + select({
        "@platforms//os:linux": ["//tools/window/unix:srcs"],
        "//conditions:default": [],
        # TODO(kjlubick) add Windows/Mac support
    }),
    hdrs = [
        "DisplayParams.h",
        "WindowContext.h",
    ],
    visibility = ["//:__subpackages__"],
    deps = [
        "//:skia_internal",
    ] + select({
        "//src/gpu:vulkan_ganesh": ["//tools/gpu/vk:testutils"],
        "//conditions:default": [],
    }) + select({
        "@platforms//os:android": ["//tools/window/android:deps"],
        "//conditions:default": [],
    }),
)

skia_cc_library(
    name = "core",
    testonly = True,
    srcs = [
        "RasterWindowContext.h",
        "WindowContext.cpp",
    ],
    hdrs = [
        "DisplayParams.h",
        "WindowContext.h",
    ],
    visibility = ["//:__subpackages__"],
    deps = [
        "//:core",
        "//src/gpu/ganesh:ganesh_TEST_UTIL",
    ],
)

skia_cc_library(
    name = "window_gl",
    testonly = True,
    srcs = [
        "GLWindowContext.cpp",
        "RasterWindowContext.h",
        "WindowContext.cpp",
    ] + select({
        "@platforms//os:linux": [
            "//tools/window/unix:gl_srcs",
            "//tools/window/unix:unix_srcs",
        ],
    }),
    hdrs = [
        "DisplayParams.h",
        "GLWindowContext.h",
        "WindowContext.h",
    ],
    visibility = ["//:__subpackages__"],
    deps = [
        "//:core",
        "//src/gpu/ganesh/gl:ganesh_gl_TEST_UTIL",
        "//tools/fonts:font_tool_utils",
    ] + select({
        "@platforms//os:linux": ["//src/gpu/ganesh/gl/glx:glx_factory_TEST_UTIL"],
        # TODO(kjlubick): Add Android support.
        # "@platforms//os:android": ["//tools/window/android:deps"],
        "//conditions:default": [],
    }),
)
