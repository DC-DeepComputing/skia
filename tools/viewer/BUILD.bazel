load("//bazel:skia_rules.bzl", "exports_files_legacy")
load("//bazel:cc_binary_with_flags.bzl", "cc_binary_with_flags")

licenses(["notice"])

exports_files_legacy()

cc_binary_with_flags(
    name = "viewer",
    testonly = True,
    srcs = [
        "AnimTimer.h",
        "GMSlide.cpp",
        "GMSlide.h",
        "ImGuiLayer.cpp",
        "ImGuiLayer.h",
        "Slide.h",
        "StatsLayer.cpp",
        "StatsLayer.h",
        "TouchGesture.cpp",
        "TouchGesture.h",
        "Viewer.cpp",
        "Viewer.h",
        "//gm:gm_subset",
        "//tools/flags",
        "//tools/flags:common_flags",
    ],
    set_flags = {
        # Use the GL backend with the normal GL standard (as opposed to WebGL or GLES)
        "gpu_backend": [
            "gl_backend",
        ],
        "with_gl_standard": [
            "gl_standard",
        ],
        "fontmgr_factory": [
            "custom_directory_fontmgr_factory",
        ],
        "enable_gpu_test_utils": ["True"],
    },
    deps = [
        "//:skia_internal",
        "//gm",
        "//tools:registry",
        "//tools:runtime_blend_utils",
        "//tools:tool_utils",
        "//tools/gpu:utils",
        "//tools/sk_app",
        "//tools/skui",
        "//tools/trace:event_tracing",
        "@imgui",
    ],
)
