load("//bazel:skia_rules.bzl", "skia_cc_library")

package(
    default_applicable_licenses = ["//:license"],
)

licenses(["notice"])

skia_cc_library(
    name = "test_support",
    testonly = True,
    srcs = ["TestSupport.cpp"],
    hdrs = ["TestSupport.h"],
    defines = select({
        "//src/partition_alloc:enabled_true": ["SKIA_ENABLE_PARTITION_ALLOC"],
        "//conditions:default": [],
    }),
    visibility = [
        "//bench:__pkg__",
        "//dm:__pkg__",
        "//tools/testrunners/common:__pkg__",
    ],
    deps = select({
        "//src/partition_alloc:enabled_true": [
            "//:core",
            "@partition_alloc",
        ],
        "//conditions:default": [],
    }),
)
