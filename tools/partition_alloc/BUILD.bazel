load("//bazel:skia_rules.bzl", "skia_cc_library")

package(
    default_applicable_licenses = ["//:license"],
)

licenses(["notice"])

skia_cc_library(
    name = "test_support",
    testonly = True,
    srcs = ["TestSupport.cpp"],
    hdrs = ["TestSupport.h"],
    defines = select({
        "//bazel/common_config_settings:skia_use_partition_alloc_true": ["SKIA_ENABLE_PARTITION_ALLOC"],
        "//conditions:default": [],
    }),
    visibility = ["//dm:__pkg__"],
    deps = select({
        "//bazel/common_config_settings:skia_use_partition_alloc_true": ["//src/partition_alloc"],
        "//conditions:default": [],
    }),
)
