import("//src/partition_alloc/partition_alloc.gni")

config("skia_root_includes") {
  include_dirs = [ "../../" ]
}

source_set("test_support") {
  public = [ "test_support.h" ]
  sources = [ "test_support.cpp" ]
  configs += [ ":skia_root_includes" ]

  if (skia_enable_partition_alloc) {
    deps = [ "//src/partition_alloc" ]
    defines = [ "SKIA_SUPPORT_PARTITION_ALLOC" ]
  }
}
