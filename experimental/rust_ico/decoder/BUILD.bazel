load(
    "//bazel:skia_rules.bzl",
    "skia_cc_library",
    "skia_filegroup",
)

skia_filegroup(
    name = "hdrs",
    srcs = [
        "SkIcoRustDecoder.h",
    ],
)

skia_filegroup(
    name = "srcs",
    srcs = [
        "SkIcoRustDecoder.cpp",
    ],
)

# C++ wrapper library for Rust ICO decoder
# Integrates Rust-based PNG and BMP decoders with Skia's codec system
skia_cc_library(
    name = "decoder",
    srcs = [":srcs"],
    hdrs = [":hdrs"],
    defines = ["SK_CODEC_DECODES_ICO_WITH_RUST"],  # Feature flag for Rust decoder
    features = ["layering_check"],
    visibility = ["//:__pkg__"],
    deps = [
        "//:core",
        "//experimental/rust_ico/decoder/impl:skicorustcodec",
        "//experimental/rust_ico/ffi:cxx_bridge",
        "//experimental/rust_ico/ffi:ffi_rs",
        "//modules/skcms",
        "//src/base",
        "//src/codec:codec_support_priv",
        "//src/core:core_priv",
        "@crates//:cxx_cc",  # CXX runtime for C++
    ],
)
