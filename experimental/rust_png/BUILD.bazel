load(
    "//bazel:skia_rules.bzl",
    "skia_cc_library",
    "skia_filegroup",
)

skia_filegroup(
    name = "hdrs",
    srcs = [
        "SkPngRustDecoder.h",
    ],
)

skia_filegroup(
    name = "srcs",
    srcs = [
        "SkPngRustDecoder.cpp",
        "impl/SkPngRustCodec.cpp",
        "impl/SkPngRustCodec.h",
    ],
)

skia_cc_library(
    name = "rust_png",
    srcs = [":srcs"],
    hdrs = [":hdrs"],
    deps = [
        "//experimental/rust_png/ffi:cxx_bridge",
        "//experimental/rust_png/ffi:ffi_cpp",
        "//src/codec:any_decoder",
        "//src/codec:png_decode",
        "@cxx//:core-lib",
    ],
)
