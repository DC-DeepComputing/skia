load(
    "//bazel:skia_rules.bzl",
    "skia_cc_library",
    "skia_filegroup",
)

# Public header for BMP decoder integration
skia_filegroup(
    name = "hdrs",
    srcs = [
        "SkBmpRustDecoder.h",
    ],
)

# Public header exported for GN build (matches rust_png pattern)
skia_filegroup(
    name = "rust_bmp_public_hdrs",
    srcs = [
        "SkBmpRustDecoder.h",
    ],
    visibility = ["//:__pkg__"],
)

# Implementation file for decoder registration
skia_filegroup(
    name = "srcs",
    srcs = [
        "SkBmpRustDecoder.cpp",
    ],
)

# Implementation files for decoder (matches rust_png pattern)
# Includes the codec implementation from impl/
skia_filegroup(
    name = "rust_bmp_srcs",
    srcs = [
        "SkBmpRustDecoder.cpp",
        "//experimental/rust_bmp/decoder/impl:skbmprustcodec_hdrs",
        "//experimental/rust_bmp/decoder/impl:skbmprustcodec_srcs",
    ],
    visibility = ["//:__pkg__"],
)

# C++ wrapper library for Rust BMP decoder
# Integrates image-rs based decoder with Skia's codec system
skia_cc_library(
    name = "decoder",
    srcs = [":srcs"],
    hdrs = [":hdrs"],
    defines = ["SK_CODEC_DECODES_BMP_WITH_RUST"],  # Feature flag for Rust decoder
    features = ["layering_check"],
    visibility = ["//visibility:public"],
    deps = [
        "//:bmp_decode_codec",  # Skia's BMP codec interface
        "//:core",
        "//experimental/rust_bmp/decoder/impl:skbmprustcodec",  # SkCodec implementation
        "//experimental/rust_bmp/ffi:cxx_bridge",  # Generated C++/Rust bridge
        "//experimental/rust_bmp/ffi:ffi_cpp",  # C++ FFI headers
        "//experimental/rust_bmp/ffi:ffi_rs",  # Rust FFI implementation
        "//modules/skcms",
        "//src/base",
        "//src/core:core_priv",
        "@crates//:cxx_cc",  # CXX runtime for C++
    ],
)
