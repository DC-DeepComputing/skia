load("@rules_rust//rust:defs.bzl", "rust_static_library", "rust_binary", "rust_test")
load("//bazel:rust_cxx_bridge.bzl", "rust_cxx_bridge")
load(
    "//bazel:skia_rules.bzl",
    "skia_cc_library",
    "skia_filegroup",
)

skia_filegroup(
    name = "rs_srcs",
    srcs = [
        "FFI.rs",
        "lib.rs",
        "bmp_constants.rs",
        "bmp_decoder.rs",
        "bmp_header.rs",
        "bmp_types.rs",
        "bmp_jpeg_decoder.rs",
        "bmp_png_decoder.rs",
        "bmp_icc.rs",
    ],
)

skia_filegroup(
    name = "cxx_bridge_srcs",
    srcs = ["FFI.rs"],
)

skia_cc_library(
    name = "ffi_cpp",
    hdrs = ["FFI.h"],
    features = ["layering_check"],
    visibility = [
        "//experimental/rust_bmp:__subpackages__",
    ],
    deps = [":cxx_bridge/include"],
)

rust_cxx_bridge(
    name = "cxx_bridge",
    src = "FFI.rs",
    visibility = [
        "//experimental/rust_bmp:__subpackages__",
    ],
    deps = [":ffi_cpp"],
)

rust_static_library(
    name = "ffi_rs",
    srcs = [":rs_srcs"],
    edition = "2021",
    visibility = [
        "//experimental/rust_bmp:__subpackages__",
    ],
    deps = [
        ":cxx_bridge",
        "@crates//:cxx",
        "@crates//:thiserror",
        "@crates//:zune-jpeg",
        "@crates//:png",
        "@crates//:moxcms",
    ],
)

rust_test(
    name = "test_bmp_ffi",
    timeout = "short",
    crate = ":ffi_rs",
)

# Binary for fuzzing Rust BMP decoder - tests full decode pipeline
rust_binary(
    name = "fuzz_rust_bmp",
    srcs = [
        ":rs_srcs",
        "fuzz_rust_bmp.rs",
    ],
    crate_root = "fuzz_rust_bmp.rs",
    edition = "2021",
    deps = [
        ":cxx_bridge",
        "@crates//:cxx",
        "@crates//:thiserror",
        "@crates//:zune-jpeg",
        "@crates//:png",
        "@crates//:moxcms",
    ],
)
