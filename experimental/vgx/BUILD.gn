import("../../gn/skia.gni")

if (skia_enable_vgx) {
  config("public_config") {
    defines = [ "SK_ENABLE_VGX" ]
  }

  skia_component("skvgx") {
    check_includes = false
    public_configs = [ ":public_config" ]
    public = [ "SkVGX.h" ]
    sources = [
      "SkVGX.cpp",
      "SkVGX.h",
    ]
    deps = [ "../..:skia" ]
  }
}
