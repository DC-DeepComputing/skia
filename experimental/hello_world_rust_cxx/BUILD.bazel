load("@rules_rust//rust:defs.bzl", "rust_binary")
load(":rust_bridge.bzl", "rust_cxx_bridge")

rust_binary(
    name = "hello_world",
    srcs = ["hello-world.rs"],
)

rust_cxx_bridge(
    name = "hype_bridge",
    src = "hype-bridge.rs",
)

cc_binary(
    name = "cpp_with_rust",
    srcs = ["main.cpp"],
    deps = [":hype_bridge"],
)
