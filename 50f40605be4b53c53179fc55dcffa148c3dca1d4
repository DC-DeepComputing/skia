      },
      "lineNbr": 1140,
      "author": {
        "id": 13824
      },
      "writtenOn": "2023-07-12T18:49:17Z",
      "side": 1,
      "message": "Ended up doing this with a big if-statement, renaming the isInverted bool to a multipurpose infiniteBounds bool.",
      "parentUuid": "eea0a7b2_346d77ec",
      "range": {
        "startLine": 1140,
        "startChar": 10,
        "endLine": 1140,
        "endChar": 24
      },
      "revId": "50f40605be4b53c53179fc55dcffa148c3dca1d4",
