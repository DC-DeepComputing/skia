      "writtenOn": "2026-09-29T20:26:40Z",
      "side": 1,
      "message": "Yes, the issue is %s, because Clang cannot statically prove at compile time that the pointer passed to %s points to a safely bounded, null-terminated buffer.",
      "parentUuid": "e497c294_6238c357",
      "range": {
        "startLine": 307,
        "startChar": 12,
        "endLine": 309,
        "endChar": 47
      },
      "revId": "d12456fa64a3099a840ffbf9ac34eb65b28cec94",
