load("//bazel:macros.bzl", "exports_files_legacy", "skia_cc_library")

licenses(["notice"])

exports_files_legacy()

# Exported to //modules/skcms/skcms.gni:skcms_public_headers.
filegroup(
    name = "public_hdrs",
    srcs = ["skcms.h"],
)

# Exported to //modules/skcms/skcms.gni:skcms_sources.
filegroup(
    name = "srcs",
    srcs = [
        "skcms.cc",
        "skcms_internal.h",
    ],
)

# Exported to //modules/skcms/skcms.gni:skcms_sources.
filegroup(
    name = "textual_hdrs",
    srcs = ["src/Transform_inl.h"],
)

skia_cc_library(
    name = "skcms",
    srcs = [":srcs"],
    hdrs = [":public_hdrs"],
    # The following comment will be replaced with G3-specific settings
    # SKCMS_REPLACE_IN_GOOGLE3_COMPATIBLE_WITH
    # This header does not compile on its own and is meant to be included from skcms.cc
    textual_hdrs = [":textual_hdrs"],
    visibility = ["//:__subpackages__"],
)
