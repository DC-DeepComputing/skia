import("../../third_party/third_party.gni")
import("skcms.gni")

third_party("skcms") {
  enabled = true
  cflags = []
  if (!is_win || is_clang) {
    cflags += [ "-std=c11" ]
  }

  public = skcms_public_headers
  public_include_dirs = [ "." ]
  sources = skcms_sources
}
