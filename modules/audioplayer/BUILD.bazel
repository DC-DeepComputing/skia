load("//bazel:skia_rules.bzl", "skia_cc_library", "skia_objc_library")

package(
    default_applicable_licenses = ["//:license"],
)

licenses(["notice"])

skia_cc_library(
    name = "audioplayer",
    hdrs = ["SkAudioPlayer.h"],
    features = ["layering_check"],
    visibility = ["//tools/viewer:__pkg__"],
    deps = ["//:core"] +
           select({
               # TODO(fmalita): support platform-specific audio libs
               "@platforms//os:macos": [":audioplayer_mac"],
               "//conditions:default": [":audioplayer_none"],
           }),
)

skia_objc_library(
    name = "audioplayer_mac",
    srcs = [
        "SkAudioPlayer.cpp",
        "SkAudioPlayer_mac.mm",
    ],
    hdrs = ["SkAudioPlayer.h"],
    features = ["layering_check"],
    sdk_frameworks = [
        "AVFoundation",
    ],
    deps = ["//:core"],
)

skia_cc_library(
    name = "audioplayer_none",
    srcs = [
        "SkAudioPlayer.cpp",
        "SkAudioPlayer_none.cpp",
    ],
    hdrs = ["SkAudioPlayer.h"],
    features = ["layering_check"],
    deps = ["//:core"],
)
