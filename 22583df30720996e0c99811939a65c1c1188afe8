      "writtenOn": "2023-11-03T14:15:47Z",
      "side": 1,
      "message": "Just curious, but why is the dumping of memory stats available on release builds, but for tracing and logging we have build flags to enable?",
      "range": {
        "startLine": 151,
        "startChar": 0,
        "endLine": 155,
        "endChar": 72
      },
      "revId": "22583df30720996e0c99811939a65c1c1188afe8",
