      "writtenOn": "2023-04-26T14:09:10Z",
      "side": 1,
      "message": "Does vello want colors premultiplied or unpremultiplied? Does it handle colorspace conversions?",
      "range": {
        "startLine": 37,
        "startChar": 25,
        "endLine": 37,
        "endChar": 34
      },
      "revId": "2e0e2dfb5f7c573b2a124d59df5d472f0aed2208",
