      "author": {
        "id": 8341
      },
      "writtenOn": "2025-03-28T17:58:12Z",
      "side": 1,
      "message": "If we route the entry to just `drawImageRect`, it should be done before we call `SkModifyPaintAndDstForDrawImageRect` since it\u0027ll handle that already.",
      "range": {
        "startLine": 2743,
        "startChar": 16,
        "endLine": 2744,
        "endChar": 74
      },
      "revId": "503b56a495d1becb5a2ac2562534a879289605c8",
