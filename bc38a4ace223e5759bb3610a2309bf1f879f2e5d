        "id": 8341
      },
      "writtenOn": "2023-01-05T14:40:18Z",
      "side": 1,
      "message": "I\u0027m assuming `set\u003d1` is a magic number linking to how the rest of graphite configures its bind groups, and that this works because no other resource will try to bind to set\u003d1, right?",
      "range": {
        "startLine": 232,
        "startChar": 71,
        "endLine": 232,
        "endChar": 76
      },
      "revId": "bc38a4ace223e5759bb3610a2309bf1f879f2e5d",
      "serverId": "5086850b-e599-37d2-8ec8-ff16aeccbf02"
    },
    {
      "unresolved": false,
      "key": {
        "uuid": "d140371b_053c0c77",
