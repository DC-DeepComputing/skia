      "writtenOn": "2023-01-05T14:40:18Z",
      "side": 1,
      "message": "Is this just because Dawn is the only one that has separate texture and sampler bindings for now? Seems like the layout type should come from bindingReqs too?",
      "range": {
        "startLine": 225,
        "startChar": 38,
        "endLine": 225,
        "endChar": 42
      },
      "revId": "bc38a4ace223e5759bb3610a2309bf1f879f2e5d",
