        "id": 5085
      },
      "writtenOn": "2022-06-16T19:25:51Z",
      "side": 1,
      "message": "Do you think it\u0027d be good to make the context/surface distinction clearer to the user in the API by not having this method at all?",
      "range": {
        "startLine": 225,
        "startChar": 0,
        "endLine": 227,
        "endChar": 65
      },
      "revId": "e32b06a12ee23fed4598c5701b724d1699c66d6f",
      "serverId": "5086850b-e599-37d2-8ec8-ff16aeccbf02"
    },
    {
