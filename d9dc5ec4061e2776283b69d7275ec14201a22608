      "lineNbr": 127,
      "author": {
        "id": 3948337
      },
      "writtenOn": "2026-03-16T15:10:00Z",
      "side": 1,
      "message": "It compiles because I explicitly wrote out *all* the template arguments when calling the function. `kIsDepthOnly` get\u0027s removed in a downstream patch!",
      "parentUuid": "5307ddee_96159130",
      "range": {
        "startLine": 127,
        "startChar": 56,
        "endLine": 127,
        "endChar": 73
      },
      "revId": "d9dc5ec4061e2776283b69d7275ec14201a22608",
