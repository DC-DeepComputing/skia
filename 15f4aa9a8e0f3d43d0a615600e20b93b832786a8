        "id": 5085
      },
      "writtenOn": "2022-08-17T13:39:10Z",
      "side": 1,
      "message": "Does this mean we\u0027re going to disable on all WebGL?",
      "range": {
        "startLine": 4224,
        "startChar": 46,
        "endLine": 4224,
        "endChar": 52
      },
      "revId": "15f4aa9a8e0f3d43d0a615600e20b93b832786a8",
