      },
      "writtenOn": "2022-08-16T21:49:50Z",
      "side": 1,
      "message": "This should work, but the resulting string is empty. The enum values match the spec, so I\u0027m not sure what\u0027s going on.",
      "range": {
        "startLine": 705,
        "startChar": 4,
        "endLine": 705,
        "endChar": 76
      },
      "revId": "15f4aa9a8e0f3d43d0a615600e20b93b832786a8",
