      },
      "lineNbr": 43,
      "author": {
        "id": 5642
      },
      "writtenOn": "2023-05-25T14:56:34Z",
      "side": 1,
      "message": "naming nit: these are already methods of SlotManager, the \"Slot\" bit seems just a bit redundant.  Up to you.",
      "range": {
        "startLine": 36,
        "startChar": 0,
        "endLine": 43,
        "endChar": 41
      },
      "revId": "ed4e6716f0d9cee82755af00bc80919f5929b043",
