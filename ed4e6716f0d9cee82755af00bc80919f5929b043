      },
      "lineNbr": 12,
      "author": {
        "id": 11964
      },
      "writtenOn": "2023-05-25T20:52:19Z",
      "side": 1,
      "message": "I don\u0027t think so? We want sk_sp\u0027s to them, so we need its inheritance information which IIUC cannot be forward declared.",
      "parentUuid": "06a4f484_cb18a15d",
      "revId": "ed4e6716f0d9cee82755af00bc80919f5929b043",
      "serverId": "5086850b-e599-37d2-8ec8-ff16aeccbf02"
    },
