        "id": 5395
      },
      "writtenOn": "2023-07-19T13:29:02Z",
      "side": 1,
      "message": "If this fails on the CI, how are we going to have any insight as to what went wrong?\n\nThere are some tests which can output base64 encoded PNGs to help spot the differences. Maybe we should do that.",
      "range": {
        "startLine": 200,
        "startChar": 36,
        "endLine": 200,
        "endChar": 41
      },
      "revId": "01d0cc99361bcb0bb6ce877c4f360e5ead1ed051",
