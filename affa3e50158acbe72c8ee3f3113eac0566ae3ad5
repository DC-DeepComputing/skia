      },
      "writtenOn": "2026-03-18T15:03:00Z",
      "side": 1,
      "message": "Do we need this in a cpp? Or should we be using something like SK_ALWAYS_INLINE?",
      "range": {
        "startLine": 686,
        "startChar": 0,
        "endLine": 686,
        "endChar": 6
      },
      "revId": "affa3e50158acbe72c8ee3f3113eac0566ae3ad5",
