    },
    {
      "unresolved": true,
      "key": {
        "uuid": "aa1e6199_b5c8de06",
        "filename": "src/gpu/graphite/BufferManager.h",
        "patchSetId": 10
      },
      "lineNbr": 298,
      "author": {
        "id": 8341
      },
      "writtenOn": "2025-03-31T20:41:27Z",
      "side": 1,
      "message": "I think we want to keep this constant and have it represent the minimum required alignment for anything going into the buffer. The per-reservation alignment must always be adjusted to the LCM of the reservation\u0027s alignment and the minimum required alignment. \n\nIt\u0027s trivial to allow functions to rely on the default required alignment (e.g. requiredAlignment \u003d 0 in DrawBufferManager::prepareBindBuffer).",
      "range": {
        "startLine": 296,
        "startChar": 0,
        "endLine": 298,
        "endChar": 28
      },
      "revId": "2ae2f31a81736b63f72824162e6a096381b4ad92",
