      "writtenOn": "2025-03-31T20:41:27Z",
      "side": 1,
      "message": "This was missing before you modified it, but we should account for the rare-ish case where an explicitly provided alignment isn\u0027t a multiple of the BufferInfo\u0027s required/starting alignment.\n\nChecking for alignment is easy since the starting alignment will always be a power-of-2, and then only if it\u0027s not aligned we can calculate the LCM.",
      "range": {
        "startLine": 521,
        "startChar": 0,
        "endLine": 521,
        "endChar": 89
      },
      "revId": "2ae2f31a81736b63f72824162e6a096381b4ad92",
      "serverId": "5086850b-e599-37d2-8ec8-ff16aeccbf02"
    },
    {
