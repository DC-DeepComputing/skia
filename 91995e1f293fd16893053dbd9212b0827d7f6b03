      "writtenOn": "2023-04-05T14:43:50Z",
      "side": 1,
      "message": "Do we want to preserve that though? This means that our SKPs could have JPEG data in them, but when we go to deserialize them, the default behavior is to treat it as PNG. If we always encode to PNG, then we know we\u0027ll be able to deserialize them.",
      "parentUuid": "0d3ca814_35d63f8b",
      "revId": "91995e1f293fd16893053dbd9212b0827d7f6b03",
      "serverId": "5086850b-e599-37d2-8ec8-ff16aeccbf02"
    },
