      "writtenOn": "2022-10-28T14:58:20Z",
      "side": 1,
      "message": "I tried something similar to that. See patch 19 in SkTArray SkAllocationBuilder. I templatized on sizeof(T) instead of T to get better sharing, but this added 4K to the binary. Which because of padding usually means more than 4K.",
      "parentUuid": "a9eb1756_042ad665",
      "range": {
        "startLine": 506,
        "startChar": 0,
        "endLine": 510,
        "endChar": 26
      },
      "revId": "51833ff0e4d0b72c0f4c4bd2288e86b154893fd6",
      "serverId": "5086850b-e599-37d2-8ec8-ff16aeccbf02"
    },
