    {
      "unresolved": false,
      "key": {
        "uuid": "4492dbe2_475699a0",
        "filename": "src/base/SkQuads.h",
        "patchSetId": 7
      },
      "lineNbr": 72,
      "author": {
        "id": 5210
      },
      "writtenOn": "2023-06-07T19:39:03Z",
      "side": 1,
      "message": "All the constants from the quadratic formula are remove so, its AC instead of 4AC and /A instead of /2A. Removing the constants allows you to calculate the round off error of the multiplies more easily using FMA. So, the rounding error for A * C is let AC \u003d A * C, FMA(A, C, AC). This is the key to calculating the discriminant with only two bits of rounding error.",
      "parentUuid": "ff599210_5e67d969",
      "range": {
        "startLine": 72,
        "startChar": 10,
        "endLine": 72,
        "endChar": 29
      },
      "revId": "cae1d78e7ff824322b9ea7e2b2a8396500f7700f",
      "serverId": "5086850b-e599-37d2-8ec8-ff16aeccbf02"
    },
