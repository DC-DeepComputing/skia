      "writtenOn": "2021-10-18T19:47:27Z",
      "side": 1,
      "message": "Since you are using floats, this does not produce a single instruction on Intel, but uses compare, AND and OR. If you want the single instruction you need to encode it specially, and ensure that there are no NaN\u0027s because on intel max(x, NaN) is x.",
      "range": {
        "startLine": 127,
        "startChar": 28,
        "endLine": 127,
        "endChar": 31
      },
      "revId": "1d524b1bfd2e4e6a529456f400ab1128b45543d9",
      "serverId": "5086850b-e599-37d2-8ec8-ff16aeccbf02"
    },
