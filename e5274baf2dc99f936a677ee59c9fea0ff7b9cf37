      },
      "lineNbr": 550,
      "author": {
        "id": 5036
      },
      "writtenOn": "2022-08-24T13:33:55Z",
      "side": 1,
      "message": "This definitely seems like the wrong place to be tracking such a thing. It should definitely be the calling code that is trying to read the buffer that should be handling the synchronization.",
      "parentUuid": "c017f2a0_4d310b88",
      "range": {
        "startLine": 545,
        "startChar": 0,
        "endLine": 550,
        "endChar": 6
      },
      "revId": "e5274baf2dc99f936a677ee59c9fea0ff7b9cf37",
