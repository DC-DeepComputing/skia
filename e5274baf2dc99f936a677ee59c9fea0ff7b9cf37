        "id": 11059
      },
      "writtenOn": "2022-08-24T15:31:06Z",
      "side": 1,
      "message": "iPhone \u003d\u003d MTLResourceStorageModeShared\nIntel Mac \u003d\u003d MTLResourceStorageModeManaged\n\nWhere does M1 Mac fall? It is a Mac with an Apple chip.",
      "parentUuid": "1edc7ae6_b468f441",
      "range": {
        "startLine": 545,
        "startChar": 7,
        "endLine": 545,
        "endChar": 23
