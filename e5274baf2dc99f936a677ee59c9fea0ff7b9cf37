        "id": 18529
      },
      "writtenOn": "2022-08-24T00:12:30Z",
      "side": 1,
      "message": "Let me know what you think about this approach and whether this is the right layer to special case this. This might make sense to generalize such that it works for any pipeline that uses a buffer with `BufferType::kXferGpuToCpu`",
      "range": {
        "startLine": 545,
        "startChar": 0,
        "endLine": 550,
        "endChar": 6
      },
      "revId": "e5274baf2dc99f936a677ee59c9fea0ff7b9cf37",
