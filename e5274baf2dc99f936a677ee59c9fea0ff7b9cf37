      },
      "writtenOn": "2022-08-24T18:00:02Z",
      "side": 1,
      "message": "I\u0027m fine with removing the #if altogether as well and letting the isFoo() accessors do it.",
      "parentUuid": "d2fe1758_5fd93d71",
      "range": {
        "startLine": 545,
        "startChar": 7,
        "endLine": 545,
        "endChar": 23
