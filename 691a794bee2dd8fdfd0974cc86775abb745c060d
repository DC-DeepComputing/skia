      "writtenOn": "2021-10-29T16:37:41Z",
      "side": 1,
      "message": "|tan_x| may be infinite. I see other users of SkDegreesToRadians are checking SkScalarIsFinite(x) after. What happens when it does?",
      "range": {
        "startLine": 703,
        "startChar": 19,
        "endLine": 703,
