load("//bazel:macros.bzl", "cc_library", "exports_files_legacy")

licenses(["notice"])

exports_files_legacy()

filegroup(
    name = "srcs",
    srcs = [
        "//src/android:srcs",
        "//src/codec:srcs",
        "//src/core:srcs",
        "//src/effects:srcs_nogazelle",
        "//src/image:srcs_nogazelle",
        "//src/images:srcs_nogazelle",
        "//src/opts:srcs_nogazelle",
        "//src/pathops:srcs_nogazelle",
        "//src/ports:srcs",
        "//src/sfnt:srcs_nogazelle",
        "//src/shaders:srcs_nogazelle",
        "//src/utils:srcs_nogazelle",
    ] + select({
        "//bazel/common_config_settings:has_gpu_backend": [
            "//src/gpu:srcs_nogazelle",
            "//src/text/gpu:srcs_nogazelle",
        ],
        "//conditions:default": [],
    }) + select({
        "//bazel/common_config_settings:needs_sksl": ["//src/sksl:srcs"],
        "//conditions:default": [],
    }),
    visibility = ["//:__subpackages__"],
)

cc_library(
    name = "deps",
    visibility = ["//:__subpackages__"],
    deps = [
        "//src/codec:deps",
        "//src/images:deps_nogazelle",
        "//src/ports:deps",
        "//third_party/skcms:skcms",
    ] + select({
        "//bazel/common_config_settings:has_gpu_backend": ["//src/gpu/ganesh:deps_nogazelle"],
        "//conditions:default": [],
    }) + select({
        "//bazel/common_config_settings:needs_sksl": ["//src/sksl:deps"],
        "//conditions:default": [],
    }),
)
