load(
    "//bazel:skia_rules.bzl",
    "exports_files_legacy",
    "skia_cc_library",
    "skia_filegroup",
)
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_static_library")
load("//bazel:rust_cxx_bridge.bzl", "rust_cxx_bridge")

licenses(["notice"])

exports_files_legacy()

rust_cxx_bridge(
    name = "fontations_ffi",
    src = "src/ffi.rs",
    visibility = ["//src/ports:__pkg__"],
    deps = [":path_bridge_include"],
)

rust_static_library(
    name = "fontations_lib",
    srcs = ["src/ffi.rs"],
    visibility = ["//src/ports:__pkg__"],
    deps = [
        ":fontations_ffi",
        "@cxx",
        "@fontations//:font-types",
        "@fontations//:read-fonts",
        "@fontations//:skrifa",
    ],
)

cc_library(
    name = "path_bridge_include",
    hdrs = [
        "src/skpath_bridge.h",
        "//include/core:core_hdrs",
    ],
    visibility = ["//src/ports:__pkg__"],
)

skia_filegroup(
    name = "fontations_c_side",
    srcs = [
        "src/skpath_bridge.cpp",
    ],
    visibility = ["//src/ports:__pkg__"],
)

rust_binary(
    name = "fontations_deps_test",
    srcs = ["src/main.rs"],
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        "@fontations//:font-types",
        "@fontations//:read-fonts",
        "@fontations//:skrifa",
    ],
)
