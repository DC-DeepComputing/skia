// defines built-in interfaces supported by SkSL fragment shaders

// See "enum SpvBuiltIn_" in ./spirv.h
layout(builtin=15) in float4 sk_FragCoord;
layout(builtin=17) in bool sk_Clockwise;  // Similar to gl_FrontFacing, but defined in device space.
layout(builtin=20) in uint sk_SampleMaskIn;
layout(builtin=10020) out uint sk_SampleMask;

layout(location=0,index=0,builtin=10001) out half4 sk_FragColor;
layout(builtin=10008) in half4 sk_LastFragColor;
layout(location=0,index=1,builtin=10012) out half4 sk_SecondaryFragColor;

// subgroups
// TODO(thomsmit): Add vec types
$pure $genHType subgroupAdd($genHType value);
$pure $genType subgroupAdd($genType value);
$pure $genUType subgroupAdd($genUType value);
$pure $genIType subgroupAdd($genIType value);

bool      subgroupAll(bool value);
bool      subgroupAny(bool value);
uint4     subgroupBallot(bool value);

$pure $genHType subgroupBroadcast($genHType value, uint id);
$pure $genType subgroupBroadcast($genType value, uint id);
$pure $genUType subgroupBroadcast($genUType value, uint id);
$pure $genIType subgroupBroadcast($genIType value, uint id);

$pure $genHType subgroupExclusiveSum($genHType value);
$pure $genType subgroupExclusiveSum($genType value);
$pure $genUType subgroupExclusiveSum($genUType value);
$pure $genIType subgroupExclusiveSum($genIType value);

$pure $genHType subgroupInclusiveSum($genHType value);
$pure $genType subgroupInclusiveSum($genType value);
$pure $genUType subgroupInclusiveSum($genUType value);
$pure $genIType subgroupInclusiveSum($genIType value);

$pure $genHType subgroupMax($genHType value);
$pure $genType subgroupMax($genType value);
$pure $genUType subgroupMax($genUType value);
$pure $genIType subgroupMax($genIType value);

$pure $genHType subgroupMin($genHType value);
$pure $genType subgroupMin($genType value);
$pure $genUType subgroupMin($genUType value);
$pure $genIType subgroupMin($genIType value);

$pure $genHType subgroupShuffle($genHType value, uint id);
$pure $genType subgroupShuffle($genType value, uint id);
$pure $genUType subgroupShuffle($genUType value, uint id);
$pure $genIType subgroupShuffle($genIType value, uint id);
