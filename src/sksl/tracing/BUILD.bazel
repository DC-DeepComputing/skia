load("//bazel:skia_rules.bzl", "exports_files_legacy", "skia_cc_library", "skia_filegroup")

licenses(["notice"])

exports_files_legacy()

skia_filegroup(
    name = "tracing_srcs",
    srcs = [
        "SkSLDebugTraceImpl.cpp",
        "SkSLDebugTracePlayer.cpp",
        "SkTracedShader.cpp",
    ],
)

# skslc does not need SkRuntimeEffects::MakeTraced, which requires many other deps
skia_filegroup(
    name = "tracing_skslc_srcs",
    srcs = [
        "SkSLDebugTraceImpl.cpp",
        "SkSLDebugTracePlayer.cpp",
    ],
)

skia_filegroup(
    name = "tracing_hdrs",
    srcs = [
        "SkSLDebugTraceImpl.h",
        "SkSLDebugTracePlayer.h",
    ],
)

skia_filegroup(
    name = "srcs",
    srcs = [
        "SkSLDebugTracePriv.cpp",
        "SkSLTraceHook.cpp",
    ] + select({
        "//src/sksl:enable_sksl_tracing_true": [
            ":tracing_srcs",
        ],
        "//src/sksl:enable_sksl_tracing_false": [],
    }),
    visibility = ["//src/sksl:__pkg__"],
)

skia_filegroup(
    name = "skopts_hdrs",
    srcs = [
        "SkSLTraceHook.h",
    ],
    visibility = [
        "//src:__pkg__",
        "//src/opts:__pkg__",
    ],
)

skia_filegroup(
    name = "private_hdrs",
    srcs = [
        "SkSLDebugTracePriv.h",
        ":skopts_hdrs",
    ] + select({
        "//src/sksl:enable_sksl_tracing_true": [
            ":tracing_hdrs",
        ],
        "//src/sksl:enable_sksl_tracing_false": [],
    }),
    visibility = ["//src/sksl:__pkg__"],
)

skia_filegroup(
    name = "core_priv_hdrs",
    srcs = [
        "SkSLDebugTracePriv.h",
        "SkSLTraceHook.h",
    ],
    visibility = ["//src/sksl:__pkg__"],
)

skia_filegroup(
    name = "opts_srcs",
    srcs = [
        "SkSLTraceHook.h",
    ],
    visibility = ["//src/opts:__pkg__"],
)

skia_filegroup(
    name = "core_srcs",
    srcs = [
        "SkSLDebugTracePriv.cpp",
        "SkSLTraceHook.cpp",
    ],
    visibility = ["//src/sksl:__pkg__"],
)

skia_cc_library(
    name = "tracing",
    srcs = [
        "SkSLDebugTraceImpl.cpp",
        "SkSLDebugTracePlayer.cpp",
        "SkTracedShader.cpp",
    ],
    hdrs = [
        "SkSLDebugTraceImpl.h",
        "SkSLDebugTracePlayer.h",
        "//include/utils:tracing_hdrs",
    ],
    defines = ["SKSL_ENABLE_TRACING"],
    visibility = ["//modules/canvaskit:__pkg__"],
    deps = [
        "//src/base",
        "//src/core",
        "//src/core:core_priv",
        "//src/utils:json",
    ],
)
