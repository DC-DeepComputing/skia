load("//bazel:macros.bzl", "enforce_iwyu_on_package", "exports_files_legacy")

licenses(["notice"])

exports_files_legacy()

enforce_iwyu_on_package()

filegroup(
    name = "core_srcs_nogazelle",
    srcs = [
        "SkVMDebugTrace.cpp",
        "SkVMDebugTrace.h",
    ],
)

filegroup(
    name = "player_srcs_nogazelle",
    srcs = [
        "SkVMDebugTracePlayer.cpp",
        "SkVMDebugTracePlayer.h",
    ],
)

filegroup(
    name = "srcs_nogazelle",
    srcs = [
        ":core_srcs_nogazelle",
    ] + select({
        "//bazel/common_config_settings:enable_sksl_tracing_true": [":player_srcs_nogazelle"],
        "//bazel/common_config_settings:enable_sksl_tracing_false": [],
    }),
    visibility = ["//src/sksl:__pkg__"],
)
