// defines built-in interfaces supported by SkSL compute shaders

layout(builtin=28) in uint3 sk_ThreadPosition;

sk_has_side_effects half4 read(readonly texture2D t, uint2 pos);
sk_has_side_effects void write(writeonly texture2D t, uint2 pos, half4 color);
uint width(readonly writeonly texture2D t);
uint height(readonly writeonly texture2D t);

sk_has_side_effects void threadgroupBarrier();
