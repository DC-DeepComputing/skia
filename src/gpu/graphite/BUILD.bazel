    name = "core",
    files = CORE_FILES,
)

skia_filegroup(
    name = "srcs",
    srcs = [
        ":core_srcs",
        "//src/gpu/graphite/compute:srcs",
        "//src/gpu/graphite/geom:srcs",
        "//src/gpu/graphite/render:srcs",
        "//src/gpu/graphite/text:srcs",
    ] + select_multi({
        "//src/gpu:dawn_graphite": [],
        "//src/gpu:vulkan_graphite": [],
    }),
    visibility = ["//src/gpu:__pkg__"],
)

skia_filegroup(
    name = "objc_srcs",
    srcs = [
        "//src/gpu/graphite/mtl:srcs",
    ],
    visibility = ["//src/gpu:__pkg__"],
)

skia_filegroup(
    name = "private_hdrs",
    srcs = [
        ":core_hdrs",
        "//src/gpu/graphite/compute:private_hdrs",
        "//src/gpu/graphite/geom:private_hdrs",
        "//src/gpu/graphite/render:private_hdrs",
        "//src/gpu/graphite/text:private_hdrs",
    ] + select_multi(
        {
            "//src/gpu:dawn_graphite": [],
            "//src/gpu:metal_graphite": ["//src/gpu/mtl:private_hdrs"],
            "//src/gpu:vulkan_graphite": [],
        },
    ),
    visibility = ["//src/gpu:__pkg__"],
)

skia_cc_deps(
    name = "deps",
    visibility = ["//src:__pkg__"],
    deps = [
        "//src/gpu/graphite/compute:deps",
    ],
)
