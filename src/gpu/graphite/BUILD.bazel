load("//bazel:macros.bzl", "exports_files_legacy", "select_multi", "skia_cc_deps", "split_srcs_and_hdrs")

licenses(["notice"])

exports_files_legacy()

CORE_FILES = []

split_srcs_and_hdrs(
    name = "core",
    files = CORE_FILES,
)

filegroup(
    name = "srcs",
    srcs = [
        ":core_srcs",
    ] + select_multi(
        {
            "//src/gpu:vulkan_backend": ["//src/gpu/graphite/vk:srcs"],
            "//src/gpu:metal_backend": ["//src/gpu/graphite/mtl:srcs"],
        },
    ),
    visibility = ["//src/gpu:__pkg__"],
)

filegroup(
    name = "private_hdrs",
    srcs = [
        ":core_hdrs",
    ] + select_multi(
        {
            "//src/gpu:vulkan_backend": ["//src/gpu/graphite/vk:private_hdrs"],
            "//src/gpu:metal_backend": ["//src/gpu/graphite/mtl:private_hdrs"],
        },
    ),
    visibility = ["//src/gpu:__pkg__"],
)
