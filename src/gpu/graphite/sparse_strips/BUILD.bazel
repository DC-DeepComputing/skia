    "GpuAlphaAtlasManager.cpp",
    "GpuAlphaAtlasManager.h",
    "MSAA_LUT.h",
    "MakeStrips.h",
    "Polyline.h",
    "PreMergeTile.h",
    "SparseStripsConfig.h",
    "SparseStripsCoverageStep.cpp",
    "SparseStripsCoverageStep.h",
    "SparseStripsTypes.h",
    "StripGenerator.cpp",
    "StripGenerator.h",
    "StripProcessorGpu.h",
    "StripProcessorScalar.h",
    "StripProcessorSimd.h",
    "Tiler.h",
    "WindingHistogram.h",
]

split_srcs_and_hdrs(
    name = "sparse_strips",
    files = SPARSE_STRIPS_FILES,
