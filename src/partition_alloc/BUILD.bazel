# Provide the MiraclePtr "raw_ptr" definitions. Depending on the configuration,
# this is either:
# 1. Delegated to the `partition_alloc` library.
# 2. Provided by Skia a simple "no-op" pointer wrapper (in construction).

# TODO(b/352223023): Implement proper conditional logic for skia_partition_alloc_dir
# For now, we assume skia_partition_alloc_dir is not defined.

load(
    "//bazel:skia_rules.bzl",
    "skia_cc_library",
)

package(
    default_applicable_licenses = ["//:license"],
)

licenses(["notice"])

skia_cc_library(
    name = "partition_alloc",
    # When skia_partition_alloc_dir is not defined, this is an empty group in BUILD.gn.
    # In Bazel, an empty cc_library serves a similar purpose if nothing depends on its
    # implementation.
)

skia_cc_library(
    name = "raw_ptr",
    hdrs = [
        "partition_alloc/pointers/raw_ptr.h",
        "partition_alloc/pointers/raw_ptr_exclusion.h",
        "partition_alloc/pointers/raw_ref.h",
    ],
    includes = ["."],
    visibility = ["//visibility:public"],
)
