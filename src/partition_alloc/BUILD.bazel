# Provide the MiraclePtr "raw_ptr" definitions. Depending on the configuration,
# this is either:
# 1. Delegated to the `partition_alloc` library.
# 2. Provided by Skia a simple "no-op" pointer wrapper (in construction).

load("//bazel:skia_rules.bzl", "skia_cc_library")

package(default_applicable_licenses = ["//:license"])

licenses(["notice"])

# A simple no-op implementation of raw_ptr/raw_ref.
# This is used when PartitionAlloc is not enabled.
skia_cc_library(
    name = "raw_ptr_noop",
    hdrs = [
        "partition_alloc/pointers/raw_ptr.h",
        "partition_alloc/pointers/raw_ptr_exclusion.h",
        "partition_alloc/pointers/raw_ref.h",
    ],
    includes = ["."],
    visibility = ["//visibility:public"],
)

# The PartitionAlloc-based implementation of raw_ptr/raw_ref.
# This is used when PartitionAlloc is enabled.
skia_cc_library(
    name = "raw_ptr_partition_alloc",
    hdrs = [
        "@partition_alloc//:src/partition_alloc/pointers/raw_ptr.h",
        "@partition_alloc//:src/partition_alloc/pointers/raw_ptr_exclusion.h",
        "@partition_alloc//:src/partition_alloc/pointers/raw_ref.h",
    ],
    visibility = ["//visibility:public"],
    deps = ["@partition_alloc//:raw_ptr"],
)

alias(
    name = "raw_ptr",
    actual = select({
        "//bazel/common_config_settings:skia_use_partition_alloc_true": ":raw_ptr_partition_alloc",
        "//conditions:default": ":raw_ptr_noop",
    }),
    visibility = ["//visibility:public"],
)
