# Provide the MiraclePtr "raw_ptr" definitions. Depending on the configuration,
# this is either:
# 1. Delegated to the `partition_alloc` library.
# 2. Provided by Skia a simple "no-op" pointer wrapper (in construction).

load(
    "//bazel:skia_rules.bzl",
    "skia_cc_library",
)

package(
    default_applicable_licenses = ["//:license"],
)

licenses(["notice"])

skia_cc_library(
    name = "partition_alloc",
    visibility = [
        "//src:__subpackages__",
        "//tools:__subpackages__",
    ],
    deps = select({
        "//bazel/common_config_settings:skia_use_partition_alloc_true": ["@partition_alloc"],
        "//conditions:default": [],
    }),
)

skia_cc_library(
    name = "raw_ptr",
    hdrs = select({
        "//bazel/common_config_settings:skia_use_partition_alloc_true": [
            "@partition_alloc//:src/partition_alloc/pointers/raw_ptr.h",
            "@partition_alloc//:src/partition_alloc/pointers/raw_ptr_exclusion.h",
            "@partition_alloc//:src/partition_alloc/pointers/raw_ref.h",
        ],
        "//conditions:default": [
            "partition_alloc/pointers/raw_ptr.h",
            "partition_alloc/pointers/raw_ptr_exclusion.h",
            "partition_alloc/pointers/raw_ref.h",
        ],
    }),
    includes = select({
        "//bazel/common_config_settings:skia_use_partition_alloc_true": [],
        "//conditions:default": ["."],
    }),
    visibility = ["//visibility:public"],
    deps = select({
        "//bazel/common_config_settings:skia_use_partition_alloc_true": ["@partition_alloc//:raw_ptr"],
        "//conditions:default": [],
    }),
)
