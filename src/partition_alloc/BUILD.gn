# Provide the MiraclePtr "raw_ptr" definitions. Depending on the configuration,
# this is either:
# - Delegated to the `partition_alloc` library.
# - Provided by Skia a simple "no-op" pointer wrapper (in construction).

# ┌──────────────────────────────────────────────────┐
# │Question for reviewers: Contrary to Bazel, I see  │
# │most of the GN config are defined from the        │
# │top-level //BUILD.gn. Why? Should I move this file│
# │to the root of the Skia repository? What's your   │
# │recommendations?                                  │
# └──────────────────────────────────────────────────┘

is_clang_or_gcc = is_clang || !is_win

skia_enable_partition_alloc =
    # PartitionAlloc doesn't support MSVC. Only Clang and GCC are supported.
    is_clang_or_gcc &&
    # PartitionAlloc is enabled only when running Skia Standalone tests, or when
    # embedded within Chromium.
    defined(skia_partition_alloc_dir) &&
    # When using ./gn/gn_to_bp.py, the current_cpu is 'none'. This is not
    # supported by PartitionAlloc.
    current_cpu != "none"

# This define the same targets as in partition_alloc. See Chromium file:
# - base/allocator/partition_allocator/BUILD.gn
# - base/allocator/partition_allocator/src/partition_alloc/BUILD.gn
if (skia_enable_partition_alloc) {
  group("partition_alloc") {
    public_deps = [ "${skia_partition_alloc_dir}:partition_alloc" ]
  }
} else {
  # TODO(351867706): Provide the equivalent of partition_alloc:raw_ptr when
  # partition_alloc is missing.
}

config("skia_root_includes") {
  include_dirs = [ "../../" ]
}

source_set("test_support") {
  public = [ "test_support.h" ]
  sources = [ "test_support.cpp" ]
  configs += [ ":skia_root_includes" ]

  if (skia_enable_partition_alloc) {
    deps = [ ":partition_alloc" ]
    defines = [ "SKIA_SUPPORT_PARTITION_ALLOC" ]
  }
}
