# Provide the MiraclePtr "raw_ptr" definitions. Depending on the configuration,
# this is either:
# 1. Delegated to the `partition_alloc` library.
# 2. Provided by Skia a simple "no-op" pointer wrapper (in construction).

if (defined(skia_partition_alloc_dir)) {
  import("${skia_partition_alloc_dir}/partition_alloc.gni")
} else {
  enable_backup_ref_ptr_support = false
}

group("partition_alloc") {
  if (enable_backup_ref_ptr_support) {
    public_deps = [ "${skia_partition_alloc_dir}:partition_alloc" ]
  } else {
    # TODO(351867706): Provide the equivalent of partition_alloc:raw_ptr, but
    # provided by Skia directly when partition_alloc is missing.
  }
}
