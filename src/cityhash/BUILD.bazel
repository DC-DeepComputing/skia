load("//bazel:skia_rules.bzl", "exports_files_legacy", "skia_filegroup", "split_srcs_and_hdrs")

licenses(["notice"])

exports_files_legacy()

CITYHASH_FILES = [
    "city.cc",
    "city.h",
]

split_srcs_and_hdrs(
    name = "cityhash",
    files = CITYHASH_FILES,
)

skia_filegroup(
    name = "srcs",
    srcs = [
        ":cityhash_srcs",
    ],
    visibility = ["//src:__pkg__"],
)

skia_filegroup(
    name = "private_hdrs",
    srcs = [
        ":cityhash_hdrs",
    ],
    visibility = ["//src:__pkg__"],
)
