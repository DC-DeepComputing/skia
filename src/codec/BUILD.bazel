package(default_visibility = ["//visibility:private"])

load("//bazel:macros.bzl", "select_multi")

filegroup(
    name = "core-srcs",
    srcs = [
        "SkCodec.cpp",
        "SkCodecImageGenerator.cpp",
        "SkCodecImageGenerator.h",
        "SkCodecPriv.h",
        "SkColorTable.cpp",
        "SkColorTable.h",
        "SkFrameHolder.h",
        "SkMaskSwizzler.cpp",
        "SkMaskSwizzler.h",
        "SkMasks.cpp",
        "SkMasks.h",
        "SkSampler.cpp",
        "SkSampler.h",
        "SkSwizzler.cpp",
        "SkSwizzler.h",
    ],
)

filegroup(
    name = "bmp-srcs",
    srcs = [
        "SkBmpBaseCodec.cpp",
        "SkBmpBaseCodec.h",
        "SkBmpCodec.cpp",
        "SkBmpCodec.h",
        "SkBmpMaskCodec.cpp",
        "SkBmpMaskCodec.h",
        "SkBmpRLECodec.cpp",
        "SkBmpRLECodec.h",
        "SkBmpStandardCodec.cpp",
        "SkBmpStandardCodec.h",
        "SkWbmpCodec.cpp",
        "SkWbmpCodec.h",
    ],
)

filegroup(
    name = "png-srcs",
    srcs = [
        "SkEncodedInfo.cpp",
        "SkIcoCodec.cpp",
        "SkIcoCodec.h",
        "SkPngCodec.cpp",
        "SkPngCodec.h",
        "SkPngPriv.h",
    ],
)

filegroup(
    name = "jpeg-srcs",
    srcs = [
        "SkEncodedInfo.cpp",
        "SkJpegCodec.cpp",
        "SkJpegCodec.h",
        "SkJpegDecoderMgr.cpp",
        "SkJpegDecoderMgr.h",
        "SkJpegPriv.h",
        "SkJpegUtility.cpp",
        "SkJpegUtility.h",
        "SkParseEncodedOrigin.cpp",
        "SkParseEncodedOrigin.h",
    ],
)

filegroup(
    name = "webp-srcs",
    srcs = [
        "SkEncodedInfo.cpp",
        "SkParseEncodedOrigin.cpp",
        "SkParseEncodedOrigin.h",
        "SkScalingCodec.h",
        "SkWebpCodec.cpp",
        "SkWebpCodec.h",
    ],
)

filegroup(
    name = "gif-wuffs-srcs",
    srcs = [
        "SkScalingCodec.h",
        "SkWuffsCodec.cpp",
        "SkWuffsCodec.h",
    ],
)

filegroup(
    name = "srcs",
    srcs = [
        ":bmp-srcs",
        ":core-srcs",
    ] + select_multi(
        {
            "//bazel/common_config_settings:png_codec": [":png-srcs"],
            "//bazel/common_config_settings:jpeg_codec": [":jpeg-srcs"],
            "//bazel/common_config_settings:webp_codec": [":webp-srcs"],
            "//bazel/common_config_settings:gif_codec_wuffs": [":gif-wuffs-srcs"],
        },
        default = [],
    ),
    visibility = ["//:__subpackages__"],
)
