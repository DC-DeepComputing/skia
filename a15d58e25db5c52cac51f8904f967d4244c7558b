      },
      "writtenOn": "2022-11-11T20:36:26Z",
      "side": 1,
      "message": "Michael confirmed that depth/stencil attachments should be discardable, I will follow up with a smaller CL for that.",
      "parentUuid": "299c8390_e8ed9f73",
      "range": {
        "startLine": 174,
        "startChar": 28,
        "endLine": 174,
