package(default_visibility = ["//:__subpackages__"])

cc_test(
    name = "bazel_test",
    size = "small",
    srcs = [
        "//experimental/bazel_test:srcs",
        "//include/config:hdrs",
        "//include/core:hdrs",
        "//src/ports:skdebug",
    ],
    deps = [
        "//third_party:libpng",
        "//third_party:musl_compat",
    ],
)

CORE_SRCS = [
    "//include/private:hdrs",
    "//include/third_party:skcms-hdrs",
    "//include/third_party:vulkan-hdrs",
    "//src/core:hdrs",
    "//src/core:srcs",
    "//src/image:hdrs",
    "//src/image:srcs",
    "//src:codec-hdrs",
    "//src:codec-srcs",
    "//src:effects-hdrs",
    "//src:effects-srcs",
    "//src:images-hdrs",
    "//src:images-srcs",
    "//src:opts-hdrs",
    "//src:pathops-hdrs",
    "//src:pathops-srcs",
    "//src:sfnt-hdrs",
    "//src:sfnt-srcs",
    "//src:shaders-hdrs",
    "//src:shaders-srcs",
    "//src:utils-hdrs",
    "//src:utils-srcs",
    "//third_party:skcms",
] + select({
    "//bazel/common_config_settings:webgl_gpu": [
        "//src:gpu-hdrs",
        "//src:gpu-srcs",
        "//src:gpu-webgl",
        "//include/gpu:metal-hdrs",
        "//include/gpu:vulkan-hdrs",
    ],
    "//bazel/common_config_settings:no_gpu": [
    ],
})
# TODO(kjlubick) sksl

CORE_HDRS = [
    "//include/codec:hdrs",
    "//include/config:hdrs",
    "//include/core:hdrs",
    "//include/effects:hdrs",
    "//include/encode:hdrs",
    "//include/pathops:hdrs",
    "//include/ports:hdrs",
    "//include/utils:base-hdrs",
] + select({
    "//bazel/common_config_settings:webgl_gpu": [
        "//include/gpu:gl-hdrs",
        "//include/gpu:base-hdrs",  # TODO(kjlubick) remove these dependencies
        "//include/gpu:mock-hdrs",  # TODO(kjlubick) remove these dependencies
    ],
    "//bazel/common_config_settings:no_gpu": [
    ],
})
# TODO(kjlubick) sksl
#     "//include/sksl:hdrs",

# Some of these are documented in SkUserConfig.h
CORE_DEFINES = select({
    "//bazel/common_config_settings:debug_build": [
        "SK_DEBUG",
    ],
    "//bazel/common_config_settings:release_build": [
        "SK_RELEASE",
    ],
    "//conditions:default": [
        "SK_RELEASE",
    ],
}) + select({
    "//bazel/common_config_settings:webgl_gpu": [
        "SK_GL",
        "SK_USE_WEBGL",
        "SK_SUPPORT_GPU=1",
    ],
    "//bazel/common_config_settings:no_gpu": [
        "SK_SUPPORT_GPU=0",
    ],
})

cc_library(
    name = "skia-core",
    srcs = CORE_SRCS,
    hdrs = CORE_HDRS,
    local_defines = CORE_DEFINES,
    textual_hdrs = ["//src:sksl-txts"],
    deps = ["//third_party:libjpeg-turbo"],
)

cc_library(
    name = "hash_and_encode",
    srcs = [
        "//tools:hash_and_encode",
        "//tools:hdrs",
    ],
    copts = [
        "-Ithird_party/externals/libpng/",
        "-Ithird_party/libpng/",
    ],
    deps = [
        ":skia-core",
        "//third_party:libpng",
    ],
)

cc_library(
    name = "gms",
    srcs = [
        "//gm:gms",
        "//gm:srcs",
        "//tools:hdrs",
        "//tools:srcs",
    ],
    hdrs = [
        "//gm:hdrs",
    ],
    textual_hdrs = ["//tools:txts"],
    deps = [":skia-core"],
)

cc_library(
    name = "tests",
    srcs = [
        "//include/gpu:mock-hdrs",
        "//src:gpu-hdrs",
        "//tests:srcs",
        "//tools:hdrs",
        "//tools:srcs",
    ],
    hdrs = [
        "//tests:hdrs",
    ],
    local_defines = [
        "GR_TEST_UTILS",
    ],
    textual_hdrs = ["//tools:txts"],
    deps = [":skia-core"],
)
