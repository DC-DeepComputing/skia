      "lineNbr": 160,
      "author": {
        "id": 8956
      },
      "writtenOn": "2021-08-31T19:10:39Z",
      "side": 1,
      "message": "You are right, it does not add much value to the public API. It\u0027s rather an illustration of how to use SkText plus it\u0027s good for testing.\nI am using it in my Editor. \nI cannot think of a way to move it outside because I like to keep WrappableText::prepareToDraw.",
      "parentUuid": "ed9e87d7_4a6055ef",
      "range": {
        "startLine": 136,
        "startChar": 0,
        "endLine": 160,
        "endChar": 2
      },
