        "id": 8956
      },
      "writtenOn": "2021-08-31T19:10:39Z",
      "side": 1,
      "message": "Let\u0027s remember this idea. Once it working we can add the interface your suggesting, compare and select the one that is better (requires less writing from a user, I suppose).",
      "parentUuid": "caeb75f4_b3bb108c",
      "range": {
        "startLine": 123,
        "startChar": 0,
        "endLine": 124,
        "endChar": 84
      },
      "revId": "eeaa2bd00f154943479bc8297a55fe7b710c2852",
