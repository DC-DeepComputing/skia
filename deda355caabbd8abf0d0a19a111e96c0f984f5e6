      "writtenOn": "2024-10-31T05:45:53Z",
      "side": 1,
      "message": "You\u0027re right. It\u0027s unnecessary here!",
      "parentUuid": "32cbc85c_23c7249e",
      "range": {
        "startLine": 280,
        "startChar": 0,
        "endLine": 282,
        "endChar": 22
      },
      "revId": "deda355caabbd8abf0d0a19a111e96c0f984f5e6",
