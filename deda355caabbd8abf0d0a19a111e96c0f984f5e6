      "writtenOn": "2024-10-30T13:38:50Z",
      "side": 1,
      "message": "According to the webgpu spec, I think this is only an issue if we were dealing with mapped buffers. The queue WriteBuffer() only requires that the buffer be available (not mapped and not destroyed), so I think we can just drop all the `fCurrentCommandBuffer` tracking.",
      "range": {
        "startLine": 280,
        "startChar": 0,
        "endLine": 282,
        "endChar": 22
      },
      "revId": "deda355caabbd8abf0d0a19a111e96c0f984f5e6",
