        "id": 18529
      },
      "writtenOn": "2024-03-20T00:46:28Z",
      "side": 1,
      "message": "OK, I have a temporary solution that assumes the buffer type is always a storage buffer (which is currently the case anyway). I\u0027ll upload this shortly.",
      "parentUuid": "76cc9065_9c2030ac",
      "range": {
        "startLine": 74,
        "startChar": 0,
        "endLine": 74,
        "endChar": 23
      },
