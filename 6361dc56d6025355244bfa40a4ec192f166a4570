    },
    {
      "unresolved": true,
      "key": {
        "uuid": "6bc8dac6_fa67755d",
        "filename": "src/gpu/graphite/Device.cpp",
        "patchSetId": 6
      },
      "lineNbr": 1742,
      "author": {
        "id": 8341
      },
      "writtenOn": "2024-04-04T17:13:35Z",
      "side": 1,
      "message": "I\u0027d been imagining that these checks would be handled in SkCanvas, so that the device function can assume that there\u0027s no path effect (or it\u0027s ignored), it\u0027s a fill, and the sigma has been transformed by the device matrix. The long term plan will be that the actual SkMaskFilter implementations go away entirely, and if the Device cannot handle them analytically it will be converted to the image filter blur. Ganesh and graphite have the same analytic capabilities, but if the analytic blurs in `SkMask` for the raster backend are more expansive (i.e. handle more than normal blur styles), then we probably have to structure it like this where Device can reject the operation.",
      "range": {
        "startLine": 1725,
        "startChar": 4,
        "endLine": 1742,
        "endChar": 80
      },
      "revId": "6361dc56d6025355244bfa40a4ec192f166a4570",
