      "writtenOn": "2021-10-01T23:39:41Z",
      "side": 1,
      "message": "My $.02:\n\n\"uint16_t depth\" is more descriptive to me than a potentially mysterious \"ZValue\" type.",
      "range": {
        "startLine": 73,
        "startChar": 28,
        "endLine": 73,
        "endChar": 40
      },
      "revId": "56de3e15bb27e2162c46e69a5ca6330103c7a0a6",
