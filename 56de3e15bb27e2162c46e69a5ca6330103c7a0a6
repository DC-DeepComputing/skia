        "id": 5633
      },
      "writtenOn": "2021-10-01T23:39:41Z",
      "side": 1,
      "message": "With the inner trianglation algorithm, there will be a \"kFillInnerTris\" pass.",
      "range": {
        "startLine": 21,
        "startChar": 4,
        "endLine": 21,
        "endChar": 16
      },
      "revId": "56de3e15bb27e2162c46e69a5ca6330103c7a0a6",
