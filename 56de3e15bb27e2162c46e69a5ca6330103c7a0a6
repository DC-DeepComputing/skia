        "id": 5633
      },
      "writtenOn": "2021-10-01T23:39:41Z",
      "side": 1,
      "message": "Just so you are aware, there is a third algorithm for drawing paths via inner triangulation. This is the method we will need to use when the path is large and simple enough.",
      "range": {
        "startLine": 206,
        "startChar": 14,
        "endLine": 206,
        "endChar": 32
      },
      "revId": "56de3e15bb27e2162c46e69a5ca6330103c7a0a6",
