      "message": "sticking with uint16_t depth for now",
      "parentUuid": "d6c405d8_ba3dc6e5",
      "range": {
        "startLine": 73,
        "startChar": 28,
        "endLine": 73,
        "endChar": 40
      },
      "revId": "56de3e15bb27e2162c46e69a5ca6330103c7a0a6",
