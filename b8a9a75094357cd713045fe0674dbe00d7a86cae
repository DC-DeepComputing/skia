      "writtenOn": "2022-02-10T21:36:02Z",
      "side": 1,
      "message": "I don\u0027t think we need to limit ourselves to static snippets here. If we made it a set of function names, or a set of static-sksl\u0027s, we\u0027d only be adding the function definitions once as needed and we wouldn\u0027t have to add the SkBuiltInCodeId to the snippet entry.",
      "range": {
        "startLine": 72,
        "startChar": 0,
        "endLine": 72,
        "endChar": 40
      },
      "revId": "b8a9a75094357cd713045fe0674dbe00d7a86cae",
