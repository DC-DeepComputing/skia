    {
      "unresolved": true,
      "key": {
        "uuid": "1dd8890c_487a9e47",
        "filename": "src/core/SkShaderCodeDictionary.cpp",
        "patchSetId": 8
      },
      "lineNbr": 157,
      "author": {
        "id": 5230
      },
      "writtenOn": "2022-02-11T14:49:30Z",
      "side": 1,
      "message": "In the next CL I add a glue-generating helper for the compose/blend shader.\n\nI would imagine most of the snippets will be able to squeak by with the default but we would have a handful of special cases.\n\nI\u0027ve renamed this method: GenerateDefaultGlueCode.",
      "parentUuid": "db3ee267_9ad379f7",
      "range": {
        "startLine": 157,
        "startChar": 12,
        "endLine": 157,
        "endChar": 43
      },
      "revId": "b8a9a75094357cd713045fe0674dbe00d7a86cae",
