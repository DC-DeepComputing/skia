        "patchSetId": 13
      },
      "lineNbr": 1,
      "author": {
        "id": 5395
      },
      "writtenOn": "2023-04-05T18:46:50Z",
      "side": 1,
      "message": "bazel/external is home to all resources needed to build Skia for Skia developers and testing (i.e. we are our own consumer). If someone else uses Skia (and transitively, the rust deps), they would specify their own versions and rules, because Bazel WORKSPACE.bazel files are not used by dependents.",
      "parentUuid": "91a9b607_53a45103",
      "revId": "b3bb2bb58f9886cee8749ee6da56405381c61d45",
      "serverId": "5086850b-e599-37d2-8ec8-ff16aeccbf02"
