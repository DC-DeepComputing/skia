      "writtenOn": "2024-05-08T13:42:37Z",
      "side": 1,
      "message": "Is the dawn+metal backend going to stop advertising this feature? Right now this extension has priority in the RenderPassDesc configuration inside Graphite so we\u0027d still use that instead of managing the msaa attachments ourselves.",
      "range": {
        "startLine": 467,
        "startChar": 0,
        "endLine": 467,
        "endChar": 92
      },
      "revId": "401a04209bbdfe6bfc8a3fc9732b52ec7493303b",
