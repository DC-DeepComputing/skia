      "writtenOn": "2022-08-15T17:05:22Z",
      "side": 1,
      "message": "Is this the output we want? `int src[]` -\u003e `int src[1]`?",
      "range": {
        "startLine": 9,
        "startChar": 4,
        "endLine": 9,
        "endChar": 15
      },
      "revId": "51576e9e1205e2128b37999cff4e4695c4703f5e",
