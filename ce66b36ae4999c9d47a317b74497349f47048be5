      "writtenOn": "2024-12-02T21:48:13Z",
      "side": 1,
      "message": "Why does the encoder need decoder libraries?",
      "range": {
        "startLine": 150,
        "startChar": 21,
        "endLine": 150,
        "endChar": 32
      },
      "revId": "ce66b36ae4999c9d47a317b74497349f47048be5",
