load("//bazel:macros.bzl", "exports_files_legacy", "selects")

licenses(["notice"])

exports_files_legacy()

filegroup(
    name = "public_hdrs",
    srcs = [
        "SkCFObject.h",
        "SkFontMgr_android.h",
        "SkFontMgr_directory.h",
        "SkFontMgr_empty.h",
        "SkFontMgr_fontconfig.h",
        "SkFontMgr_fuchsia.h",
        "SkFontMgr_indirect.h",
        "SkFontMgr_mac_ct.h",
        "SkImageGeneratorCG.h",
        "SkImageGeneratorNDK.h",
        "SkImageGeneratorWIC.h",
        "SkRemotableFontMgr.h",
        "SkTypeface_mac.h",
        "SkTypeface_win.h",
    ] + select({
        ":uses_fontconfiginterface": [
            "SkFontConfigInterface.h",
            "SkFontMgr_FontConfigInterface.h",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//include:__pkg__"],
)

selects.config_setting_group(
    name = "uses_fontconfiginterface",
    match_any = [
        "//bazel/common_config_settings:fontconfiginterface_fontmgr",
        "//bazel/common_config_settings:fontconfiginterface_fontmgr_factory",
    ],
)
