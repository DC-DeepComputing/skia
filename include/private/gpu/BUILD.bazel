load("//bazel:skia_rules.bzl", "exports_files_legacy", "select_multi", "skia_filegroup")

licenses(["notice"])

exports_files_legacy()

skia_filegroup(
    name = "private_hdrs",
    srcs = select(
        {
            "//src/gpu:has_ganesh_backend": ["//include/private/gpu/ganesh:private_hdrs"],
            "//conditions:default": [],
        },
    ) + select_multi(
        {
            "//src/gpu:vulkan_ganesh": ["//include/private/gpu/vk:private_hdrs"],
            "//src/gpu:metal_graphite": ["//include/private/gpu/graphite:metal_hdrs"],
        },
    ),
    visibility = ["//include/private:__pkg__"],
)
