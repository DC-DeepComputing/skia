licenses(["notice"])

# aka exports_files_legacy()
exports_files(
    ["SkUserConfig.h"],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "debug_build",
    values = {"compilation_mode": "dbg"},
)

config_setting(
    name = "fast_build",
    values = {"compilation_mode": "fastbuild"},
)

config_setting(
    name = "release_build",
    values = {"compilation_mode": "opt"},
)

cc_library(
    name = "user_config",
    hdrs = [
        "SkUserConfig.h",
    ],
    defines = [
        "SK_USE_BAZEL_CONFIG_HEADER",
    ] + select({
        ":debug_build": ["SK_DEBUG"],
        ":fast_build": ["SK_DEBUG"],
        ":release_build": ["SK_RELEASE"],
    }),
    visibility = ["//visibility:public"],
)
