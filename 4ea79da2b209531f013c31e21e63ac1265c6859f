      "writtenOn": "2026-09-25T13:33:03Z",
      "side": 1,
      "message": "We could move this into the storagebuffer if case, and in the storagetexture case, just always set `fBoundStorageFallbackTexture` to `drawPass-\u003estorageFallbackTexture()-\u003etexture()` and `fBoundUniformbuffersDirty \u003d SkToBool(fBoundStorageFallbackTexture)`",
      "range": {
        "startLine": 674,
        "startChar": 0,
        "endLine": 674,
        "endChar": 43
      },
      "revId": "4ea79da2b209531f013c31e21e63ac1265c6859f",
