        "id": 8341
      },
      "writtenOn": "2025-01-10T18:08:22Z",
      "side": 1,
      "message": "I think it\u0027s okay to update this function\u0027s structure to match `sk_color_space_transform_premul` in a later CL to differentiate any performance changes. Unfortunately I don\u0027t think we can set it up as a composition very easily where we nest either a gamut+tf node or a passthrough node under the premul specialization because this specialization has to modify the color at the start and the end.",
      "range": {
        "startLine": 90,
        "startChar": 12,
        "endLine": 90,
        "endChar": 36
      },
      "revId": "68dd6943dfbe6d3304ccc35f113ae815f00d8967",
