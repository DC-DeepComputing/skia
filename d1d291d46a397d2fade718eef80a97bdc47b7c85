      "writtenOn": "2022-11-04T15:01:01Z",
      "side": 1,
      "message": "I don\u0027t want to change its behavior, no. I would be willing to swap out \"same path as the exe\" instead of \"current working directory,\" but adding a new command line argument makes the tool harder to use.",
      "parentUuid": "bb8b93fd_f7bad128",
      "range": {
        "startLine": 41,
        "startChar": 0,
        "endLine": 41,
        "endChar": 47
      },
