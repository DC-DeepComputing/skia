      },
      "writtenOn": "2026-06-18T17:29:31Z",
      "side": 1,
      "message": "Could shared ownership be acceptable?",
      "range": {
        "startLine": 32,
        "startChar": 22,
        "endLine": 32,
        "endChar": 46
      },
      "revId": "4dee2f1f31c1301ddaa817bb7501de14c0200ad2",
