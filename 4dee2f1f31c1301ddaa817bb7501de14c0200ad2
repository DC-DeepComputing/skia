      },
      "lineNbr": 32,
      "author": {
        "id": 8341
      },
      "writtenOn": "2026-06-23T15:54:20Z",
      "side": 1,
      "message": "It seems relatively harmless to allow shared ownership (if we took in an sk_sp\u003cLogHandler\u003e), but I think it also makes sense that a client\u0027s SkLogHandler subclass shares ownership with whatever internal log collection mechanism.",
      "parentUuid": "5bc00a28_7f352718",
      "range": {
        "startLine": 32,
        "startChar": 22,
        "endLine": 32,
        "endChar": 46
      },
      "revId": "4dee2f1f31c1301ddaa817bb7501de14c0200ad2",
      "serverId": "5086850b-e599-37d2-8ec8-ff16aeccbf02"
    },
