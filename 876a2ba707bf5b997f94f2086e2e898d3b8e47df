        "id": 5065
      },
      "writtenOn": "2023-09-20T15:46:11Z",
      "side": 1,
      "message": "It may be fine to not invalidate it, but I defer to Greg on that. However if we do decide to invalidate it, by convention we should be passing it as BackendTexture*, not BackendTexture\u0026, so it\u0027s clear that the method changes its value.",
      "parentUuid": "0dcd2bf5_eeadc451",
      "range": {
        "startLine": 154,
        "startChar": 4,
        "endLine": 154,
        "endChar": 18
      },
      "revId": "876a2ba707bf5b997f94f2086e2e898d3b8e47df",
