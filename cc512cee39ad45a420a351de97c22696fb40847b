      "writtenOn": "2025-08-27T13:52:45Z",
      "side": 1,
      "message": "Is SkRect::BoundsOrEmpty() safer here?",
      "range": {
        "startLine": 198,
        "startChar": 16,
        "endLine": 198,
        "endChar": 43
      },
      "revId": "cc512cee39ad45a420a351de97c22696fb40847b",
