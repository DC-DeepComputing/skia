      "writtenOn": "2024-05-28T14:17:08Z",
      "side": 1,
      "message": "This pixel snapping logic was needed for correctness when viewing a periodic tiled image that fills a larger area. The tile mode is applied at the image boundary so if that doesn\u0027t align with the original high-res image boundary, error would creep in. This hadn\u0027t been accounted for in the original rescale() definition.",
      "range": {
        "startLine": 1682,
        "startChar": 0,
        "endLine": 1701,
        "endChar": 5
      },
      "revId": "e49fd0b765132f17e6028411d868d18aec76dfbc",
