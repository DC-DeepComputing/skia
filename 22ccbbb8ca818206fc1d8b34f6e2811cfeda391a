      "writtenOn": "2021-07-28T15:30:11Z",
      "side": 1,
      "message": "I changed to the one routine, with wrapping for the raw pointer resources. Is the intention to have GrVkResourceProvider return sk_sp\u003c\u003e for all the resources rather than raw pointers? Seems like that would lead to unnecessary refs.",
      "parentUuid": "82f460dd_1f9e7f46",
      "range": {
        "startLine": 57,
        "startChar": 0,
        "endLine": 59,
        "endChar": 5
      },
      "revId": "22ccbbb8ca818206fc1d8b34f6e2811cfeda391a",
