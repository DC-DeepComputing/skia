      "writtenOn": "2022-09-14T14:36:44Z",
      "side": 1,
      "message": "Oh, if we do a BlendColorFilter, could we just have the render step assign to that source color uniform?",
      "parentUuid": "4d0c3364_e6847da3",
      "range": {
        "startLine": 74,
