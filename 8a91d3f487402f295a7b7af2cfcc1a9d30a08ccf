      "writtenOn": "2024-07-30T00:37:40Z",
      "side": 1,
      "message": "These are typically called \"color stops\". The name \"offset\" is confusing/overloaded here. It took me a while to figure out what this variable (and `highOffset`) represented.",
      "range": {
        "startLine": 666,
        "startChar": 14,
        "endLine": 666,
        "endChar": 23
      },
      "revId": "8a91d3f487402f295a7b7af2cfcc1a9d30a08ccf",
