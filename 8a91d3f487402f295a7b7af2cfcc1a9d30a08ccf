      "writtenOn": "2024-07-31T13:59:47Z",
      "side": 1,
      "message": "I renamed `arr` to `colorAndOffsetData` to match the same naming convention the sampler in the texture approach has. And this is also the name of the array in the shader functions that gets passed in for this argument.",
      "parentUuid": "54da2c65_e1e9e821",
      "range": {
        "startLine": 642,
        "startChar": 42,
        "endLine": 642,
        "endChar": 54
