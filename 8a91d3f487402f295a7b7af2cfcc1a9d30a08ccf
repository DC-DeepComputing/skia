    {
      "unresolved": true,
      "key": {
        "uuid": "c454e264_e27aa013",
        "filename": "src/sksl/sksl_graphite_frag.sksl",
        "patchSetId": 4
      },
      "lineNbr": 666,
      "author": {
        "id": 3438316
      },
      "writtenOn": "2024-07-30T20:00:13Z",
      "side": 1,
      "message": "A \"color stop\" I believe generally includes the color and stop/offset/position. I think there are many terms that can signify the `t-value` but in all the other gradient code we stick with `offset` so I think sticking with `offset` is the right choice here for consistency. I think renaming `bufferOffset` to `offsetsBaseIndex` should help in keeping consistent in what `offset` means in this context.",
      "parentUuid": "50fb96e0_d57d3908",
      "range": {
        "startLine": 666,
        "startChar": 14,
        "endLine": 666,
        "endChar": 23
      },
      "revId": "8a91d3f487402f295a7b7af2cfcc1a9d30a08ccf",
      "serverId": "5086850b-e599-37d2-8ec8-ff16aeccbf02"
    },
