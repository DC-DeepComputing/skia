      "writtenOn": "2024-07-30T00:37:40Z",
      "side": 1,
      "message": "I think this code might be easier to follow, and likely no less efficient, if these ran from zero to `numStops - 1` and we always did lookups as `arr[whatever + base]`.",
      "range": {
        "startLine": 654,
        "startChar": 0,
        "endLine": 656,
        "endChar": 0
      },
      "revId": "8a91d3f487402f295a7b7af2cfcc1a9d30a08ccf",
      "serverId": "5086850b-e599-37d2-8ec8-ff16aeccbf02"
