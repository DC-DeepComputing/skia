      "writtenOn": "2021-10-08T00:08:54Z",
      "side": 1,
      "message": "I don\u0027t know how strongly you feel (or I feel about the name), but wdyt about Bounds instead of Rect, to differentiate it from SkRect and highlight where it\u0027s meant to shine?",
      "range": {
        "startLine": 25,
        "startChar": 6,
        "endLine": 25,
        "endChar": 11
      },
      "revId": "6a3590e3bbefcccf37325279c3f0844ed88b134a",
