      "lineNbr": 260,
      "author": {
        "id": 4159917
      },
      "writtenOn": "2026-09-28T21:52:12Z",
      "side": 1,
      "message": "Yes, this is intentional. The top-level canvas is established from the parsed directory before payload decodability is known, and every directory entry continues to contribute even if its payload is skipped later. Otherwise the reported dimensions could change as more payload data becomes available, reintroducing the progressive-decode instability fixed earlier. I added a comment making this explicit.",
      "parentUuid": "83ffd3e4_02703978",
      "revId": "fc7c537c08f34d4de19bba4396049e31973b4f3e",
      "serverId": "5086850b-e599-37d2-8ec8-ff16aeccbf02"
    },
