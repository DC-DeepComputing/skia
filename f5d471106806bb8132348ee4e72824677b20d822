      "writtenOn": "2025-09-10T21:23:15Z",
      "side": 1,
      "message": "No **immediate** concerns, but I am curious why this header is in a _private_ directory.  Will there be a separate, _public_ API that Blink can use for getting the decoded HDR metadata?",
      "range": {
        "startLine": 1,
        "startChar": 0,
        "endLine": 1,
        "endChar": 2
      },
      "revId": "f5d471106806bb8132348ee4e72824677b20d822",
