        "id": 6225
      },
      "writtenOn": "2025-09-11T13:32:07Z",
      "side": 1,
      "message": "I put things in \"private\" they\u0027re interfaces that I only want Chrome (and Android) to use, for the time being.\n\nEventually I think we should move all of this stuff (and gainmaps too) to the public APIs, but only once they\u0027re no longer going to be in flux.",
      "parentUuid": "fc79e757_75e98f1c",
      "range": {
        "startLine": 1,
        "startChar": 0,
        "endLine": 1,
        "endChar": 2
      },
