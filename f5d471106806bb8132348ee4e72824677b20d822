      "unresolved": false,
      "key": {
        "uuid": "353c3b22_05c58bfd",
        "filename": "include/private/SkHdrMetadata.h",
        "patchSetId": 5
      },
      "lineNbr": 25,
      "author": {
        "id": 6225
      },
      "writtenOn": "2025-09-12T09:58:21Z",
      "side": 1,
      "message": "Oh no ... the PNG version isn\u0027t the same as the CTA 861-H version. PNG claims these values are nits whereas 861-H says they\u0027re maximum color component.\n\nFor greyscale images, these are the same, but for blue images, nits are way lower than maximum color component.\n\nAnd PNG references various outlier filtering techniques that 861-H doesn\u0027t...\n\nI added some notes to the header and a warning to only use the metadata in ways that are compatible with both definitions.\n\n(It\u0027s stuff like this that motives ST 2094-50).",
      "parentUuid": "cc446450_ec2001c9",
      "range": {
        "startLine": 25,
        "startChar": 3,
        "endLine": 25,
        "endChar": 8
      },
      "revId": "f5d471106806bb8132348ee4e72824677b20d822",
      "serverId": "5086850b-e599-37d2-8ec8-ff16aeccbf02"
    },
    {
