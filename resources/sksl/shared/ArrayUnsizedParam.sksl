
// Unsized array parameters only work with readonly buffers.
layout(set = 0, binding = 0) readonly buffer testStorageBuffer {
    float[] testArr;
};

struct S {
    int y;
};

// Test that these versions of unsized array parameters compile successfully.
int unsizedInParameterA(int x[]) { return x[0]; }
int unsizedInParameterB(S x[]) { return x[0].y; }
int unsizedInParameterC(int[] x) { return x[0]; }
int unsizedInParameterD(S[] x) { return x[0].y; }
void unsizedInParameterE(int[]) {}
void unsizedInParameterF(S[]) {}

noinline half4 getColor(float[] arr) {
    return half4(arr[0], arr[1], arr[2], arr[3]);
}

noinline half4 getColorSecond(float arr[]) {
    return half4(arr[0], arr[1], arr[2], arr[3]);
}

void main() {
    sk_FragColor = getColor(testArr);
    sk_FragColor = getColorSecond(testArr);
}
