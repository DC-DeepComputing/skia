layout(binding=0) uniform sampler2DRect t;
half4 main(float2 coords)
{
    half4 c = half4(1);
    c *= sample(t, coords);
    c *= sampleGrad(t, coords, dFdx(coords), dFdy(coords));
    return c;
}

// This test is expected to report different results based on the backends.
// Expect successful compilation in GLSL, failure in Metal and SPIR-V.
