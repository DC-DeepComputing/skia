uniform half4 colorGreen, colorRed;

half4 main(float2 coords) {
    bool ok;
    ok =       !false;
    ok = ok && !!true;
    ok = ok && !(colorGreen.g <  colorGreen.r);
    ok = ok && !(colorGreen.g <= colorGreen.r);
    ok = ok && !(colorGreen.b >  colorGreen.g);
    ok = ok && !(colorGreen.b >= colorGreen.g);
    ok = ok && !(colorGreen.g == colorGreen.r);
    ok = ok && !(colorGreen.g != colorGreen.a);

    return ok ? colorGreen : colorRed;
}
