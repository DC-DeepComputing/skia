# TODO(kjlubick,cmumford) remove the globs and generate the .gni files from the Bazel files
filegroup(
    name = "sksl_blend_tests",
    srcs = glob(
        include = [
            "blend/*.sksl",
        ],
        allow_empty = False,
    ),
)

filegroup(
    name = "sksl_error_tests",
    srcs = glob(
        include = [
            "errors/*.rts",
            "errors/*.sksl",
            "errors/*.vert",
        ],
        allow_empty = False,
        exclude = [
            "errors/Ossfuzz36850.sksl",
            "errors/Ossfuzz37469.sksl",
        ],
    ),
)

filegroup(
    name = "sksl_folding_tests",
    srcs = glob(
        include = [
            "folding/*.rtb",
            "folding/*.rtcf",
            "folding/*.rts",
        ],
    ),
)

filegroup(
    name = "sksl_glsl_tests",
    srcs = glob(
        include = [
            "glsl/*.sksl",
        ],
    ),
)

filegroup(
    name = "sksl_inliner_tests",
    srcs = glob(
        include = [
