half4 main(float2 xy) {
    int i;

    for (int a=0; a<10000; ++a) // 10000
    for (int a=0; a<10000; ++a) // 100000000
    for (int a=0; a<10000; ++a) // 1000000000000
    for (int a=0; a<10000; ++a) // 10000000000000000
    for (int a=0; a<10000; ++a) // 100000000000000000000
    for (int a=0; a<10000; ++a) // 1000000000000000000000000
    for (int a=0; a<10000; ++a) // 10000000000000000000000000000
    for (int a=0; a<10000; ++a) // 100000000000000000000000000000000 (over 2^100)
        ++i;

    return half4(0);
}
