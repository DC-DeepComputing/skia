uniform float4 testInputs;  // equals (-1.25, 0, 0.75, 2.25)
uniform half4 colorGreen, colorRed;

half4 main(float2 coords) {
    float4 expected = float4(0);  // derivative of a constant is zero
    return (dFdy(testInputs.x)        == expected.x     &&
            dFdy(testInputs.xy)       == expected.xy    &&
            dFdy(testInputs.xyz)      == expected.xyz   &&
            dFdy(testInputs.xyzw)     == expected.xyzw  &&
            abs(sign(dFdy(coords.x))) == 0              &&
            abs(sign(dFdy(coords.y))) == 1) ? colorGreen : colorRed;
}
