uniform float4 testInputs;  // equals (-1.25, 0, 0.75, 2.25)
uniform half4 colorGreen, colorRed;

half4 main(float2 coords) {
    float4 expected = float4(0);  // derivative of a constant is zero
    return (dFdx(testInputs.x)        == expected.x     &&
            dFdx(testInputs.xy)       == expected.xy    &&
            dFdx(testInputs.xyz)      == expected.xyz   &&
            dFdx(testInputs.xyzw)     == expected.xyzw  &&
            abs(sign(dFdx(coords.x))) == 1              &&
            abs(sign(dFdx(coords.y))) == 0) ? colorGreen : colorRed;
}
