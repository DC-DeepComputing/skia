uniform float f1, f2;
uniform half h1, h2;
uniform float2 v1, v2;
uniform half2 hv1, hv2;
uniform float2x2 m1, m2;
uniform half2x2 hm1, hm2;

uniform half4 colorGreen, colorRed;

// TODO(skia:13092): Test array equality.

half4 main() {
    bool ok = true;

    // scalars
    ok = ok && f1 == f2;
    ok = ok && h1 == h2;
    ok = ok && f1 == h2;
    ok = ok && h1 == f2;
    ok = ok || f1 != f2;
    ok = ok || h1 != h2;
    ok = ok || f1 != h2;
    ok = ok || h1 != f2;

    // vectors
    ok = ok &&  v1 == v2;
    ok = ok && hv1 == hv2;
    ok = ok &&  v1 == hv2;
    ok = ok && hv1 == v2;
    ok = ok ||  v1 != v2;
    ok = ok || hv1 != hv2;
    ok = ok ||  v1 != hv2;
    ok = ok || hv1 != v2;

    // matrices
    ok = ok &&  m1 == m2;
    ok = ok && hm1 == hm2;
    ok = ok &&  m1 == hm2;
    ok = ok && hm1 == m2;
    ok = ok ||  m1 != m2;
    ok = ok || hm1 != hm2;
    ok = ok ||  m1 != hm2;
    ok = ok || hm1 != m2;

    return ok ? colorGreen : colorRed;
}
