half4 blend_src_over(half4 src, half4 dst) {
    return src + (1 - src.a)*dst;
}

half4 main(half4 src, half4 dst) {
    return blend_src_over(src, half4(1) - dst);
}

/*%%*
functions 'half4 blend_src_over(half4 src, half4 dst)' and '$pure half4 blend_src_over(half4 src, half4 dst)' differ only in modifiers
*%%*/
