layout(location=0) in int2 size1;
layout(location=1) in float data1[];
layout(location=2) in int2 size2;
layout(location=3) in float data2[];
layout(location=4) out int2 resultSize;
layout(location=5) out float resultData[];

void main() {
    resultSize = int2(size1.x, size2.y);
  
    int2 resultCell = int2(sk_ThreadPosition.x, sk_ThreadPosition.y);
    float result = 0.0;
    for (int i = 0; i < size1.y; ++i) {
      int a = i + resultCell.x * size1.y;
      int b = resultCell.y + i * size2.y;
      result += data1[a] * data2[b];
    }
  
    int index = resultCell.y + resultCell.x * size2.y;
    resultData[index] = result;
}
