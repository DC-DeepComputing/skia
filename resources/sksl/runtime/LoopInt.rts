    int4 result = int4(-999);
    for (int i = -2; i != 2; ++i) {
        result = half4(result.yzw, i);
    }
    if (result != int4(-999)) {
        return false;
    }
    return true;
}

bool loop_operator_eq() {
    int4 result = int4(-999);
    for (int i = -2; i == 2; ++i) {
        result.yzw = result.xyz;
        result.x = i;
    }
    if (result != int4(-999)) {
        return false;
    }
    return true;
}
*/

half4 main(float2 xy) {
    if (return_loop() != 5 || continue_loop() != 35 || break_loop() != 15 ||
        !loop_operator_le() || !loop_operator_lt() ||
        !loop_operator_ge() || !loop_operator_gt()) {
        return colorRed;
    }
    return colorGreen;
}
