uniform half4 colorRed, colorGreen;

// Should return 5
int return_loop() {
    for (int i = 0; i < 10; ++i) {
        if (i == 5) { return i; }
    }
    return 0;
}

// Should return 35
int continue_loop() {
    int sum = 0;
    for (int i = 0; i < 10; ++i) {
        if (i < 5) { continue; }
        sum += i;
    }
    return sum;
}

// Should return 15
int break_loop() {
    int sum = 0;
    for (int i = 0; i < 10; ++i) {
        if (i > 5) { break; }
        sum += i;
    }
    return sum;
}

bool loop_operator_le() {
    int4 result = int4(-999);
    for (int i = 1; i <= 4; ++i) {
        result = int4(result.yzw, i);
    }
    if (result != int4(1, 2, 3, 4)) {
        return false;
    }

    // These loops are inside-out and execute zero times.
    for (int i = 4; i <= 1; ++i) { return false; }
    for (int i = 4; i <= 1; --i) { return false; }
    return true;
}

bool loop_operator_lt() {
    int4 result = int4(-999);
    for (int i = 1; i < 5; ++i) {
        result = int4(result.yzw, i);
    }
    if (result != int4(1, 2, 3, 4)) {
        return false;
    }

    // These loops are inside-out and execute zero times.
    for (int i = 5; i < 1; ++i) { return false; }
    for (int i = 5; i < 1; --i) { return false; }
    return true;
}

bool loop_operator_ge() {
    int4 result = int4(-999);
    for (int i = 4; i >= 1; --i) {
        result = int4(result.yzw, i);
    }
    if (result != int4(4, 3, 2, 1)) {
        return false;
    }

    // These loops are inside-out and execute zero times.
    for (int i = 1; i >= 4; ++i) { return false; }
    for (int i = 1; i >= 4; --i) { return false; }
    return true;
}

bool loop_operator_gt() {
    int4 result = int4(-999);
    for (int i = 4; i > 0; --i) {
        result = int4(result.yzw, i);
    }
    if (result != int4(4, 3, 2, 1)) {
        return false;
    }

    // These loops are inside-out and execute zero times.
    for (int i = 0; i > 4; ++i) { return false; }
    for (int i = 0; i > 4; --i) { return false; }
    return true;
}

