/*#pragma settings NoES2Restrictions*/

uniform half4 colorGreen, colorRed;

struct S {float f1; float f2; float f3; };
struct SA {float[2] a1; float[2] a2; };
struct DEEP {S s1; SA sa2; SA asa3[2]; };

S getS(S a0, float one) {
     S a = a0;
     a.f1 *= one;
     a.f2 *= one;
     a.f3 *= one;
     return a;
}

SA getSA(SA sa0, float one) {
    SA sa = sa0;
    sa.a1[0] = sa0.a1[0] * one;
    sa.a1[1] = sa0.a1[1] * one;
    sa.a2[0] = sa0.a2[0] * one;
    sa.a2[1] = sa0.a2[1] * one;
    return sa;
}
