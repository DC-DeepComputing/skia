/*#pragma settings NoES2Restrictions*/

uniform half4 colorGreen, colorRed;

struct S {float f1; float f2; float f3; };
struct SA {float[2] a1; float[2] a2; };
struct DEEP {S s1; SA sa2; SA asa3[2]; };

bool test_struct(bool eq, bool diff, float f1, float f2, float f3) {
    S a; a.f1 = f1; a.f2 = f2; a.f3 = f3;
    S b; b.f1 = f1; b.f2 = f2; b.f3 = f3;
    if (diff) b.f3 += 1.0;
    return eq ? a == b : a != b;
}

bool test_array(bool eq, bool diff, float f1, float f2, float f3) {
    float a[3]; a[0] = f1; a[1] = f2; a[2] = f3;
    float b[3]; b[0] = f1; b[1] = f2; b[2] = f3;
    if (diff) b[2] += 1.0;
    return eq ? a == b : a != b;
}

bool test_struct_of_arrays(bool eq, bool diff, float f1, float f2, float f3, float f4) {
    SA a; a.a1[0] = f1; a.a1[1] = f2; a.a2[0] = f3; a.a2[1] = f4;
    SA b; b.a1[0] = f1; b.a1[1] = f2; b.a2[0] = f3; b.a2[1] = f4;
    if (diff) b.a2[1] += 1.0;
    return eq ? a == b : a != b;
}

bool test_array_of_structs(bool eq, bool diff, float f1, float f2, float f3, float f4, float f5, float f6) {
    S a[2]; a[0].f1 = f1; a[0].f2 = f2; a[0].f3 = f3; a[1].f1 = f4; a[1].f2 = f5; a[1].f3 = f6;
    S b[2]; b[0].f1 = f1; b[0].f2 = f2; b[0].f3 = f3; b[1].f1 = f4; b[1].f2 = f5; b[1].f3 = f6;
    if (diff) b[1].f3 += 1.0;
    return eq ? a == b : a != b;
}

bool test_deep_recursion(bool eq, bool diff, float f1, float f2, float f3, float f4) {
    S a; a.f1 = f1; a.f2 = f2; a.f3 = f3;
    S b; b.f1 = f1; b.f2 = f2; b.f3 = f3;

    SA sa; sa.a1[0] = f1; sa.a1[1] = f2; sa.a2[0] = f3; sa.a2[1] = f4;
    SA sb; sb.a1[0] = f1; sb.a1[1] = f2; sb.a2[0] = f3; sb.a2[1] = f4;

    DEEP d1[2];
    d1[0].s1 = a; d1[0].sa2 = sa; d1[0].asa3[0] = sa; d1[0].asa3[1] = sa;
    d1[1].s1 = a; d1[1].sa2 = sa; d1[1].asa3[0] = sa; d1[1].asa3[1] = sa;
    DEEP d2[2];
    d2[0].s1 = b; d2[0].sa2 = sb; d2[0].asa3[0] = sb; d2[0].asa3[1] = sb;
    d2[1].s1 = b; d2[1].sa2 = sb; d2[1].asa3[0] = sb; d2[1].asa3[1] = sb;

    if (diff) d2[1].s1.f3 += 1.0;
    return eq ? d1 == d2 : d1 != d2;
}

vec4 main(vec2 coords) {
    float NA = colorGreen.r/colorGreen.b;
    float ZP = +colorGreen.r*colorGreen.b;
    float ZM = -colorGreen.r*colorGreen.b;
    
    bool EQ = true;
    bool NE = false;
    bool SAME = false;
    bool DIFF = true;

    return  true

            && test_struct(EQ, SAME, 42.0, ZM, ZP) && !test_struct(NE, SAME, 42.0, ZM, ZP)         // equal, including 0- and 0+
            && test_struct(NE, SAME, 42.0, NA, NA) && !test_struct(EQ, SAME, 42.0, NA, NA)         // NA always not equal
            && test_struct(NE, DIFF, 42.0, 42.0, 42.0) && !test_struct(EQ, DIFF, 42.0, 42.0, 42.0) // one of the normal values not equal; all normal are equal

            && test_array(EQ, SAME, 42.0, ZM, ZP) && !test_array(NE, SAME, 42.0, ZM, ZP)
            && test_array(NE, SAME, 42.0, NA, NA) && !test_array(EQ, SAME, 42.0, NA, NA)
            && test_array(NE, DIFF, 42.0, 42.0, 42.0) && !test_array(EQ, DIFF, 42.0, 42.0, 42.0)

            && test_struct_of_arrays(EQ, SAME, 42.0, ZM, 42.0, ZP) && !test_struct_of_arrays(NE, SAME, 42.0, ZM, 42.0, ZP)
            && test_struct_of_arrays(NE, SAME, 42.0, NA, 42.0, NA) && !test_struct_of_arrays(EQ, SAME, 42.0, NA, 42.0, NA)
            && test_struct_of_arrays(NE, DIFF, 42.0, 42.0, 42.0, 42.0) && !test_struct_of_arrays(EQ, DIFF, 42.0, 42.0, 42.0, 42.0)

            && test_array_of_structs(EQ, SAME, 42.0, ZM, ZP, 42.0, ZM, ZP) && !test_array_of_structs(NE, SAME, 42.0, ZM, ZP, 42.0, ZM, ZP)
            && test_array_of_structs(NE, SAME, 42.0, NA, NA, 42.0, NA, NA) && !test_array_of_structs(EQ, SAME, 42.0, NA, NA, 42.0, NA, NA)
            && test_array_of_structs(NE, DIFF, 42.0, 42.0, 42.0, 42.0, 42.0, 42.0) && !test_array_of_structs(EQ, DIFF, 42.0, 42.0, 42.0, 42.0, 42.0, 42.0)

            && test_deep_recursion(EQ, SAME, 42.0, ZM, 42.0, ZP) && !test_deep_recursion(NE, SAME, 42.0, ZM, 42.0, ZP)
            && test_deep_recursion(NE, SAME, 42.0, NA, 42.0, NA) && !test_deep_recursion(EQ, SAME, 42.0, NA, 42.0, NA)
            && test_deep_recursion(NE, DIFF, 42.0, 42.0, 42.0, 42.0) && !test_deep_recursion(EQ, DIFF, 42.0, 42.0, 42.0, 42.0)

           ? colorGreen : colorRed;
}
