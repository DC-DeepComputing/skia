uniform half4 colorRed, colorGreen;

// Should return 5
float return_loop() {
    for (float i = 0; i < 10; ++i) {
        if (i == 5) { return i; }
    }
    return 0;
}

// Should return 35
float continue_loop() {
    float sum = 0;
    for (float i = 0; i < 10; ++i) {
        if (i < 5) { continue; }
        sum += i;
    }
    return sum;
}

// Should return 15
float break_loop() {
    float sum = 0;
    for (float i = 0; i < 10; ++i) {
        if (i > 5) { break; }
        sum += i;
    }
    return sum;
}

// Should return ~1.725
float float_loop() {
    float sum = 0;
    for (float i = 0.123; i < 0.6; i += 0.111) {
        sum += i;
    }
    return sum;
}

bool loop_operator_le() {
    float4 result = float4(-999);
    for (float i = 1; i <= 4; ++i) {
        result = float4(result.yzw, i);
    }
    if (result != float4(1, 2, 3, 4)) {
        return false;
    }

    // These loops are inside-out and execute zero times.
    for (float i = 4; i <= 1; ++i) { return false; }
    for (float i = 4; i <= 1; --i) { return false; }
    return true;
}

bool loop_operator_lt() {
    float4 result = float4(-999);
    for (float i = 1; i < 5; ++i) {
        result = float4(result.yzw, i);
    }
    if (result != float4(1, 2, 3, 4)) {
        return false;
    }

    // These loops are inside-out and execute zero times.
    for (float i = 5; i < 1; ++i) { return false; }
    for (float i = 5; i < 1; --i) { return false; }
    return true;
}

bool loop_operator_ge() {
    float4 result = float4(-999);
    for (float i = 4; i >= 1; --i) {
        result = float4(result.yzw, i);
    }
    if (result != float4(4, 3, 2, 1)) {
        return false;
    }

    // These loops are inside-out and execute zero times.
    for (float i = 1; i >= 4; ++i) { return false; }
    for (float i = 1; i >= 4; --i) { return false; }
    return true;
}

bool loop_operator_gt() {
    float4 result = float4(-999);
    for (float i = 4; i > 0; --i) {
        result = float4(result.yzw, i);
    }
    if (result != float4(4, 3, 2, 1)) {
        return false;
    }

    // These loops are inside-out and execute zero times.
    for (float i = 0; i > 4; ++i) { return false; }
    for (float i = 0; i > 4; --i) { return false; }
    return true;
}

half4 main(float2 xy) {
    if (return_loop() != 5 || continue_loop() != 35 || break_loop() != 15 ||
        !loop_operator_le() || !loop_operator_lt() ||
        !loop_operator_ge() || !loop_operator_gt()) {
        return colorRed;
    }
    return colorGreen;
}
