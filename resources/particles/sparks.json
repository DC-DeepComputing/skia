{
   "MaxCount": 800,
   "Drawable": {
      "Type": "SkLineDrawable"
   },
   "Code": [
      "void effectSpawn(inout Effect effect) {",
      "  effect.rate = 40;",
      "}",
      "",
      "void spawn(inout Particle p) {",
      "  p.lifetime = 3 + rand(p.seed) * 2;",
      "  float a = radians(290 + rand(p.seed) * 30);",
      "  p.dir = float2(cos(a), sin(a));",
      "  p.vel = p.dir * (80 + rand(p.seed) * 10);",
      "}",
      "",
      "void update(inout Particle p) {",
      "  p.vel.y += dt * 60;",
      "  if (p.pos.y > 50) { p.vel.y *= -1; }",
      "  p.scale = length(p.vel) / 8;",
      "  p.dir = normalize(p.vel);",
      "}",
      ""
   ],
   "Bindings": []
}