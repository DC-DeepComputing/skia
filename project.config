[access]
	inheritFrom = Public-Projects
[submit]
	action = rebase always
[access "refs/heads/infra/config"]
	read = group skia-scoped
	submit = group chrome-branch-day-bot
[access "refs/*"]
	deleteOwnChanges = group chrome-cherry-picker
[access "^refs/heads/chrome/m[0-9]+"]
	submit = group chrome-branch-day-bot
[access "refs/heads/main"]
	submit = group chrome-branch-day-bot
[access "refs/for/refs/heads/chrome/*"]
	addPatchSet = group cria/project-skia-committers
[access "refs/heads/chrome/*"]
	label-Commit-Queue = +0..+2 group cria/project-skia-committers
	toggleWipState = group cria/project-skia-committers
