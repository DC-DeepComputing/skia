      "side": 1,
      "message": "It seems unsafe to ignore the error.  Can we instead check the output and only ignore the error if it matches a regex?",
      "range": {
        "startLine": 138,
        "startChar": 0,
        "endLine": 138,
        "endChar": 20
      },
      "revId": "76faf88beb0bb48deb7d68cea15e7664ed453de5",
