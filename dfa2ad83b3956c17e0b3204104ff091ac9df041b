    },
    {
      "unresolved": false,
      "key": {
        "uuid": "48e0fa72_dc60b6b8",
        "filename": "include/private/SkTDArray.h",
        "patchSetId": 9
      },
      "lineNbr": 41,
      "author": {
        "id": 5210
      },
      "writtenOn": "2022-09-21T13:10:50Z",
      "side": 1,
      "message": "The braces are better because it shows there is no silent casting happening. When other methods are used, you have to reason about the different silent casts that can happen.",
      "parentUuid": "1928c153_1abbb5ec",
      "range": {
        "startLine": 41,
