      "writtenOn": "2022-09-20T16:47:14Z",
      "side": 1,
      "message": "tiny nit, optional: the brace form is uncommon in Skia, and makes this code feel like it\u0027s doing something clever/interesting when it\u0027s really just initializing to a default value. Consider `void* fStorage \u003d nullptr;`",
      "range": {
        "startLine": 41,
        "startChar": 10,
        "endLine": 41,
        "endChar": 28
      },
      "revId": "dfa2ad83b3956c17e0b3204104ff091ac9df041b",
