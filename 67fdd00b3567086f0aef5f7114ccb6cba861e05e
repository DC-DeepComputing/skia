        "id": 5633
      },
      "writtenOn": "2021-10-08T22:14:40Z",
      "side": 1,
      "message": "I\u0027m assuming the device itself holds the clip state for this method?\n\nCan we make a way for this to modify the shape? E.g., rect clipped by rect can intersect to an unclipped rect.",
      "parentUuid": "cfbcd99d_8709a71f",
      "range": {
        "startLine": 135,
        "startChar": 4,
        "endLine": 135,
        "endChar": 19
      },
      "revId": "67fdd00b3567086f0aef5f7114ccb6cba861e05e",
