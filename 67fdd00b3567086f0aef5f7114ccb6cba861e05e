      "lineNbr": 140,
      "author": {
        "id": 8341
      },
      "writtenOn": "2021-10-12T16:34:43Z",
      "side": 1,
      "message": "The updated CL has style as part of the DrawFlags, but keeping that in sync with the updated path effects does get a little trickier since we have to convert to SkStrokeRec to apply, and then convert back to flags + StrokeParams if it succeeds.\n\nLet me know if you think it\u0027s acceptable, or want me to explore other representations.",
      "parentUuid": "13ab4a42_64ac109f",
      "range": {
        "startLine": 140,
        "startChar": 42,
        "endLine": 140,
        "endChar": 68
      },
      "revId": "67fdd00b3567086f0aef5f7114ccb6cba861e05e",
