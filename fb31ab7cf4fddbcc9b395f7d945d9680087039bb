      "writtenOn": "2022-10-10T14:29:15Z",
      "side": 1,
      "message": "Can you add a big comment to document why we have these two constructors and what sort of calls are not allowed and not allowed in Skia based on if you just have a Texture or a TextureView",
      "range": {
        "startLine": 33,
        "startChar": 2,
        "endLine": 34,
        "endChar": 19
      },
      "revId": "fb31ab7cf4fddbcc9b395f7d945d9680087039bb",
