      "message": "This is what I went with for now. ethannicholas@ any thoughts on this approach and the comment above?",
      "range": {
        "startLine": 127,
        "startChar": 37,
        "endLine": 127,
        "endChar": 62
      },
      "revId": "5910654823dc8d9ab7e57b837f4dd85c461f3f92",
