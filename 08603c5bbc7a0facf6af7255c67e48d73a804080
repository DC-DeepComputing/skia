      },
      "writtenOn": "2022-05-12T21:40:20Z",
      "side": 1,
      "message": "glslang permits comments before #version: http://screen/6wZvbnMTHzn7B3w\n\nWebGL does as well.\n\nThey are probably removed by the preprocessor.",
      "parentUuid": "b9aed692_b4965090",
      "revId": "08603c5bbc7a0facf6af7255c67e48d73a804080",
