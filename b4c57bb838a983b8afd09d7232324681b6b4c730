        "id": 5036
      },
      "writtenOn": "2026-03-31T20:22:40Z",
      "side": 1,
      "message": "I agree with Noelle that these should probably be stack variables. But if for some reason they really cannot be, I would at least make a std::unique_ptr\u003c\u003e so you don\u0027t have to call delete manually.",
      "parentUuid": "32e1834b_974f3528",
      "range": {
        "startLine": 849,
        "startChar": 26,
        "endLine": 849,
        "endChar": 29
      },
      "revId": "b4c57bb838a983b8afd09d7232324681b6b4c730",
