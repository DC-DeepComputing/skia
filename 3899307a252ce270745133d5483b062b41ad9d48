        "id": 13824
      },
      "writtenOn": "2023-04-10T18:00:09Z",
      "side": 1,
      "message": "Do you think it would be useful to keep an AddPrimitiveBlendBlock function that takes in an SkBlender and sets up the BlendShaderBlock, PriorOutputBlock, PrimitiveColorBlock and then calls blender-\u003eaddToKey?",
      "parentUuid": "3d0bc2d5_e8306e4d",
      "range": {
        "startLine": 115,
        "startChar": 8,
        "endLine": 118,
        "endChar": 9
      },
      "revId": "3899307a252ce270745133d5483b062b41ad9d48",
