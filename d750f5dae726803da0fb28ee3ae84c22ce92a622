      "writtenOn": "2024-02-12T18:29:18Z",
      "side": 1,
      "message": "Do we need to guard against the case where `snapPathAtlasDispatches` gets called with a different Recorder than the one that `fComputePathAtlas` was initialized with? Is that even possible and can we somehow assert it?",
      "range": {
        "startLine": 288,
        "startChar": 52,
        "endLine": 288,
        "endChar": 60
      },
      "revId": "d750f5dae726803da0fb28ee3ae84c22ce92a622",
