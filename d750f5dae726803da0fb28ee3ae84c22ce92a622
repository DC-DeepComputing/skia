    },
    {
      "unresolved": true,
      "key": {
        "uuid": "c97302c2_ee673bf0",
        "filename": "src/gpu/graphite/DrawContext.cpp",
        "patchSetId": 2
      },
      "lineNbr": 288,
      "author": {
        "id": 5065
      },
      "writtenOn": "2024-02-12T19:13:00Z",
      "side": 1,
      "message": "Oh right, I was thinking I went too far and should have left recordDispatches but missed it on looking it over. I switched it back, but does it make sense to snap dispatches with a different Recorder than the one the Vello atlas was created with?",
      "parentUuid": "2669d60c_64dfce1d",
      "range": {
        "startLine": 288,
        "startChar": 52,
        "endLine": 288,
        "endChar": 60
      },
      "revId": "d750f5dae726803da0fb28ee3ae84c22ce92a622",
