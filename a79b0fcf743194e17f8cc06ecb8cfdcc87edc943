        "id": 8341
      },
      "writtenOn": "2026-04-21T18:52:24Z",
      "side": 1,
      "message": "I would be that the flexible `update_uniform_descriptor_set` is fast enough when passing in spans with 1 element each that we can avoid having code that so similarly modifies the the VkDescriptorBufferInfo",
      "range": {
        "startLine": 1369,
        "startChar": 5,
        "endLine": 1369,
        "endChar": 41
      },
      "revId": "a79b0fcf743194e17f8cc06ecb8cfdcc87edc943",
