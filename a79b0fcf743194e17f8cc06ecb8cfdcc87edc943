        "id": 8341
      },
      "writtenOn": "2026-04-21T18:52:24Z",
      "side": 1,
      "message": "This is right now hardcoded to use a uniform buffer type in its created descriptor, but we can get into this if when `uniformBufferType` is for SSBOs. \n\nWe should either check that in the if, or have `bindUniformBuffers()` handle building the single Descriptor and use the selected uniform buffer type.",
      "range": {
        "startLine": 1433,
        "startChar": 41,
        "endLine": 1433,
        "endChar": 69
      },
      "revId": "a79b0fcf743194e17f8cc06ecb8cfdcc87edc943",
      "serverId": "5086850b-e599-37d2-8ec8-ff16aeccbf02"
    },
