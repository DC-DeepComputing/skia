      "author": {
        "id": 8341
      },
      "writtenOn": "2026-04-21T18:52:24Z",
      "side": 1,
      "message": "This should be an `STArray\u003c2, uint32_t\u003e` since we know its max size and can keep it on the stack.",
      "range": {
        "startLine": 1421,
        "startChar": 0,
        "endLine": 1421,
        "endChar": 62
      },
      "revId": "a79b0fcf743194e17f8cc06ecb8cfdcc87edc943",
