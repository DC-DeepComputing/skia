      "writtenOn": "2021-10-12T15:27:00Z",
      "side": 1,
      "message": "Convert should generally return null on failure. Can we return nullptr here?",
      "range": {
        "startLine": 37,
        "startChar": 91,
        "endLine": 37,
        "endChar": 92
      },
      "revId": "7dcafe4ac554fe77f09948dc54ef032bf1af7274",
