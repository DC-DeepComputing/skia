      },
      "writtenOn": "2022-02-02T20:00:05Z",
      "side": 1,
      "message": "Is there a reason this can\u0027t be in \"emitPatchAttribs\" (renamed to not have the word \"Simple\" anymore)?",
      "range": {
        "startLine": 303,
        "startChar": 12,
        "endLine": 311,
