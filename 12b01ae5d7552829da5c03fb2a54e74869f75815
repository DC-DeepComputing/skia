        "id": 5642
      },
      "writtenOn": "2022-11-07T17:00:43Z",
      "side": 1,
      "message": "Thanks, that should be added to the description.\n\nWould it make sense to go the other way and convert all skia containers to size_t?  Seems odd to move in the wrong direction even for the right reason :)",
      "parentUuid": "2540cd0f_89f6d5e7",
      "range": {
        "startLine": 7,
        "startChar": 0,
        "endLine": 7,
        "endChar": 35
      },
      "revId": "12b01ae5d7552829da5c03fb2a54e74869f75815",
