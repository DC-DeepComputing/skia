        "id": 5210
      },
      "writtenOn": "2022-11-07T21:17:34Z",
      "side": 1,
      "message": "... and operator std::span\u003ct\u003e().",
      "parentUuid": "5506f260_b0fdfc2d",
      "range": {
        "startLine": 7,
        "startChar": 0,
        "endLine": 7,
        "endChar": 35
      },
      "revId": "12b01ae5d7552829da5c03fb2a54e74869f75815",
