      "writtenOn": "2022-08-19T19:41:39Z",
      "side": 1,
      "message": "This is a pretty pure translation, and I did it to minimize the amount of behavioral changes that the matrix image filter undergoes at once. However, in a follow-up CL I\u0027m going to add a transform field to skif::FilterResult to allow consecutive matrix transforms to be concatenated without generating new images. This will also allow it to be consolidated with the final draw, or let filters like the post-blur upscaling be combined together. That will make the immediate logic in MatrixTransformImageFilter::onFilterBounds pretty trivial.",
      "range": {
        "startLine": 121,
        "startChar": 4,
        "endLine": 140,
        "endChar": 60
      },
      "revId": "824f146b9be811c6c4739ae2644a50d9f3448c03",
      "serverId": "5086850b-e599-37d2-8ec8-ff16aeccbf02"
    },
