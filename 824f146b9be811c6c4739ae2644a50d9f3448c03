    {
      "unresolved": true,
      "key": {
        "uuid": "1fc604cb_198033ab",
        "filename": "src/effects/imagefilters/SkMatrixTransformImageFilter.cpp",
        "patchSetId": 4
      },
      "lineNbr": 156,
      "author": {
        "id": 8341
      },
      "writtenOn": "2022-08-19T19:41:39Z",
      "side": 1,
      "message": "paramToLayer(fTransform) is equal to (ctm * fTransform * ctm^-1) (matching the old code\u0027s variables). When that\u0027s inverted, it\u0027s equal to ctm * fTransform^-1 * ctm^-1, which matches the state of \u0027matrix\u0027 when the map direction is kReverse (which is equivalent to the getInputLayerBounds operation).\n\nThat\u0027s all mathematical, but the floating point actuality is probably a little different and I believe that\u0027s the reason for the very slight edge AA gold diffs.",
      "range": {
        "startLine": 156,
        "startChar": 8,
        "endLine": 156,
        "endChar": 59
      },
      "revId": "824f146b9be811c6c4739ae2644a50d9f3448c03",
      "serverId": "5086850b-e599-37d2-8ec8-ff16aeccbf02"
