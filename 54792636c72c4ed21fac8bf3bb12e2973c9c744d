    {
      "unresolved": true,
      "key": {
        "uuid": "df65423b_054b8998",
        "filename": "src/core/SkRRect.cpp",
        "patchSetId": 4
      },
      "lineNbr": 885,
      "author": {
        "id": 8341
      },
      "writtenOn": "2026-09-23T15:05:36Z",
      "side": 1,
      "message": "I don\u0027t think this is a real fast path for a couple of reasons:\na) The vast majority of SkRRects should be valid, so we have to check all the conditions anyways. Any time saved on early-out\u0027ing an invalid rrect is negligible in the grand scheme of things.\nb) The complexity of either of these functions is both very small, so combining them and removing any redundant checks that are occurring in both, seems worthwhile.\nc) The distinction between the names of these functions is pretty minimal so we should combine them as a common set of predicates or better differentiate the names.\nd) The return loop with the four calls to `are_radii_predicates_valid` also early-outs like the for loop since it will stop as soon as one of them returns false.",
      "parentUuid": "1e273d56_d69148d0",
      "range": {
        "startLine": 878,
        "startChar": 0,
        "endLine": 885,
        "endChar": 5
      },
      "revId": "54792636c72c4ed21fac8bf3bb12e2973c9c744d",
