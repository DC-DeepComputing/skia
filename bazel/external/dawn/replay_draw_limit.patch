+    // TEMP(skia): Returns the replayed object for a capture object id (as seen by Capture::Walk).
+    template <typename T>
+    T GetObjectById(uint64_t id) const;
+
+    // TEMP(skia): Replays only the first `count` draw calls (Draw, DrawIndexed, DrawIndirect and
