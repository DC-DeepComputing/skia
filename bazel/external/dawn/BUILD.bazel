load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load(":cmake_external_build.bzl", "cmake_external_build")

filegroup(
    name = "all_files",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)

py_library(
    name = "jinja2",
    srcs = glob(["jinja2/**/*.py"]),
    imports = ["."],
)

py_library(
    name = "markupsafe",
    srcs = glob(["markupsafe/**/*.py"]),
    imports = ["."],
)

py_binary(
    name = "build_dawn_bazel",
    srcs = ["build_dawn_bazel.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":jinja2",
        ":markupsafe",
    ],
)

cmake_external_build(
    name = "dawn_cmake",
    build_script = ":build_dawn_bazel",
    cmake_tool = "cmake/bin/cmake",
    dawn_and_deps = ":all_files",
    ninja_tool = "ninja/ninja",
    output_lib_name = "libdawn_combined.a",
)

cc_library(
    name = "dawn",
    srcs = [":dawn_cmake"],
    hdrs = [
        # Hard-coded stable headers
        ":dawn_cmake_include/dawn/dawn_proc.h",
        ":dawn_cmake_include/dawn/dawn_thread_dispatch_proc.h",
        ":dawn_cmake_include/webgpu/webgpu.h",
        ":dawn_cmake_include/webgpu/webgpu_cpp.h",
        ":dawn_cmake_include/webgpu/webgpu_enum_expectations.h",
    ],
    includes = [
        "dawn_cmake_include",
        # We also need the original headers from the dawn source
        "dawn/include",
        "dawn/src",
    ],
    visibility = ["//visibility:public"],
)
