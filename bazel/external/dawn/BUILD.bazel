### Dawn Generators ###

# See also generator/dawn_generator.gni
py_binary(
    name = "dawn_json_generator",
    srcs = [
        "generator/dawn_json_generator.py",
        "generator/generator_lib.py",
    ],
    deps = [
        requirement("jinja2"),
        # jinja2 has a dep on MarkupSafe. Declaring MarkupSafe here is not necessary, but it makes
        # the link easier to find than searching the Bazel cache for generated deps.
        requirement("MarkupSafe"),
    ],
)

# src/dawn/BUILD.gn#proc_gen
genrule(
    name = "generate_proc",
    srcs = [
        "src/dawn/dawn.json",
        "src/dawn/dawn_wire.json",
        "src/dawn/dawn_kotlin.json",
        "generator/templates/BSD_LICENSE",
        "generator/templates/dawn_proc.cpp",
        "generator/templates/dawn_thread_dispatch_proc.cpp",
    ],
    outs = [
        "src/dawn/dawn_proc.cpp",
        "src/dawn/dawn_thread_dispatch_proc.cpp",
    ],
    cmd = "$(execpath :dawn_json_generator) " +
          "--dawn-json $(execpath src/dawn/dawn.json) " +
          "--wire-json $(execpath src/dawn/dawn_wire.json) " +
          "--kotlin-json $(execpath src/dawn/dawn_kotlin.json) " +
          "--template-dir $$(dirname $(execpath generator/templates/BSD_LICENSE)) " +
          "--targets proc " +
          "--output-dir $(RULEDIR)",
    tools = [":dawn_json_generator"],
)

# include/dawn/BUILD.gn#headers_gen
genrule(
    name = "generate_public_headers",
    srcs = [
        "src/dawn/dawn.json",
        "src/dawn/dawn_wire.json",
        "src/dawn/dawn_kotlin.json",
        "generator/templates/BSD_LICENSE",
        "generator/templates/dawn_proc_table.h",
        "generator/templates/dawn/wire/client/api.h",
        "generator/templates/api.h",
    ],
    outs = [
        "include/dawn/dawn_proc_table.h",
        "include/dawn/webgpu.h",
        "include/dawn/wire/client/webgpu.h",
    ],
    cmd = "$(execpath :dawn_json_generator) " +
          "--dawn-json $(execpath src/dawn/dawn.json) " +
          "--wire-json $(execpath src/dawn/dawn_wire.json) " +
          "--kotlin-json $(execpath src/dawn/dawn_kotlin.json) " +
          "--template-dir $$(dirname $(execpath generator/templates/BSD_LICENSE)) " +
          "--targets headers " +
          "--output-dir $(RULEDIR)",
    tools = [":dawn_json_generator"],
)

py_binary(
    name = "dawn_gpu_info_generator",
    srcs = [
        "generator/dawn_gpu_info_generator.py",
        "generator/generator_lib.py",
    ],
    deps = [
        requirement("jinja2"),
        # jinja2 has a dep on MarkupSafe. Declaring MarkupSafe here is not necessary, but it makes
        # the link easier to find than searching the Bazel cache for generated deps.
        requirement("MarkupSafe"),
    ],
)

# src/dawn/common/BUILD.gn#dawn_gpu_info_gen
genrule(
    name = "generate_gpu_info",
    srcs = [
        "src/dawn/gpu_info.json",
        "generator/templates/dawn/common/GPUInfo.cpp",
        "generator/templates/dawn/common/GPUInfo.h",
    ],
    outs = [
        "src/dawn/common/GPUInfo_autogen.h",
        "src/dawn/common/GPUInfo_autogen.cpp",
    ],
    cmd = "$(execpath :dawn_gpu_info_generator) " +
          # The dawn_gpu_info_generator script is looking for templates relative to @dawn//src/
          "--template-dir $$(dirname $$(dirname $$(dirname $(execpath generator/templates/dawn/common/GPUInfo.cpp)))) " +
          "--gpu-info-json $(execpath src/dawn/gpu_info.json) " +
          "--output-dir $(RULEDIR)",
    tools = [":dawn_gpu_info_generator"],
)
