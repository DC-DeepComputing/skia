def _pa_buildflag_header_impl(ctx):
    out = ctx.actions.declare_file(ctx.attr.out)

    flags = {}
    flags.update(ctx.attr.common_flags)
    flags.update(ctx.attr.os_flags)
    flags.update(ctx.attr.cpu_flags)

    content = []
    content.append("// Generated by pa_buildflag_header rule")
    content.append("#ifndef PARTITION_ALLOC_BUILDFLAGS_H_")
    content.append("#define PARTITION_ALLOC_BUILDFLAGS_H_")
    content.append("")
    content.append('#include "partition_alloc/buildflag.h"')
    content.append("")

    for k, v in flags.items():
        val = v
        if val == "true":
            val = "1"
        elif val == "false":
            val = "0"
        content.append("#define PA_BUILDFLAG_INTERNAL_%s() (%s)" % (k, val))

    content.append("")
    content.append("#endif  // PARTITION_ALLOC_BUILDFLAGS_H_")

    ctx.actions.write(
        output = out,
        content = "\n".join(content) + "\n",
    )
    return [DefaultInfo(files = depset([out]))]

pa_buildflag_header = rule(
    implementation = _pa_buildflag_header_impl,
    attrs = {
        "out": attr.string(mandatory = True),
        "common_flags": attr.string_dict(mandatory = True),
        "os_flags": attr.string_dict(mandatory = True),
        "cpu_flags": attr.string_dict(mandatory = True),
    },
)
