# @platforms is found at https://github.com/bazelbuild/platforms

config_setting(
    name = "linux_x64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

config_setting(
    name = "windows_x64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
)

config_setting(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:linux",
    ],
)

config_setting(
    name = "fuchsia_arm64",
    values = {
        "cpu": "arm64",
        "platforms": "fuchsia",  # TODO(kjlubick) is this right?
    },
)

config_setting(
    name = "cpu_wasm",
    values = {
        "cpu": "wasm",
    },
)
