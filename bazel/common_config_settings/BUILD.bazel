# @platforms is found at https://github.com/bazelbuild/platforms
package(default_visibility = ["//:__subpackages__"])

config_setting(
    name = "linux_x64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

config_setting(
    name = "windows_x64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
)

config_setting(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:linux",
    ],
)

constraint_value(
    name = "fuchsia",
    constraint_setting = "@platforms//os:os",
)

config_setting(
    name = "fuchsia_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        ":fuchsia",
    ],
)

# We define this here because the emscripten toolchain calls the cpu wasm, whereas the
# bazelbuild/platforms call it wasm32. https://github.com/emscripten-core/emsdk/issues/919
config_setting(
    name = "cpu_wasm",
    values = {
        "cpu": "wasm",
    },
)

# https://docs.bazel.build/versions/main/be/platform.html#constraint_setting
constraint_setting(
    name = "fontmanager",
    default_constraint_value = ":empty_fontmgr",
)

constraint_value(
    name = "empty_fontmgr",
    constraint_setting = ":fontmanager",
)

constraint_value(
    name = "custom_directory_fontmgr",
    constraint_setting = ":fontmanager",
)

constraint_value(
    name = "win_fontmgr",
    constraint_setting = ":fontmanager",
    exec_compatible_with = ["@platforms//os:windows"],
)

constraint_value(
    name = "win_factory_fontmgr",
    constraint_setting = ":fontmanager",
    exec_compatible_with = ["@platforms//os:windows"],
)

constraint_setting(
    name = "skdebug_impl",
    default_constraint_value = ":stdio_skdebug",
)

constraint_value(
    name = "stdio_skdebug",
    constraint_setting = ":skdebug_impl",
)

constraint_value(
    name = "win_skdebug",
    constraint_setting = ":skdebug_impl",
    exec_compatible_with = ["@platforms//os:windows"],
)

constraint_value(
    name = "android_skdebug",
    constraint_setting = ":skdebug_impl",
    exec_compatible_with = ["@platforms//os:android"],
)
