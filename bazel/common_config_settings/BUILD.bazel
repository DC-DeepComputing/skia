# @platforms is found at https://github.com/bazelbuild/platforms
package(default_visibility = ["//:__subpackages__"])

# https://github.com/bazelbuild/bazel-skylib/blob/main/rules/common_settings.bzl
load("@bazel_skylib//rules:common_settings.bzl", "string_flag")

config_setting(
    name = "linux_x64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

config_setting(
    name = "windows_x64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
)

config_setting(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:linux",
    ],
)

config_setting(
    name = "debug_build",
    values = {"compilation_mode": "dbg"},
)

config_setting(
    name = "release_build",
    values = {"compilation_mode": "opt"},
)

constraint_value(
    name = "fuchsia",
    constraint_setting = "@platforms//os:os",
)

config_setting(
    name = "fuchsia_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        ":fuchsia",
    ],
)

# We define this here because the emscripten toolchain calls the cpu wasm, whereas the
# bazelbuild/platforms call it wasm32. https://github.com/emscripten-core/emsdk/issues/919
config_setting(
    name = "cpu_wasm",
    values = {
        "cpu": "wasm",
    },
)

# =============================================================================
#                     Configurable Skia Features
# =============================================================================

# We have to specify defaults https://docs.bazel.build/versions/main/skylark/config.html#instantiating-build-settings

string_flag(
    name = "gpu_backend",
    build_setting_default = "",
)

config_setting(
    name = "gl_backend",
    flag_values = {
        ":gpu_backend": "gl",
    },
)

config_setting(
    name = "vulkan_backend",
    flag_values = {
        ":gpu_backend": "vulkan",
    },
)

string_flag(
    name = "with_gl_standard",
    build_setting_default = "",
)

config_setting(
    name = "gles_standard",
    flag_values = {
        ":with_gl_standard": "gles",
    },
)

config_setting(
    name = "gl_standard",
    flag_values = {
        ":with_gl_standard": "gl",
    },
)

config_setting(
    name = "webgl_standard",
    flag_values = {
        ":with_gl_standard": "webgl",
    },
)

string_flag(
    name = "fontmgr",
    build_setting_default = "empty",
)

config_setting(
    name = "empty_fontmgr",
    flag_values = {
        ":fontmgr": "empty",
    },
)

config_setting(
    name = "custom_directory_fontmgr",
    flag_values = {
        ":fontmgr": "custom_directory",
    },
)
