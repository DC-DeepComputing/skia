platform(
    name = "linux_x64_hermetic",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        # This setting allows us to force Bazel to resolve our hermetic toolchain to build
        # the target and not a default one (e.g. on the Linux RBE instance).
        ":use_hermetic_toolchain",
    ],
)

constraint_setting(name = "skia_hermetic_toolchain")

constraint_value(
    name = "use_hermetic_toolchain",
    constraint_setting = ":skia_hermetic_toolchain",
    visibility = ["//visibility:public"],
)
