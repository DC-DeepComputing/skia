        "id": 5065
      },
      "writtenOn": "2021-11-19T22:02:04Z",
      "side": 1,
      "message": "Those are limited to SkSL classes only. Also, there are probably caps we\u0027ll need beyond what is in SkSL::ShaderCaps.",
      "parentUuid": "d7f25613_fd12b092",
      "range": {
        "startLine": 18,
        "startChar": 6,
        "endLine": 18,
        "endChar": 16
      },
      "revId": "93fe102713630e8d9e2183e9cbe01e6655df538e",
