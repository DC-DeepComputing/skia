    1. store_src_rg                   coords = src.rg
    2. init_lane_masks                CondMask = LoopMask = RetMask = true
    3. zero_2_slots_unmasked          r(0..1) = 0
    4. zero_slot_unmasked             r = 0
    5. copy_constant                  g = 0x3F800000 (1.0)
    6. copy_2_slots_unmasked          $0..1 = r(0..1)
    7. zero_slot_unmasked             [main].result(2) = 0
    8. copy_constant                  [main].result(3) = 0x3F800000 (1.0)
    9. copy_2_slots_unmasked          [main].result(0..1) = r(0..1)
   10. load_src                       src.rgba = [main].result
