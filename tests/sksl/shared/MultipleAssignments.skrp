    1. store_src_rg                   coords = src.rg
    2. init_lane_masks                CondMask = LoopMask = RetMask = true
    3. zero_2_slots_unmasked          x(0..1) = 0
    4. copy_constant                  y = 0x3F800000 (1.0)
    5. copy_constant                  x = 0x3F800000 (1.0)
    6. zero_3_slots_unmasked          a(0..2) = 0
    7. zero_slot_unmasked             c = 0
    8. zero_slot_unmasked             b = 0
    9. zero_slot_unmasked             a = 0
   10. copy_2_slots_unmasked          $0..1 = a(0..1)
   11. mul_float                      $0 *= $1
   12. copy_slot_unmasked             $1 = x
   13. copy_slot_unmasked             $2 = c
   14. copy_slot_unmasked             $3 = y
   15. copy_4_slots_unmasked          [main].result = $0..3
   16. load_src                       src.rgba = [main].result
