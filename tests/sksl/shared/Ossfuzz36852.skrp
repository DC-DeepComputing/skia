    1. store_src_rg                   coords = src.rg
    2. init_lane_masks                CondMask = LoopMask = RetMask = true
    3. zero_slot_unmasked             $0 = 0
    4. copy_constant                  $1 = 0x3F800000 (1.0)
    5. copy_constant                  $2 = 0x40000000 (2.0)
    6. copy_constant                  x(3) = 0x40400000 (3.0)
    7. copy_3_slots_unmasked          x(0..2) = $0..2
    8. copy_slot_unmasked             $0 = x(0)
    9. copy_slot_unmasked             y(1) = x(1)
   10. copy_slot_unmasked             y(0) = $0
   11. copy_2_slots_unmasked          $0..1 = y
   12. zero_slot_unmasked             $2 = 0
   13. copy_constant                  $3 = 0x3F800000 (1.0)
   14. copy_4_slots_masked            [main].result = Mask($0..3)
   15. load_src                       src.rgba = [main].result
