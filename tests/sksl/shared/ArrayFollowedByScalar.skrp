    1. store_src_rg                   coords = src.rg
    2. init_lane_masks                CondMask = LoopMask = RetMask = true
    3. zero_4_slots_unmasked          rgb[0](0..3) = 0
    4. zero_slot_unmasked             rgb[0] = 0
    5. copy_constant                  rgb[1] = 0x3F800000 (1.0)
    6. zero_slot_unmasked             rgb[2] = 0
    7. copy_constant                  a = 0x3F800000 (1.0)
    8. copy_4_slots_unmasked          $0..3 = rgb[0](0..3)
    9. copy_4_slots_unmasked          [main].result = $0..3
   10. load_src                       src.rgba = [main].result
