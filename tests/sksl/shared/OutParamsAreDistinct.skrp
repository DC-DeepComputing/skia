    1. store_src_rg                   coords = src.rg
    2. init_lane_masks                CondMask = LoopMask = RetMask = true
    3. copy_constant                  x = 0
    4. copy_constant                  $0 = 0x3F800000 (1.0)
    5. copy_slot_unmasked             x₁ = $0
    6. copy_constant                  $0 = 0x40000000 (2.0)
    7. copy_slot_unmasked             y = $0
    8. copy_slot_unmasked             $0 = x₁
    9. cmpeq_imm_float
   10. copy_slot_unmasked             $1 = y
   11. cmpeq_imm_float
   12. bitwise_and_int                $0 &= $1
   13. copy_slot_unmasked             $1 = x₁
   14. copy_slot_unmasked             x = $1
   15. copy_slot_unmasked             $1 = y
   16. copy_slot_unmasked             x = $1
   17. label                          label 0x00000001
   18. swizzle_4                      $0..3 = ($0..3).xxxx
   19. copy_4_uniforms                $4..7 = colorRed
   20. copy_4_uniforms                $8..11 = colorGreen
   21. mix_4_ints                     $0..3 = mix($4..7, $8..11, $0..3)
   22. load_src                       src.rgba = $0..3
