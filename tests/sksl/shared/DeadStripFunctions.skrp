    1. store_src_rg                   coords = src.rg
    2. init_lane_masks                CondMask = LoopMask = RetMask = true
    3. splat_4_constants              a = 0
    4. splat_4_constants              b = 0
    5. splat_4_constants              a₁ = 0x40400000 (3.0)
    6. splat_4_constants              b₁ = 0xC0A00000 (-5.0)
    7. copy_4_slots_unmasked          $0..3 = a₁
    8. copy_4_slots_unmasked          $4..7 = b₁
    9. add_4_floats                   $0..3 += $4..7
   10. label                          label 0
   11. copy_4_slots_unmasked          a = $0..3
   12. splat_4_constants              color = 0x3F800000 (1.0)
   13. copy_4_slots_unmasked          $0..3 = color
   14. max_imm_float
   15. swizzle_3                      $3..5 = ($3..5).xxx
   16. div_3_floats                   $0..2 /= $3..5
   17. copy_slot_unmasked             $3 = color(3)
   18. label                          label 0x00000001
   19. copy_4_slots_unmasked          b = $0..3
   20. copy_4_slots_unmasked          $0..3 = a
   21. splat_4_constants              $4..7 = 0
   22. cmpne_4_floats                 $0..3 = notEqual($0..3, $4..7)
   23. bitwise_or_2_ints              $0..1 |= $2..3
   24. bitwise_or_int                 $0 |= $1
   25. copy_4_slots_unmasked          $1..4 = b
   26. splat_4_constants              $5..8 = 0
   27. cmpne_4_floats                 $1..4 = notEqual($1..4, $5..8)
   28. bitwise_or_2_ints              $1..2 |= $3..4
   29. bitwise_or_int                 $1 |= $2
   30. bitwise_and_int                $0 &= $1
   31. swizzle_4                      $0..3 = ($0..3).xxxx
   32. copy_4_uniforms                $4..7 = colorRed
   33. copy_4_uniforms                $8..11 = colorGreen
   34. mix_4_ints                     $0..3 = mix($4..7, $8..11, $0..3)
   35. load_src                       src.rgba = $0..3
