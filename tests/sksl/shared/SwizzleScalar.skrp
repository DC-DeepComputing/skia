    1. store_src_rg                   coords = src.rg
    2. init_lane_masks                CondMask = LoopMask = RetMask = true
    3. copy_constant                  $0 = unknownInput
    4. swizzle_4                      $0..3 = ($0..3).xxxx
    5. copy_4_slots_unmasked          h4 = $0..3
    6. copy_constant                  $0 = unknownInput
    7. copy_slot_unmasked             $1 = $0
    8. zero_slot_unmasked             $2 = 0
    9. copy_constant                  h4(0) = 0x3F800000 (1.0)
   10. copy_constant                  h4(1) = 0x3F800000 (1.0)
   11. copy_constant                  h4(2) = 0x3F800000 (1.0)
   12. copy_constant                  h4(3) = 0x3F800000 (1.0)
   13. zero_slot_unmasked             $0 = 0
   14. copy_constant                  $1 = unknownInput
   15. copy_constant                  $2 = 0x3F800000 (1.0)
   16. zero_slot_unmasked             h4(0) = 0
   17. zero_slot_unmasked             h4(1) = 0
   18. zero_slot_unmasked             h4(2) = 0
   19. zero_slot_unmasked             h4(3) = 0
   20. zero_slot_unmasked             $0 = 0
   21. copy_constant                  $1 = unknownInput
   22. zero_slot_unmasked             $2 = 0
   23. copy_constant                  $3 = unknownInput
   24. copy_4_slots_unmasked          h4 = $0..3
   25. copy_4_slots_unmasked          [main].result = $0..3
   26. load_src                       src.rgba = [main].result
