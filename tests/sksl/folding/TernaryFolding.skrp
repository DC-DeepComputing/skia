    1. store_src_rg                   coords = src.rg
    2. init_lane_masks                CondMask = LoopMask = RetMask = true
    3. zero_slot_unmasked             ok = 0
    4. copy_constant                  ok = 0xFFFFFFFF
    5. copy_4_constants               $0..3 = colorGreen
    6. copy_4_slots_unmasked          green = $0..3
    7. copy_4_constants               $0..3 = colorRed
    8. copy_4_slots_unmasked          red = $0..3
    9. zero_slot_unmasked             param = 0
   10. copy_constant                  x = 0xFFFFFFFF
   11. zero_slot_unmasked             [do_side_effect].result = 0
   12. copy_slot_unmasked             $0 = x
   13. copy_slot_unmasked             param = $0
   14. copy_slot_unmasked             $0 = [do_side_effect].result
   15. copy_constant                  call = 0xFFFFFFFF
   16. store_condition_mask           $8 = CondMask
   17. copy_slot_unmasked             $9 = ok
   18. copy_slot_unmasked             $10 = param
   19. bitwise_and_int                $9 &= $10
   20. copy_slot_unmasked             $10 = call
   21. bitwise_and_int                $9 &= $10
   22. copy_4_slots_unmasked          $0..3 = red
   23. merge_condition_mask           CondMask = $8 & $9
   24. copy_4_slots_unmasked          $4..7 = green
   25. copy_4_slots_masked            $0..3 = Mask($4..7)
   26. load_condition_mask            CondMask = $8
   27. copy_4_slots_unmasked          [main].result = $0..3
   28. load_src                       src.rgba = [main].result
