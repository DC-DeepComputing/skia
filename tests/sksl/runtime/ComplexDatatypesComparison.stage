}
bool test_array_of_structs_0(bool eq, bool diff, float f1, float f2, float f3, float f4, float f5, float f6)
{
	float one = float(colorGreen.x + 1.0);
	S_0 a[2];
	a[0].f1 = f1;
	a[0].f2 = f2;
