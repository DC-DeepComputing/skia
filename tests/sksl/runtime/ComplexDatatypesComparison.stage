SA_0 getSA_0(SA_0 sa0, float one)
{
	SA_0 sa = sa0;
	sa.a1[0] = sa0.a1[0] * one;
	sa.a1[1] = sa0.a1[1] * one;
	sa.a2[0] = sa0.a2[0] * one;
	sa.a2[1] = sa0.a2[1] * one;
	return sa;
}
bool test_struct_0(bool eq, bool diff, float f1, float f2, float f3)
{
	float one = float(diff ? 2.0 : colorGreen.x + 1.0);
	S_0 a;
	a.f1 = f1;
	a.f2 = f2;
	a.f3 = f3;
	S_0 b = getS_0(a, one);
	return eq ? a == b : a != b;
}
bool test_array_0(bool eq, bool diff, float f1, float f2, float f3)
{
