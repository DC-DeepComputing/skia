uniform shader X;uniform shader Y;uniform half4 colorGreen;noinline half4 a(shader h,shader i,shader j,shader k,shader l,shader m,shader n){return colorGreen;}noinline half4 a(shader g,shader h,shader i,shader j,shader k,shader l){return a(g,h,i,j,k,l,X)*a(g,h,i,j,k,l,Y);}noinline half4 a(shader f,shader g,shader h,shader i,shader j){return a(f,g,h,i,j,X)*a(f,g,h,i,j,Y);}noinline half4 a(shader e,shader f,shader g,shader h){return a(e,f,g,h,X)*a(e,f,g,h,Y);}noinline half4 a(shader d,shader e,shader f){return a(d,e,f,X)*a(d,e,f,Y);}noinline half4 a(shader c,shader d){return a(c,d,X)*a(c,d,Y);}noinline half4 a(shader b){return a(b,X)*a(b,Y);}half4 main(float2 b){return a(X)*a(Y);}
