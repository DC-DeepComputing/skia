uniform half4 colorRed;
uniform half4 colorGreen;
int return_loop_0()
{
	for (int i = 0;i < 10; ++i) 
	{
		if (i == 5) 
		{
			return i;
		}
	}
	return 0;
}
int continue_loop_0()
{
	int sum = 0;
	for (int i = 0;i < 10; ++i) 
	{
		if (i < 5) 
		{
			continue;
		}
		sum += i;
	}
	return sum;
}
int break_loop_0()
{
	int sum = 0;
	for (int i = 0;i < 10; ++i) 
	{
		if (i > 5) 
		{
			break;
		}
		sum += i;
	}
	return sum;
}
half4 main(float2 xy)
{
	if ((return_loop_0() != 5 || continue_loop_0() != 35) || break_loop_0() != 15) 
	{
		return half4(colorRed);
	}
	return half4(colorGreen);
}
