int continue_loop_0()
{
	int sum = 0;
	for (int i = 0;i < 10; ++i) 
	{
		if (i < 5) 
		{
			continue;
		}
		sum += i;
	}
	return sum;
}
int break_loop_0()
{
	int sum = 0;
	for (int i = 0;i < 10; ++i) 
	{
		if (i > 5) 
		{
			break;
		}
		sum += i;
	}
	return sum;
}
bool loop_operator_le_0()
{
	int4 result = int4(-999);
