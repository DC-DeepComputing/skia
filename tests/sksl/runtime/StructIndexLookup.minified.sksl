uniform half4 colorGreen;uniform half4 colorRed;struct InnerLUT{float3 values;};struct OuterLUT{InnerLUT[3]inner;};struct Root{OuterLUT[3]outer;};half4 main(float2 a){Root b;b.outer[0].inner[0].values=float3(1.,10.,100.);b.outer[0].inner[1].values=float3(2.,20.,200.);b.outer[0].inner[2].values=float3(3.,30.,300.);b.outer[1].inner[0].values=float3(4.,40.,400.);b.outer[1].inner[1].values=float3(5.,50.,500.);b.outer[1].inner[2].values=float3(6.,60.,600.);b.outer[2].inner[0].values=float3(7.,70.,700.);b.outer[2].inner[1].values=float3(8.,80.,800.);b.outer[2].inner[2].values=float3(9.,90.,900.);float3 c=float3(0.);for(int d=0;d<3;++d){for(int e=0;e<3;++e){c+=float3(1.,10.,100.);if(b.outer[d].inner[e].values!=c){return colorRed;}for(int f=0;f<3;++f){if(b.outer[d].inner[e].values[f]!=c[f]){return colorRed;}}}}return colorGreen;}
