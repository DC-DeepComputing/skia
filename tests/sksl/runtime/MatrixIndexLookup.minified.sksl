uniform half4 colorGreen;uniform half4 colorRed;uniform float3x3 testMatrix3x3;uniform float4x4 testMatrix4x4;bool a(){float3x3 b=testMatrix3x3;float3 c=float3(1.,2.,3.);for(int d=0;d<3;++d){if(b[d]!=c){return false;}c+=3.;}return true;}bool b(){float4x4 c=testMatrix4x4;float4 d=float4(1.,2.,3.,4.);for(int e=0;e<4;++e){if(c[e]!=d){return false;}d+=4.;}return true;}half4 main(float2 c){return a()&&b()?colorGreen:colorRed;}
