  385. copy_slot_masked               b[2]₁ = Mask($1)
  386. copy_slot_unmasked             $1 = eq₁
  387. copy_4_slots_unmasked          $2..5 = a[0]₁, a[1]₁, a[2]₁, b[0]₁
  388. copy_2_slots_unmasked          $6..7 = b[1]₁, b[2]₁
  389. cmpne_3_floats                 $2..4 = notEqual($2..4, $5..7)
  390. bitwise_or_int                 $3 |= $4
  391. bitwise_or_int                 $2 |= $3
  392. copy_4_slots_unmasked          $3..6 = a[0]₁, a[1]₁, a[2]₁, b[0]₁
  393. copy_2_slots_unmasked          $7..8 = b[1]₁, b[2]₁
  394. cmpeq_3_floats                 $3..5 = equal($3..5, $6..8)
  395. bitwise_and_int                $4 &= $5
  396. bitwise_and_int                $3 &= $4
  397. mix_int                        $1 = mix($2, $3, $1)
  398. copy_slot_masked               [test_diff_arrays].result = Mask($1)
  399. label                          label 0x0000000D
  400. bitwise_not_int                $1 = ~$1
  401. copy_slot_masked               $0 = Mask($1)
  402. label                          label 0x0000000C
  403. load_condition_mask            CondMask = $21
