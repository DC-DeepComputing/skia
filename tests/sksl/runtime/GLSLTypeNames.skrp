    1. store_src_rg                   coords = src.rg
    2. init_lane_masks                CondMask = LoopMask = RetMask = true
    3. zero_slot_unmasked             f = 0
    4. copy_slot_unmasked             $0 = f
    5. copy_slot_unmasked             $1 = $0
    6. copy_slot_unmasked             fv(2) = f
    7. copy_slot_unmasked             fv(3) = f
    8. copy_2_slots_unmasked          fv(0..1) = $0..1
    9. copy_4_slots_unmasked          [main].result = fv
   10. load_src                       src.rgba = [main].result
