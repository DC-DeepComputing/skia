const half r_0 = 0.;
noinline half opt_barrier_0(const half x);
half2 compute_ba_0(const half2 rg);
noinline half opt_barrier_0(const half x)
{
	return x;
}
half2 compute_ba_0(const half2 rg)
{
	return rg;
}
half4 main(float2 xy)
{
	const half g = 1.;
	return half4(half4(opt_barrier_0(r_0), 1., compute_ba_0(half2(0., opt_barrier_0(g)))));
}
