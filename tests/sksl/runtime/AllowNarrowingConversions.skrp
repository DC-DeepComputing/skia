    1. store_src_rg                   coords = src.rg
    2. init_lane_masks                CondMask = LoopMask = RetMask = true
    3. copy_constant                  one(0) = 0x3F800000 (1.0)
    4. copy_constant                  one(1) = 0x3F800000 (1.0)
    5. copy_constant                  one(2) = 0x3F800000 (1.0)
    6. copy_constant                  one(3) = 0x3F800000 (1.0)
    7. zero_slot_unmasked             zero(0) = 0
    8. zero_slot_unmasked             zero(1) = 0
    9. zero_slot_unmasked             zero(2) = 0
   10. zero_slot_unmasked             zero(3) = 0
   11. copy_4_uniforms                green = colorGreen
   12. copy_4_slots_unmasked          $0..3 = green
   13. copy_4_slots_unmasked          $4..7 = one
   14. mul_4_floats                   $0..3 *= $4..7
   15. copy_4_slots_unmasked          $4..7 = zero
   16. add_4_floats                   $0..3 += $4..7
   17. load_src                       src.rgba = $0..3
