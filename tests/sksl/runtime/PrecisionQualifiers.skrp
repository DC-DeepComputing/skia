  385. trace_exit                     TraceExit(bool lowp_param(half value)) when $13 is true
  386. copy_slot_unmasked             $2 = [lowp_param].result
  387. label                          label 0x0000000D
  388. copy_slot_masked               $1 = Mask($2)
  389. label                          label 0x00000001
  390. load_condition_mask            CondMask = $17
  391. swizzle_4                      $1..4 = ($1..4).xxxx
  392. copy_4_slots_unmasked          $5..8 = red
  393. copy_4_slots_unmasked          $9..12 = green
  394. mix_4_ints                     $1..4 = mix($5..8, $9..12, $1..4)
  395. copy_4_slots_unmasked          [main].result = $1..4
  396. trace_var                      TraceVar([main].result) when $13 is true
  397. trace_scope                    TraceScope(-1) when $0 is true
  398. trace_exit                     TraceExit(vec4 main(vec2 coords)) when $13 is true
  399. load_src                       src.rgba = [main].result
