      "writtenOn": "2023-08-16T14:37:31Z",
      "side": 1,
      "message": "I\u0027m fine with friending DawnCommandBuffer. Alternatively, would it be appropriate to explicitly mark DawnTexture / VulkanTexture as not thread safe? Or if we do need them to be thread safe, just using locks in getTextureView?",
      "parentUuid": "a0831254_b47fdd60",
      "range": {
        "startLine": 64,
        "startChar": 0,
        "endLine": 64,
        "endChar": 65
      },
      "revId": "56a7760838f2d89594cb2450e24058d9d48b5d77",
