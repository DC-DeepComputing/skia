        "id": 3568682
      },
      "writtenOn": "2024-09-25T13:06:06Z",
      "side": 1,
      "message": "I agree, let me know if there is a better way for this. This is similar functionality to how ICC is implemented: https://source.chromium.org/chromium/chromium/src/+/main:third_party/skia/src/encode/SkJpegEncoderImpl.cpp;drc\u003d481596642e0d9903c24a729811bc708e29d7539c;l\u003d437",
      "parentUuid": "713218d4_bc0ab243",
      "revId": "da24ad6235479471c85e447124a1cb684d7c635c",
      "serverId": "5086850b-e599-37d2-8ec8-ff16aeccbf02"
    },
    {
      "unresolved": false,
      "key": {
        "uuid": "e2069ceb_9499f35e",
        "filename": "src/encode/SkJpegEncoderImpl.cpp",
        "patchSetId": 16
      },
      "lineNbr": 475,
      "author": {
        "id": 5255
