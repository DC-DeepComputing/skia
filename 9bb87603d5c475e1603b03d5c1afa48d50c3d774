      "writtenOn": "2026-02-25T15:48:27Z",
      "side": 1,
      "message": "If the for loop has a `continue` statement, appending extra next expressions at the end of the loop body gets tricky. Does WGSL support labels and gotos? We could use that to patch the continue to jump to the extra next section.",
      "range": {
        "startLine": 24,
        "startChar": 8,
        "endLine": 24,
        "endChar": 23
      },
      "revId": "9bb87603d5c475e1603b03d5c1afa48d50c3d774",
      "serverId": "5086850b-e599-37d2-8ec8-ff16aeccbf02"
    },
    {
