angle_root = "//third_party/externals/angle2"
angle_zlib_compression_utils_dir = "//third_party/zlib"
angle_spirv_headers_dir = "//third_party/externals/spirv-headers"
angle_spirv_tools_dir = "//third_party/externals/spirv-tools"

# We don't have Chromium's build/ or testing/ directories.
angle_has_build = false

# Bunch of features ANGLE's build files test for that we never set.
is_cfi = false
is_chromeos = false

angle_enable_vulkan = true
angle_vulkan_memory_allocator_dir = "//third_party/vulkanmemoryallocator"

# Generic Buffer Management
angle_use_gbm = false
angle_vulkan_headers_dir = "//third_party/externals/vulkan-headers/src"
angle_vulkan_loader_dir =
    "//third_party/externals/vulkan-deps/vulkan-loader/src"
angle_vulkan_tools_dir = "//third_party/externals/vulkan-tools"
angle_vulkan_validation_layers_dir =
    "//third_party/externals/vulkan-deps/vulkan-validation-layers/src"
