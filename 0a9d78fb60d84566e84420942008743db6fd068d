      "writtenOn": "2026-09-22T16:57:56Z",
      "side": 1,
      "message": "I want to test the new flipping code. Is it possible to define SK_GRAPHITE_READ_PIXELS_SUPPORTS_BOTTOM_LEFT in tests for now while we migrate chrome to define it?",
      "parentUuid": "8964b32c_e20385d4",
      "range": {
        "startLine": 19,
        "startChar": 0,
        "endLine": 21,
        "endChar": 6
      },
      "revId": "0a9d78fb60d84566e84420942008743db6fd068d",
