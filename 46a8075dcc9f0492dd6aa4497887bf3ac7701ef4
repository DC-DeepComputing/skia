      "writtenOn": "2023-05-11T15:23:25Z",
      "side": 1,
      "message": "Fwiw, from https://chat.google.com/room/AAAABiWIgTc/VDmC4bxEEiY, it sounds like we do *not* want to run the destructor.",
      "parentUuid": "0489aa03_a68933a7",
