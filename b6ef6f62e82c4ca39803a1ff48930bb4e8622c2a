        "id": 8341
      },
      "writtenOn": "2024-04-20T01:56:51Z",
      "side": 1,
      "message": "Done; it turns out I was able to push the check all the way down to `prepareBindBuffer` and cover everything gracefully.",
      "parentUuid": "9298ce78_0afa6da1",
      "revId": "b6ef6f62e82c4ca39803a1ff48930bb4e8622c2a",
      "serverId": "5086850b-e599-37d2-8ec8-ff16aeccbf02"
