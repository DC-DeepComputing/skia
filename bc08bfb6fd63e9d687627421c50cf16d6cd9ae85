      "side": 1,
      "message": "These should be marked with `// valid` or `// invalid`.\nThis implementation has them defined as valid, but GLSL docs seem to state they are not?\n\n`Atomic counters are Opaque Types; as such, they can only be declared as uniforms or as a in function parameter.`\n\nAgain from https://www.khronos.org/opengl/wiki/Atomic_Counter",
      "range": {
        "startLine": 8,
        "startChar": 0,
        "endLine": 13,
        "endChar": 35
      },
      "revId": "bc08bfb6fd63e9d687627421c50cf16d6cd9ae85",
