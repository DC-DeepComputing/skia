      "writtenOn": "2026-09-01T14:40:43Z",
      "side": 1,
      "message": "Historically I suppose we would return false in the case that there was nothing to flush, since nothing would set flushSuccessful \u003d true in the loop.  But we can distinguish that scenario now if we return the ExecutionResult because it\u0027d say false for any tasks submitted, but true for all being successful.",
      "range": {
        "startLine": 179,
        "startChar": 50,
        "endLine": 179,
        "endChar": 55
      },
      "revId": "eded207465d6fb93abe6400d4a898d06514b5988",
