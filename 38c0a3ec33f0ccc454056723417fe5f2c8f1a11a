      "writtenOn": "2023-10-19T11:42:39Z",
      "side": 1,
      "message": "Is jobs relevant since we aren\u0027t using RBE? Or do we use RBE for compilation still?",
      "range": {
        "startLine": 149,
        "startChar": 5,
        "endLine": 149,
        "endChar": 9
