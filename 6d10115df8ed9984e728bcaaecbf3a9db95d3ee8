      "writtenOn": "2022-02-15T15:24:16Z",
      "side": 1,
      "message": "I\u0027d suggest either dropping this change - or, if we want to ensure we respect dither even on image draws that would otherwise be treated as sprites - just add a check to SkTreatAsSprite so we send those down the RP/VM case.",
      "parentUuid": "2982017a_b5bf8f2d",
      "range": {
        "startLine": 200,
        "startChar": 8,
        "endLine": 200,
        "endChar": 83
      },
