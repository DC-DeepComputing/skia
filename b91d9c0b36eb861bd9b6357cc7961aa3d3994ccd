      "writtenOn": "2023-02-13T15:56:18Z",
      "side": 1,
      "message": "Should the ellipsis run always be created with the same direction as the paragraph?",
      "revId": "b91d9c0b36eb861bd9b6357cc7961aa3d3994ccd",
      "serverId": "5086850b-e599-37d2-8ec8-ff16aeccbf02"
    },
    {
