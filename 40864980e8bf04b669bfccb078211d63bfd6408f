      "writtenOn": "2026-10-21T18:16:38Z",
      "side": 1,
      "message": "We don\u0027t need to also add this in ContextOptionsPriv; fDrawListLayer existed first in Priv and migrated to the public options and was never cleaned up here.",
      "range": {
        "startLine": 40,
        "startChar": 0,
        "endLine": 40,
        "endChar": 37
      },
      "revId": "40864980e8bf04b669bfccb078211d63bfd6408f",
