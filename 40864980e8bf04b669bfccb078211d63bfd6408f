    },
    {
      "unresolved": true,
      "key": {
        "uuid": "036819cb_b0200127",
        "filename": "src/gpu/graphite/ScratchDeviceAtlas.h",
        "patchSetId": 4
      },
      "lineNbr": 86,
      "author": {
        "id": 8341
      },
      "writtenOn": "2026-10-21T18:16:38Z",
      "side": 1,
      "message": "I don\u0027t think we need these to be stored here and shared by each atlas\u0027ed `Device`. a) this won\u0027t extend to when we remove BoundsManager or IntersectionTreeSet as we move over to the DrawListLayer system. b) the atlas\u0027 Rectanizer should ensure that each child is put in a disjoint region of the texture, so as long as we set the scissor correctly for each child, the this tracking can be managed by each device internally.",
      "range": {
        "startLine": 84,
        "startChar": 0,
        "endLine": 86,
        "endChar": 32
      },
