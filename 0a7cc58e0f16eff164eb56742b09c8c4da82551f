      "writtenOn": "2023-02-11T17:29:12Z",
      "side": 1,
      "message": "Note that this approach doesn\u0027t even require an extra buffer on your part (skcms allows in-place transform, as long as the src and dst bpp are the same).",
      "parentUuid": "60d3f825_ef22a6f9",
      "revId": "0a7cc58e0f16eff164eb56742b09c8c4da82551f",
      "serverId": "5086850b-e599-37d2-8ec8-ff16aeccbf02"
    },
