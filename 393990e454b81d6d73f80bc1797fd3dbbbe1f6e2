        "id": 5140
      },
      "writtenOn": "2023-07-31T18:07:18Z",
      "side": 1,
      "message": "Pretty sure we already put `-fPIC` on the compile like on platforms that need it. Shouldn\u0027t do this here since it isn\u0027t clear which compiler is being used and that work has already been done elsewhere.",
      "range": {
        "startLine": 12,
        "startChar": 13,
        "endLine": 12,
        "endChar": 18
      },
      "revId": "393990e454b81d6d73f80bc1797fd3dbbbe1f6e2",
