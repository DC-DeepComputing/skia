        "id": 5395
      },
      "writtenOn": "2023-08-17T12:01:31Z",
      "side": 1,
      "message": "Wildcards have led to problems before and I envision they will in the future.\nhttps://skia-review.googlesource.com/c/skia/+/702877/10/tests/BUILD.bazel",
      "parentUuid": "044f1021_3176c215",
      "range": {
        "startLine": 2154,
